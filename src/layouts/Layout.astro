---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'ja' | 'en';
  currentPref?: string;
  fullWidth?: boolean;
}

const { title, description, image, lang = 'ja', currentPref, fullWidth = false } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} image={image} lang={lang} />
  </head>
  <body class={fullWidth ? 'layout-full-width' : undefined}>
    <Header lang={lang} currentPref={currentPref} />
    <main class={fullWidth ? 'main-full-width' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>

<style>
  body.layout-full-width {
    background: #ffffff;
  }
  main.main-full-width {
    max-width: none;
    margin: 0;
    padding: 0;
  }
</style>
