---
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Contact Us - tavi-navi"
  description="Get in touch with the editorial team at tavi-navi for inquiries, feedback, and media requests."
  lang="en"
>
  <div class="container" style="max-width: 800px; padding-top: 3rem; padding-bottom: 4rem;">
    <article class="article-content">
      <h1 style="font-size: 1.85rem; font-weight: 900; margin-bottom: 1.5rem; border-bottom: 2px solid var(--color-primary); padding-bottom: 0.5rem;">
        Contact Us
      </h1>

      <p>
        Thank you for visiting tavi-navi. If you have questions, corrections, suggestions, or partnership opportunities, please reach out via email:
      </p>

      <div style="background: var(--color-bg-base); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 1.5rem; margin-top: 1.5rem;">
        <p style="font-weight: 700; margin-bottom: 0.5rem;">Editorial Contact:</p>
        <p style="font-size: 0.95rem; color: var(--color-text-muted);">
          Email: <a href="mailto:contact@tavi-navi.net">contact@tavi-navi.net</a>
        </p>
      </div>
    </article>
  </div>
</Layout>
