---
import Layout from '../../../layouts/Layout.astro';
import { MONTHLY_THEMES, type MonthTheme } from '../../../data/monthlyThemes';
import { PREFECTURES } from '../../../data/prefectures';
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../../../utils/slug';

export function getStaticPaths() {
  return MONTHLY_THEMES.map((theme) => ({
    params: { month: String(theme.month) },
    props: { theme },
  }));
}

interface Props {
  theme: MonthTheme;
}

const { theme } = Astro.props;

// Fetch articles matching this month
const allArticles = await getCollection('articles', ({ data }) => {
  if (data.lang !== 'en' || data.draft) return false;
  const s = (data.season || '').toLowerCase();
  return s.includes(theme.monthNameEn.toLowerCase());
});

// Recommended prefectures for this month
const recommendedPrefs = PREFECTURES.filter((p) => theme.topPrefectures.includes(p.id));
---

<Layout
  title={`【Japan in ${theme.monthNameEn}】Best Places to Visit, Weather & Seasonal Guide - tavi-navi`}
  description={`Complete guide to traveling in Japan during ${theme.monthNameEn}. ${theme.taglineEn}. Early, mid, and late seasonal timelines, packing advice, and top recommended prefectures.`}
  lang="en"
>
  {/* Breadcrumbs */}
  <div style="background: #ffffff; border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
    <div class="container" style="font-size: 0.85rem; color: var(--color-text-muted);">
      <a href="/en/" style="color: var(--color-primary);">Home</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <a href="/en/season/" style="color: var(--color-primary);">Explore by Season</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span style="font-weight: 700; color: var(--color-text-main);">Japan in {theme.monthNameEn}</span>
    </div>
  </div>

  {/* Hero Banner */}
  <div class="hero-banner" style="padding: 2.5rem 0 2rem;">
    <div class="container">
      <span class="badge-seasonal">{theme.icon} Best Season: {theme.monthNameEn}</span>
      <h1 class="hero-title" style="margin-top: 0.75rem;">
        Visiting Japan in {theme.monthNameEn}
      </h1>
      <p class="hero-subtitle">
        {theme.taglineEn}
      </p>

      {/* 12-Month Selector */}
      <div class="month-selector-wrapper">
        <span class="month-selector-title">🗓️ Check Other Months & Plan Ahead:</span>
        <div class="month-pill-grid">
          {MONTHLY_THEMES.map((m) => {
            const isCurrent = m.month === theme.month;
            return (
              <a
                href={`/en/season/${m.month}/`}
                class={`month-pill ${isCurrent ? 'is-active' : ''}`}
              >
                <span class="month-pill-icon">{m.icon}</span>
                <span class="month-pill-name">{m.monthShortEn}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top: 2.5rem; padding-bottom: 4rem;">
    {/* Early, Mid, Late Timeline */}
    <section style="margin-bottom: 3.5rem;">
      <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-accent);">📅</span> {theme.monthNameEn} Seasonal Highlights (Early, Mid, Late)
      </h2>

      <div class="season-timeline-grid">
        {/* Early */}
        <div class="period-card">
          <div class="period-card-header period-early">
            <span class="period-badge">Early {theme.monthShortEn} (1st–10th)</span>
            <span class="period-icon">🌱</span>
          </div>
          <div class="period-card-body">
            <ul class="period-highlight-list">
              {theme.earlyPeriodEn.highlights.map((h) => (
                <li>
                  <span class="period-bullet">✦</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="period-tip-box">
              <span class="tip-label">💡 Travel Tip:</span>
              <p class="tip-text">{theme.earlyPeriodEn.tips}</p>
            </div>
          </div>
        </div>

        {/* Mid */}
        <div class="period-card">
          <div class="period-card-header period-mid">
            <span class="period-badge">Mid-{theme.monthShortEn} (11th–20th)</span>
            <span class="period-icon">🌿</span>
          </div>
          <div class="period-card-body">
            <ul class="period-highlight-list">
              {theme.midPeriodEn.highlights.map((h) => (
                <li>
                  <span class="period-bullet">✦</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="period-tip-box">
              <span class="tip-label">💡 Travel Tip:</span>
              <p class="tip-text">{theme.midPeriodEn.tips}</p>
            </div>
          </div>
        </div>

        {/* Late */}
        <div class="period-card">
          <div class="period-card-header period-late">
            <span class="period-badge">Late {theme.monthShortEn} (21st–End)</span>
            <span class="period-icon">🌟</span>
          </div>
          <div class="period-card-body">
            <ul class="period-highlight-list">
              {theme.latePeriodEn.highlights.map((h) => (
                <li>
                  <span class="period-bullet">✦</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="period-tip-box">
              <span class="tip-label">💡 Travel Tip:</span>
              <p class="tip-text">{theme.latePeriodEn.tips}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* Featured Articles */}
    {allArticles.length > 0 && (
      <section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-primary);">📚</span> Featured Itineraries for {theme.monthNameEn}
        </h2>

        <div class="article-grid">
          {allArticles.map((post) => {
            const prefObj = PREFECTURES.find((p) => p.id === post.data.pref);
            const articleSlug = getArticleSlug(post.id, post.data.pref);
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span style="font-weight: 700; color: var(--color-primary);">
                      {prefObj ? prefObj.nameEn : post.data.pref}
                    </span>
                    <span>•</span>
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <span style="font-weight: 700; color: var(--color-accent);">🏷️ {post.data.season}</span>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/en/${post.data.pref}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/en/${post.data.pref}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      View Itinerary &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {/* Top Recommended Prefectures for this month */}
    <section>
      <div style="margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-primary);">📍</span> Best Prefectures to Visit in {theme.monthNameEn}
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">
          Top destinations reaching seasonal peak blossoms, foliage, culinary seasons, or outdoor weather in {theme.monthNameEn}.
        </p>
      </div>

      <div class="prefecture-grid">
        {recommendedPrefs.map((pref) => (
          <a href={`/en/${pref.id}/${theme.month}/`} class="pref-card">
            <div class="pref-card-header">
              <span class="pref-card-title">{pref.nameEn}</span>
              <span class="pref-card-en">{pref.nameJa}</span>
            </div>
            <div class="pref-card-highlights">
              {pref.highlightsEn.slice(0, 3).map((item) => (
                <span class="pref-card-tag">{item}</span>
              ))}
            </div>
            <div style="margin-top: 0.75rem; font-size: 0.8rem; font-weight: 700; color: var(--color-primary); display: flex; align-items: center; justify-content: space-between; border-top: 1px dashed var(--color-border); padding-top: 0.5rem;">
              <span>View {pref.nameEn} in {theme.monthShortEn}</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .hero-banner {
    background: linear-gradient(135deg, #1b3d2f 0%, #2e5c46 100%);
    color: #ffffff;
    text-align: center;
  }

  .badge-seasonal {
    display: inline-block;
    background: rgba(255, 255, 255, 0.18);
    backdrop-filter: blur(4px);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 0.35rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 700;
    color: #e2f5ea;
  }

  .hero-title {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0.8rem 0 0.5rem;
  }

  .hero-subtitle {
    font-size: 1rem;
    opacity: 0.9;
    max-width: 680px;
    margin: 0 auto;
    line-height: 1.6;
  }

  .month-selector-wrapper {
    margin-top: 1.5rem;
    background: rgba(0, 0, 0, 0.2);
    border-radius: 12px;
    padding: 1rem;
    max-width: 720px;
    margin-left: auto;
    margin-right: auto;
  }

  .month-selector-title {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: 0.6rem;
    color: #a7f3d0;
  }

  .month-pill-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.35rem;
  }

  .month-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: 6px;
    padding: 0.4rem 0.1rem;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .month-pill:hover {
    background: rgba(255, 255, 255, 0.25);
    transform: translateY(-2px);
  }

  .month-pill.is-active {
    background: #ffffff;
    color: var(--color-primary-dark);
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.15);
  }

  .month-pill-icon {
    font-size: 1rem;
    line-height: 1;
    margin-bottom: 0.15rem;
  }

  .season-timeline-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .period-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .period-card-header {
    padding: 0.75rem 1rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    color: #ffffff;
  }

  .period-early {
    background: linear-gradient(135deg, #059669 0%, #10b981 100%);
  }

  .period-mid {
    background: linear-gradient(135deg, #1b3d2f 0%, #2e5c46 100%);
  }

  .period-late {
    background: linear-gradient(135deg, #0f766e 0%, #14b8a6 100%);
  }

  .period-badge {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .period-icon {
    font-size: 1.1rem;
  }

  .period-card-body {
    padding: 1.25rem 1rem;
  }

  .period-highlight-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .period-highlight-list li {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-main);
    display: flex;
    gap: 0.4rem;
    align-items: flex-start;
  }

  .period-bullet {
    color: var(--color-primary);
    font-size: 0.75rem;
    margin-top: 0.15rem;
    flex-shrink: 0;
  }

  .period-tip-box {
    margin-top: 1rem;
    padding: 0.75rem 0.85rem;
    background: #f0fdf4;
    border-left: 3px solid #10b981;
    border-radius: 4px;
  }

  .tip-label {
    font-size: 0.78rem;
    font-weight: 700;
    color: #065f46;
    display: block;
    margin-bottom: 0.2rem;
  }

  .tip-text {
    font-size: 0.82rem;
    color: #1f2937;
    margin: 0;
    line-height: 1.45;
  }

  .article-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .article-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .article-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(27, 61, 47, 0.12);
  }

  .article-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .article-card-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.82rem;
    margin-bottom: 0.75rem;
    flex-wrap: wrap;
  }

  .article-card-title {
    font-size: 1.15rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .article-card-title a {
    color: var(--color-text-main);
    text-decoration: none;
  }

  .article-card-title a:hover {
    color: var(--color-primary);
  }

  .article-card-desc {
    font-size: 0.88rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .prefecture-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .pref-card {
    background: #ffffff;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: all 0.2s ease;
  }

  .pref-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(27, 61, 47, 0.08);
  }

  .pref-card-header {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }

  .pref-card-title {
    font-weight: 800;
    font-size: 1.05rem;
    color: var(--color-text-main);
  }

  .pref-card-en {
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .pref-card-highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
  }

  .pref-card-tag {
    font-size: 0.72rem;
    background: var(--color-bg-base);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .season-timeline-grid {
      grid-template-columns: 1fr;
    }
    .month-pill-grid {
      grid-template-columns: repeat(6, 1fr);
    }
    .hero-title {
      font-size: 1.7rem;
    }
  }

  @media (max-width: 480px) {
    .month-pill-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
