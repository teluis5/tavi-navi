---
import type { ImageMetadata } from 'astro';
import HotelPortalHub from './HotelPortalHub.astro';
import BusinessHours from './BusinessHours.astro';

export interface SpotPhotoItem {
  image: string | ImageMetadata;
  caption?: string;
  imageCredit?: string;
  isSample?: boolean;
}

export interface Props {
  title: string;
  categoryLabel?: string;
  alternativeLabel?: string;
  areaLabel?: string;
  image?: string | ImageMetadata;
  images?: (string | ImageMetadata | SpotPhotoItem)[];
  imageLayout?: 'single' | 'carousel' | 'grid-2' | 'grid-3' | 'pip';
  imageCredit?: string;
  isImageSample?: boolean;
  points?: string[];
  links?: { label: string; href: string }[];
  linksInList?: boolean;
  businessHoursId?: string;
  hotelData?: any;
  spotData?: any;
  amenities?: { label: string }[];
  clickable?: boolean;
}

const {
  title,
  categoryLabel,
  alternativeLabel,
  areaLabel,
  image,
  images,
  imageLayout: propLayout,
  imageCredit,
  isImageSample,
  points,
  links,
  linksInList,
  businessHoursId,
  hotelData,
  spotData,
  amenities,
  clickable = true,
} = Astro.props;

// 画像URL解決
function getImageUrl(img: any): string {
  if (!img) return '';
  if (typeof img === 'string') return img;
  if (typeof img === 'object' && 'src' in img) return img.src;
  return '';
}

// 複数画像の正規化
const photoItems: SpotPhotoItem[] = [];
if (images && images.length > 0) {
  images.forEach((item) => {
    if (typeof item === 'object' && item !== null && 'image' in item) {
      photoItems.push(item as SpotPhotoItem);
    } else {
      photoItems.push({ image: item as string | ImageMetadata });
    }
  });
} else if (image) {
  photoItems.push({ image, imageCredit, isSample: isImageSample });
}

const isMulti = photoItems.length > 1;
const layout = propLayout || (isMulti ? 'carousel' : 'single');
const heroImg = getImageUrl(image || (photoItems[0]?.image) || spotData?.heroImage);

// カテゴリバッジ表示判定
const allowedHotelCategories = [
  '宿泊', '温泉宿', '温泉旅館', 'ホテル', 'ビジネスホテル', 'リゾートホテル', 'ゲストハウス'
];
const isHotelCategory = categoryLabel && allowedHotelCategories.includes(categoryLabel.trim());
const pillText = (isHotelCategory ? categoryLabel.trim() : null) || (alternativeLabel ? alternativeLabel.replace(/^【|】$/g, '').trim() : null) || categoryLabel;

// クレジット表記
function formatCreditText(credit?: string, isSample?: boolean): string {
  if (!credit && !isSample) return '';
  const text = credit ? `写真提供：${credit}` : '';
  const sample = isSample ? '※写真はイメージです' : '';
  if (text && sample) return `${text}（${sample}）`;
  return text || sample;
}

const creditText = formatCreditText(imageCredit, isImageSample);
---

<div
  class={`wide-spot-unit ${spotData && clickable ? 'clickable-unit' : ''}`}
  data-open-spot={spotData?.id}
  role={spotData && clickable ? 'button' : undefined}
  tabindex={spotData && clickable ? '0' : undefined}
>
  {layout === 'pip' && isMulti ? (
    /* ピクチャー・イン・ピクチャー */
    <div class="wide-photo-container photo-pip-container">
      <img src={getImageUrl(photoItems[0].image)} alt={title} class="wide-photo-img" loading="lazy" />
      <div class="pip-inset-frame">
        <img src={getImageUrl(photoItems[1].image)} alt={photoItems[1].caption || title} class="pip-inset-img" loading="lazy" />
      </div>
      <div class="wide-photo-overlay pointer-events-none">
        <div class="overlay-title-column align-left">
          {pillText && (
            <div class="overlay-tag-above-title">
              <span class="photo-category-pill">{pillText}</span>
            </div>
          )}
          <div class="overlay-title-row">
            <h4 class="overlay-heading single-line-heading">{title}</h4>
            {spotData && <span class="overlay-chevron">›</span>}
          </div>
        </div>
        <div class="overlay-bottom-bar">
          <div class="overlay-meta-right">
            {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
          </div>
        </div>
      </div>
    </div>
  ) : layout === 'grid-2' && isMulti ? (
    /* 2分割グリッド */
    <div class="wide-photo-container photo-grid-wrapper">
      <div class="photo-gallery-grid-2">
        <div class="grid-2-cell">
          <img src={getImageUrl(photoItems[0].image)} alt={title} class="grid-cell-img" loading="lazy" />
        </div>
        <div class="grid-2-cell">
          <img src={getImageUrl(photoItems[1].image)} alt={title} class="grid-cell-img" loading="lazy" />
        </div>
      </div>
      <div class="wide-photo-overlay pointer-events-none">
        <div class="overlay-title-column align-left">
          {pillText && (
            <div class="overlay-tag-above-title">
              <span class="photo-category-pill">{pillText}</span>
            </div>
          )}
          <div class="overlay-title-row">
            <h4 class="overlay-heading single-line-heading">{title}</h4>
            {spotData && <span class="overlay-chevron">›</span>}
          </div>
        </div>
        <div class="overlay-bottom-bar">
          <div class="overlay-meta-right">
            {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
          </div>
        </div>
      </div>
    </div>
  ) : layout === 'grid-3' && isMulti ? (
    /* 3分割グリッド */
    <div class="wide-photo-container photo-grid-wrapper">
      <div class="photo-gallery-grid-3">
        <div class="grid-3-main-cell">
          <img src={getImageUrl(photoItems[0].image)} alt={title} class="grid-cell-img" loading="lazy" />
        </div>
        <div class="grid-3-sub-column">
          {photoItems.slice(1, 3).map((p) => (
            <div class="grid-3-sub-cell">
              <img src={getImageUrl(p.image)} alt={title} class="grid-cell-img" loading="lazy" />
            </div>
          ))}
        </div>
      </div>
      <div class="wide-photo-overlay pointer-events-none">
        <div class="overlay-title-column align-left">
          {pillText && (
            <div class="overlay-tag-above-title">
              <span class="photo-category-pill">{pillText}</span>
            </div>
          )}
          <div class="overlay-title-row">
            <h4 class="overlay-heading single-line-heading">{title}</h4>
            {spotData && <span class="overlay-chevron">›</span>}
          </div>
        </div>
        <div class="overlay-bottom-bar">
          <div class="overlay-meta-right">
            {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
          </div>
        </div>
      </div>
    </div>
  ) : (
    /* 通常1枚写真 */
    <div class="wide-photo-container">
      {heroImg && <img src={heroImg} alt={title} class="wide-photo-img" loading="lazy" />}
      <div class="wide-photo-overlay">
        <div class="overlay-title-column align-left">
          {pillText && (
            <div class="overlay-tag-above-title">
              <span class="photo-category-pill">{pillText}</span>
            </div>
          )}
          <div class="overlay-title-row">
            <h4 class="overlay-heading single-line-heading">{title}</h4>
            {spotData && <span class="overlay-chevron">›</span>}
          </div>
        </div>
        <div class="overlay-bottom-bar">
          <div class="overlay-meta-right">
            {creditText && <span class="photo-credit-tag">{creditText}</span>}
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="wide-body-container">
    {businessHoursId && <BusinessHours id={businessHoursId} />}

    {points && points.length > 0 && (
      <ul class="clean-bullet-list">
        {points.map((pt) => {
          return <li>{pt}</li>;
        })}
      </ul>
    )}

    {!businessHoursId && !linksInList && links && links.length > 0 && (
      <p class="spot-links">
        {links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
        ))}
      </p>
    )}

    {amenities && amenities.length > 0 && (
      <p class="wide-amenities-line">
        {amenities.map((am) => am.label).join(' · ')}
      </p>
    )}

    <HotelPortalHub hotelData={hotelData} title={title} />
  </div>
</div>

<style>
  .wide-spot-unit {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #dce8e1;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }
  .wide-photo-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #20332c;
    overflow: hidden;
  }
  .wide-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wide-photo-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 14px 10px;
    background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.65) 100%);
    color: #ffffff;
  }
  .overlay-title-column {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .photo-category-pill {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: rgba(33, 92, 72, 0.9);
    padding: 2px 7px;
    border-radius: 4px;
    backdrop-filter: blur(2px);
  }
  .overlay-heading {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
    line-height: 1.35;
  }
  .overlay-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .overlay-chevron {
    font-size: 1.2rem;
    color: #8ce4cb;
    font-weight: 700;
  }
  .overlay-bottom-bar {
    display: flex;
    justify-content: flex-end;
  }
  .photo-credit-tag {
    font-size: 0.64rem;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.45);
    padding: 2px 6px;
    border-radius: 3px;
    backdrop-filter: blur(2px);
  }
  .wide-body-container {
    padding: 14px 16px 16px;
  }
  .clean-bullet-list {
    margin: 0 0 8px;
    padding-left: 18px;
    color: #334940;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .clean-bullet-list li {
    margin-bottom: 4px;
  }
  .spot-links {
    margin: 8px 0 0;
    font-size: 0.82rem;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .spot-links a {
    color: #1b634c;
    text-decoration: underline;
    font-weight: 700;
  }
  .wide-amenities-line {
    margin: 8px 0 0;
    font-size: 0.78rem;
    color: #62776e;
  }

  /* PiP & Grid */
  .photo-pip-container {
    position: relative;
  }
  .pip-inset-frame {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32%;
    aspect-ratio: 4 / 3;
    border: 2px solid #ffffff;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    z-index: 2;
  }
  .pip-inset-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-gallery-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100%;
    gap: 2px;
  }
  .photo-gallery-grid-3 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    height: 100%;
    gap: 2px;
  }
  .grid-3-sub-column {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
  }
  .grid-cell-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pointer-events-none {
    pointer-events: none;
  }
</style>
