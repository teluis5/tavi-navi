---
import type { ImageMetadata } from 'astro';
import HotelPortalHub from './HotelPortalHub.astro';
import BusinessHours from './BusinessHours.astro';
import SpotPhotoGallery, { type PhotoItem } from './SpotPhotoGallery.astro';

export interface Props {
  title: string;
  categoryLabel?: string;
  alternativeLabel?: string;
  areaLabel?: string;
  image?: string | ImageMetadata;
  images?: (string | ImageMetadata | PhotoItem)[];
  imageLayout?: 'single' | 'carousel' | 'grid-2' | 'grid-3' | 'pip';
  imageCredit?: string;
  isImageSample?: boolean;
  points?: string[];
  sceneLead?: string;
  stats?: { label: string; value: string; accent?: boolean }[];
  pickSticker?: string;
  editorTip?: { label?: string; text: string };
  links?: { label: string; href: string }[];
  linksInList?: boolean;
  businessHoursId?: string;
  hotelData?: any;
  spotData?: any;
  amenities?: { label: string }[];
  leadHeading?: string;
  isHotel?: boolean;
}

const {
  title,
  categoryLabel,
  alternativeLabel,
  areaLabel,
  image,
  images,
  imageLayout,
  imageCredit,
  isImageSample,
  points,
  sceneLead,
  stats,
  pickSticker,
  editorTip,
  links,
  linksInList,
  businessHoursId,
  hotelData,
  spotData,
  amenities,
  leadHeading,
  isHotel: propIsHotel,
} = Astro.props;

// 8大ホテルカテゴリ判定
function isAllowedHotelCategory(cat?: string): string | null {
  const allowed = [
    '温泉旅館',
    '天然温泉ホテル',
    '大浴場付きホテル',
    'ラグジュアリー',
    'シティホテル',
    'ビジネスホテル',
    'リゾートホテル',
    'ゲストハウス',
  ];
  if (cat && allowed.includes(cat.trim())) {
    return cat.trim();
  }
  return null;
}

function cleanText(text?: string): string {
  if (!text) return '';
  return text.replace(/^[\p{Emoji_Presentation}\p{Extended_Pictographic}\s]+/u, '').trim() || text;
}

const hotelCatName = isAllowedHotelCategory(categoryLabel);
const isSearchMore = title.includes('他の宿') || title.includes('宿を探す') || title.includes('ホテル一覧');
const isHotelStep = Boolean(propIsHotel || hotelCatName || hotelData?.hotelNo || hotelData?.rakutenUrl || isSearchMore);

const pillText = hotelCatName || cleanText(alternativeLabel);
const hasPhoto = Boolean(image || images?.some((item) => typeof item === 'string' ? item.trim() : item && ('image' in item ? item.image : item.src)));
---

<div
  class={`wide-spot-unit ${spotData ? 'clickable-unit' : ''}`}
  data-open-spot={spotData?.id}
  role={spotData ? 'button' : undefined}
  tabindex={spotData ? '0' : undefined}
>
  {hasPhoto ? <SpotPhotoGallery
    title={title}
    pillText={pillText}
    image={image}
    images={images}
    imageLayout={imageLayout}
    imageCredit={imageCredit}
    isImageSample={isImageSample}
    pickSticker={pickSticker}
    spotData={spotData}
    hotelData={hotelData}
  /> : <div class="spot-text-heading">{title}</div>}

  {stats && stats.length > 0 && (
    <div class="stat-strip">
      {stats.map((st) => (
        <div class={`stat-chip ${st.accent ? 'is-accent' : ''}`}>
          <span class="stat-chip-label">{st.label}</span>
          <span class="stat-chip-value">{st.value}</span>
        </div>
      ))}
    </div>
  )}

  <div class="wide-spot-body">
    <div class="spot-body-main">
      {sceneLead && (
        <p class="scene-lead-line"><span class="scene-mark">{sceneLead}</span></p>
      )}

      {(points || businessHoursId) && (
        <ul class="wide-points-list">
          {points?.map((pt) => (
            <li>{pt}</li>
          ))}
          {businessHoursId && <BusinessHours id={businessHoursId} />}
        </ul>
      )}

      {links && links.length > 0 && (
        <div class="pill-btn-row">
          {links.map((link) => (
            <a
              href={link.href}
              class="pill-btn"
              target={link.href.startsWith('http') ? '_blank' : undefined}
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
            >
              <span>{link.label}</span>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"></line>
                <polyline points="12 5 19 12 12 19"></polyline>
              </svg>
            </a>
          ))}
        </div>
      )}

      {editorTip && (
        <div class="editor-tip">
          <span class="editor-tip-label">{editorTip.label || 'LOCAL TIP'}</span>
          <p class="editor-tip-text">{editorTip.text}</p>
        </div>
      )}

      {amenities && amenities.length > 0 && (
        <p class="wide-amenities-line">
          {amenities.map((am) => am.label).join(' · ')}
        </p>
      )}
    </div>

    {isHotelStep && (
      <div class="spot-body-footer">
        <HotelPortalHub hotelData={hotelData} title={title} />
      </div>
    )}
  </div>
</div>

<style>
  /* 場所（スポット）：80%クリーンな白サーフェスカード（縦幅均等対応） */
  .wide-spot-unit {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
    transition: transform 0.15s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }

  .clickable-unit {
    cursor: pointer;
  }
  .clickable-unit:hover {
    border-color: #cbd5e1;
    box-shadow: 0 6px 16px rgba(15, 23, 42, 0.07);
  }
  .clickable-unit:active :global(.wide-photo-img) {
    transform: scale(1.02);
  }

  /* スポット本文（カード下部：縦幅伸長＆フッター下揃え） */
  .wide-spot-body {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    flex: 1 1 auto;
    gap: 0.75rem;
    padding: 0.95rem 1.05rem 1.15rem;
    background: #ffffff;
    box-sizing: border-box;
  }

  .spot-body-main {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .spot-text-heading {
    padding: 0.9rem 1rem 0;
    color: #111827;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .spot-body-footer {
    margin-top: auto;
  }

  /* 見どころ箇条書き */
  .wide-points-list {
    list-style: none !important;
    padding: 0 !important;
    margin: 0 !important;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .wide-points-list li {
    font-size: 0.88rem;
    line-height: 1.55;
    color: #111827;
    padding-left: 1rem;
    position: relative;
    margin: 0;
  }
  .wide-points-list li::before {
    content: "・";
    position: absolute;
    left: 0;
    top: 0;
    color: #4b5563;
    font-weight: 700;
  }

  /* 外部リンク */
  .spot-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 4px 0 0;
    font-size: 0.85rem;
  }
  .spot-links a {
    color: #12627c;
    text-decoration: underline;
    font-weight: 600;
  }
  .spot-links a:hover {
    color: #0c4a5e;
  }

  /* アメニティ行 */
  .wide-amenities-line {
    margin: 4px 0 0;
    font-size: 0.78rem;
    color: #64748b;
  }
</style>
