---
import type { ImageMetadata } from 'astro';
import HotelPortalHub from './HotelPortalHub.astro';
import BusinessHours from './BusinessHours.astro';
import SpotPhotoGallery, { type PhotoItem } from './SpotPhotoGallery.astro';

export interface Props {
  title: string;
  categoryLabel?: string;
  alternativeLabel?: string;
  areaLabel?: string;
  image?: string | ImageMetadata;
  images?: (string | ImageMetadata | PhotoItem)[];
  imageLayout?: 'single' | 'carousel' | 'grid-2' | 'grid-3' | 'pip';
  imageCredit?: string;
  isImageSample?: boolean;
  points?: string[];
  links?: { label: string; href: string }[];
  linksInList?: boolean;
  businessHoursId?: string;
  hotelData?: any;
  spotData?: any;
  amenities?: { label: string }[];
  leadHeading?: string;
  clickable?: boolean;
}

const {
  title,
  categoryLabel,
  alternativeLabel,
  areaLabel,
  image,
  images,
  imageLayout,
  imageCredit,
  isImageSample,
  points,
  links,
  linksInList,
  businessHoursId,
  hotelData,
  spotData,
  amenities,
  leadHeading,
  clickable = true,
} = Astro.props;

// カテゴリバッジ表示判定
const allowedHotelCategories = [
  '宿泊', '温泉宿', '温泉旅館', 'ホテル', 'ビジネスホテル', 'リゾートホテル', 'ゲストハウス'
];
const isHotelCategory = categoryLabel && allowedHotelCategories.includes(categoryLabel.trim());
const pillText = (isHotelCategory ? categoryLabel.trim() : null) || (alternativeLabel ? alternativeLabel.replace(/^【|】$/g, '').trim() : null) || categoryLabel;
---

<div
  class={`wide-spot-unit ${spotData && clickable ? 'clickable-unit' : ''}`}
  data-open-spot={spotData?.id}
  role={spotData && clickable ? 'button' : undefined}
  tabindex={spotData && clickable ? '0' : undefined}
>
  {leadHeading && (
    <div class="step-lead-heading">
      <h3 class="step-lead-text">{leadHeading}</h3>
    </div>
  )}

  <SpotPhotoGallery
    title={title}
    pillText={pillText}
    image={image}
    images={images}
    imageLayout={imageLayout}
    imageCredit={imageCredit}
    isImageSample={isImageSample}
    spotData={spotData}
  />

  <div class="wide-body-container">
    {businessHoursId && <BusinessHours id={businessHoursId} />}

    {((points && points.length > 0) || (linksInList && links && links.length > 0)) && (
      <ul class="clean-bullet-list">
        {points?.map((pt) => <li>{pt}</li>)}
        {linksInList && links && (
          <li>
            {links.map((link, index) => (
              <>
                {index > 0 && '（'}
                <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
                {index > 0 && '）'}
              </>
            ))}
          </li>
        )}
      </ul>
    )}

    {!businessHoursId && !linksInList && links && links.length > 0 && (
      <p class="spot-links">
        {links.map((link) => (
          <a href={link.href} target="_blank" rel="noopener">{link.label}</a>
        ))}
      </p>
    )}

    {amenities && amenities.length > 0 && (
      <p class="wide-amenities-line">
        {amenities.map((am) => am.label).join(' · ')}
      </p>
    )}

    <HotelPortalHub hotelData={hotelData} title={title} />
  </div>
</div>

<style>
  .wide-spot-unit {
    background: #ffffff;
    border-radius: 12px;
    border: 1px solid #dce8e1;
    overflow: hidden;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.04);
  }
  .step-lead-heading {
    padding: 10px 14px 6px;
  }
  .step-lead-text {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 800;
    color: #1a332a;
    line-height: 1.35;
  }
  .wide-body-container {
    padding: 14px 16px 16px;
  }
  .clean-bullet-list {
    margin: 0 0 8px;
    padding-left: 18px;
    color: #334940;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  .clean-bullet-list li {
    margin-bottom: 4px;
  }
  .spot-links {
    margin: 8px 0 0;
    font-size: 0.82rem;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .spot-links a {
    color: #1b634c;
    text-decoration: underline;
    font-weight: 700;
  }
  .wide-amenities-line {
    margin: 8px 0 0;
    font-size: 0.78rem;
    color: #62776e;
  }
</style>
