---
interface Props {
  destination?: string;
  origin?: string;
  feed?: string;
  direction?: 'outbound' | 'return' | 'both';
  destinations?: string[];
}
const { destination = '乳頭蟹場温泉', origin = '田沢湖駅前', feed = 'ugokotsu-tazawako', direction = 'both', destinations = [] } = Astro.props;
const stationName = origin.replace(/前$/, '');
---
<section class="timetable" data-timetable data-feed={feed} data-origin-name={origin} data-station-name={stationName} data-destination={destination} data-direction={direction}>
  {destinations.length > 1 && <label class="stop-selector">利用する温泉のバス停 <select data-stop>{destinations.map((stop) => <option value={stop} selected={stop === destination}>{stop}</option>)}</select></label>}
  <div data-periods class="periods" aria-label="ダイヤの期間"></div>
  <p class="status" data-status role="status">バスの時刻表を読み込んでいます。</p>
  <div data-results></div>
  <p class="credit">提供：<span data-publisher>羽後交通株式会社</span>（<a href="https://creativecommons.org/licenses/by/4.0/" data-license>CC BY 4.0</a>）・<a href="https://gtfs-data.jp/search?agencyId=ugokotsu" data-source>GTFSデータリポジトリ</a></p>
</section>

<script>
  type Stop = { id: string; name: string };
  type Trip = { id: string; route: string; service: string; headsign: string };
  type StopTime = { trip: string; stop: string; sequence: number; arrival: string; departure: string; pickup: string; dropoff: string };
  type Version = { start: string; end: string; stops: Stop[]; routes: { id: string; name: string }[]; trips: Trip[]; times: StopTime[]; calendar: Record<string, string>[]; exceptions: Record<string, string>[] };
  type Feed = { checkedAt: string; publisher: string; license: string; licenseUrl: string; sourceUrl: string; versions: Version[] };

  const isoDate = (value: string) => `${value.slice(0, 4)}-${value.slice(4, 6)}-${value.slice(6, 8)}`;
  const dateLabel = (value: string) => `${Number(value.slice(4, 6))}月${Number(value.slice(6, 8))}日`;
  const minutes = (value: string) => {
    const [hours, mins] = value.split(':').map(Number);
    return hours * 60 + mins;
  };
  const formatMinutes = (value: number) => `${value >= 1440 ? '翌日 ' : ''}${String(Math.floor(value / 60) % 24).padStart(2, '0')}:${String(value % 60).padStart(2, '0')}`;

  for (const widget of document.querySelectorAll<HTMLElement>('[data-timetable]')) {
    const periods = widget.querySelector<HTMLElement>('[data-periods]')!;
    const status = widget.querySelector<HTMLElement>('[data-status]')!;
    const results = widget.querySelector<HTMLElement>('[data-results]')!;
    const station = widget.dataset.originName || '田沢湖駅前';
    const stopSelector = widget.querySelector<HTMLSelectElement>('[data-stop]');
    const today = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    let selectedDate = today;

    fetch(`/data/transit/${encodeURIComponent(widget.dataset.feed || '')}.json`)
      .then((response) => { if (!response.ok) throw new Error('Timetable unavailable'); return response.json() as Promise<Feed>; })
      .then((feed) => {
        widget.querySelector<HTMLElement>('[data-publisher]')!.textContent = feed.publisher;
        const license = widget.querySelector<HTMLAnchorElement>('[data-license]')!;
        license.textContent = feed.license;
        license.href = feed.licenseUrl;
        widget.querySelector<HTMLAnchorElement>('[data-source]')!.href = feed.sourceUrl;
        const checked = new Date(feed.checkedAt);
        if (!Number.isFinite(checked.getTime()) || Date.now() - checked.getTime() > 48 * 60 * 60 * 1000) {
          status.textContent = '時刻表の更新を確認できません。運行会社の時刻表をご確認ください。';
          return;
        }
        const todayKey = today.replaceAll('-', '');
        const versions = [...feed.versions].sort((a, b) => a.start.localeCompare(b.start));
        const current = versions.find((v) => v.start <= todayKey && todayKey <= v.end);
        const future = versions.filter((v) => v.start > todayKey);
        const options = [...(current ? [current] : []), ...future];
        const render = () => {
          const destination = stopSelector?.value || widget.dataset.destination || '乳頭蟹場温泉';
          results.replaceChildren();
          const key = selectedDate.replaceAll('-', '');
          const version = versions.find((v) => v.start <= key && key <= v.end);
          periods.replaceChildren();
          for (const item of options) {
            const button = document.createElement('button');
            button.type = 'button';
            const season = item.routes.some((r) => r.name === '新玉川線') ? '冬季ダイヤ' : item.routes.some((r) => r.name === '玉川線') ? '夏季ダイヤ' : 'ダイヤ';
            const shortDate = (value: string) => `${Number(value.slice(4, 6))}/${Number(value.slice(6, 8))}`;
            button.textContent = item === current ? `現在（${shortDate(item.end)}まで）` : `${shortDate(item.start)}から ${season}`;
            button.setAttribute('aria-pressed', String(item === version));
            button.addEventListener('click', () => { selectedDate = item === current ? today : isoDate(item.start); render(); });
            periods.append(button);
          }
          if (!version) {
            status.textContent = 'この日の時刻表データはまだありません。運行会社の時刻表をご確認ください。';
            return;
          }
          const weekday = ['sunday', 'monday', 'tuesday', 'wednesday', 'thursday', 'friday', 'saturday'][new Date(`${selectedDate}T12:00:00+09:00`).getUTCDay()];
          const active = new Set(version.calendar.filter((c) => c.start_date <= key && key <= c.end_date && c[weekday] === '1').map((c) => c.service_id));
          for (const exception of version.exceptions.filter((e) => e.date === key)) {
            if (exception.exception_type === '1') active.add(exception.service_id);
            if (exception.exception_type === '2') active.delete(exception.service_id);
          }
          const grouped = new Map<string, StopTime[]>();
          for (const time of version.times) {
            if (!grouped.has(time.trip)) grouped.set(time.trip, []);
            grouped.get(time.trip)!.push(time);
          }
          const checkDate = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', dateStyle: 'medium' }).format(checked);
          status.textContent = `${checkDate} 更新確認`;
          for (const [from, to, heading] of [[station, destination, '行き'], [destination, station, '帰り']]) {
            if (widget.dataset.direction === 'outbound' && heading === '帰り') continue;
            if (widget.dataset.direction === 'return' && heading === '行き') continue;
            const section = document.createElement('section');
            section.className = 'journey';
            const title = document.createElement('h3');
            title.textContent = `${heading}　${from} → ${to}`;
            section.append(title);
            const fromIds = new Set(version.stops.filter((s) => s.name === from).map((s) => s.id));
            const toIds = new Set(version.stops.filter((s) => s.name === to).map((s) => s.id));
            const rows: { departure: number; arrival: number }[] = [];
            for (const trip of version.trips.filter((t) => active.has(t.service))) {
              const stops = (grouped.get(trip.id) || []).sort((a, b) => a.sequence - b.sequence);
              for (const first of stops.filter((s) => fromIds.has(s.stop) && s.pickup !== '1' && s.departure)) {
                const last = stops.find((s) => s.sequence > first.sequence && toIds.has(s.stop) && s.dropoff !== '1' && s.arrival);
                if (last) rows.push({ departure: minutes(first.departure), arrival: minutes(last.arrival) });
              }
            }
            rows.sort((a, b) => a.departure - b.departure);
            if (!rows.length) {
              const empty = document.createElement('p');
              empty.textContent = 'この日の直通便は確認できません。';
              section.append(empty);
            } else {
              const list = document.createElement('ul');
              list.className = 'departures';
              for (const row of rows) {
                const li = document.createElement('li');
                li.textContent = `${formatMinutes(row.departure)}発 → ${formatMinutes(row.arrival)}着`;
                list.append(li);
              }
              section.append(list);
              if (heading === '帰り') {
                const note = document.createElement('p');
                note.className = 'connection-summary';
                note.textContent = `最も早いバスの場合でも、${widget.dataset.stationName}を${formatMinutes(Math.min(...rows.map((r) => r.arrival)) + 10)}より前に出る列車には間に合いません。`;
                section.append(note);
              }
            }
            results.append(section);
          }
        };
        stopSelector?.addEventListener('change', render);
        render();
      })
      .catch(() => { status.textContent = '時刻表を取得できません。運行会社の時刻表をご確認ください。'; });
  }
</script>
<style>
  .timetable { margin: 24px 0; padding: 16px 0; border-top: 1px solid #d6e5e6; border-bottom: 1px solid #d6e5e6; }
  .periods { display: flex; flex-wrap: nowrap; gap: 6px; overflow-x: auto; }
  .periods :global(button) { flex: 0 0 auto; white-space: nowrap; padding: 7px 9px; border: 1px solid #aac3c3; border-radius: 20px; background: white; color: #24545b; font: inherit; font-size: .8rem; cursor: pointer; }
  .periods :global(button[aria-pressed="true"]) { background: #24545b; color: white; }
  .timetable p { margin: 8px 0; font-size: .85rem; line-height: 1.6; }
  .timetable :global(.journey h3) { margin: 14px 0 6px; font-size: .95rem; }
  .timetable :global(.departures) { margin: 0; padding-left: 1.2em; font-size: .85rem; line-height: 1.7; }
  .timetable :global(.connection-summary) { font-weight: 700; color: #123d50; }
  .stop-selector { display: block; margin: 0 0 10px; font-size: .85rem; }
  .stop-selector select { max-width: 100%; margin-left: 4px; padding: 5px; }
  .timetable .credit { color: #526676; font-size: .75rem; }
</style>
