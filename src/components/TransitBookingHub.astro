---
import { RAKUTEN_AFFILIATE_ID } from '../utils/affiliate';

export interface Props {
  destination?: string;
  station?: string;
  transportType?: 'shinkansen' | 'rentacar' | 'all';
  showExperience?: boolean;
  title?: string;
}

const {
  destination = '目的地',
  station = '',
  transportType = 'all',
  showExperience = true,
  title,
} = Astro.props;

// 楽天レンタカー公式アフィリエイトURL
const rentacarTargetUrl = station
  ? `https://travel.rakuten.co.jp/cars/search/?search_type=1&keyword=${encodeURIComponent(station)}`
  : `https://travel.rakuten.co.jp/cars/`;
const rakutenRentacarUrl = `https://hb.afl.rakuten.co.jp/hgc/${RAKUTEN_AFFILIATE_ID}/?pc=${encodeURIComponent(rentacarTargetUrl)}`;

// JR東日本 / どこかにビューーン / ダイナミックレールパック
const dokokaniByunUrl = 'https://dokokani-byun.com/';
const jreDynamicRailUrl = 'https://www.jre-travel.com/';

// アソビュー！体験・観光施設チケット
const asoviewUrl = `https://www.asoview.com/leisure/?keyword=${encodeURIComponent(destination || station)}`;
---

<aside class="transit-booking-hub" aria-label="交通・レンタカー・現地体験予約">
  <div class="transit-hub-header">
    <span class="transit-hub-badge">予約ハブ</span>
    <h3 class="transit-hub-title">
      {title || `${destination}への移動・現地チケットを予約する`}
    </h3>
    <p class="transit-hub-desc">
      新幹線チケットや駅前レンタカー、周辺の観光前売り券は事前予約がスムーズです。
    </p>
  </div>

  <div class="transit-hub-grid">
    {(transportType === 'all' || transportType === 'shinkansen') && (
      <div class="transit-card">
        <div class="card-body">
          <span class="card-tag">新幹線・JRセット</span>
          <h4 class="card-name">新幹線チケット・パック</h4>
          <p class="card-text">どこかにビューーン！なら往復6,000pt。列車＋宿のダイナミックレールパックもお得です。</p>
        </div>
        <div class="card-actions">
          <a
            href={dokokaniByunUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hub-btn btn-dokokani"
            title="どこかにビューーン！公式ページへ"
          >
            どこかにビューーン！公式 →
          </a>
          <a
            href={jreDynamicRailUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hub-btn btn-jr-pack"
            title="JR東日本ダイナミックレールパックへ"
          >
            JR＋宿セット予約 →
          </a>
        </div>
      </div>
    )}

    {(transportType === 'all' || transportType === 'rentacar') && (
      <div class="transit-card">
        <div class="card-body">
          <span class="card-tag">駅前レンタカー</span>
          <h4 class="card-name">楽天トラベル レンタカー</h4>
          <p class="card-text">
            {station ? `${station}周辺` : `${destination}周辺`}の各社レンタカーを最安値比較。楽天ポイントも貯まります。
          </p>
        </div>
        <div class="card-actions">
          <a
            href={rakutenRentacarUrl}
            target="_blank"
            rel="noopener sponsored"
            class="hub-btn btn-rentacar"
            title="楽天レンタカーで最安値を比較"
          >
            レンタカーを比較・予約 →
          </a>
        </div>
      </div>
    )}

    {(transportType === 'all' || showExperience) && (
      <div class="transit-card">
        <div class="card-body">
          <span class="card-tag">遊び・体験・温泉チケット</span>
          <h4 class="card-name">アソビュー！</h4>
          <p class="card-text">
            日帰り温泉やアクティビティ、観光施設の前売り電子チケットを事前購入できます。
          </p>
        </div>
        <div class="card-actions">
          <a
            href={asoviewUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="hub-btn btn-asoview"
            title="アソビューでレジャー・体験を探す"
          >
            前売りチケットを探す →
          </a>
        </div>
      </div>
    )}
  </div>
</aside>

<style>
  .transit-booking-hub {
    margin: 2rem 0;
    padding: 1.25rem 1.35rem;
    background: #f8fafc;
    border-radius: 10px;
    border: 1px solid #e2e8f0;
    box-sizing: border-box;
  }
  .transit-hub-header {
    margin-bottom: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }
  .transit-hub-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    color: #475569;
    background: #e2e8f0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
  }
  .transit-hub-title {
    margin: 0 !important;
    font-size: 1.05rem !important;
    font-weight: 800 !important;
    color: #111827 !important;
    line-height: 1.35 !important;
    border: none !important;
    padding: 0 !important;
  }
  .transit-hub-desc {
    margin: 0 !important;
    font-size: 0.78rem !important;
    color: #64748b !important;
    line-height: 1.45 !important;
  }
  .transit-hub-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 0.85rem;
  }
  .transit-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    background: #ffffff;
    border-radius: 8px;
    border: 1px solid #e2e8f0;
    box-sizing: border-box;
  }
  .card-body {
    flex: 1;
    margin-bottom: 0.75rem;
  }
  .card-tag {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 700;
    color: #475569;
    background: #f1f5f9;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
    margin-bottom: 0.35rem;
  }
  .card-name {
    margin: 0 0 0.35rem !important;
    font-size: 0.95rem !important;
    font-weight: 700 !important;
    color: #111827 !important;
    border: none !important;
    padding: 0 !important;
  }
  .card-text {
    margin: 0 !important;
    font-size: 0.76rem !important;
    color: #64748b !important;
    line-height: 1.45 !important;
  }
  .card-actions {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .hub-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 0.85rem;
    border-radius: 6px;
    text-decoration: none !important;
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1.2;
    transition: opacity 0.15s ease;
  }
  .hub-btn:hover {
    opacity: 0.9;
  }
  .btn-dokokani {
    background: #0284c7;
    color: #ffffff !important;
  }
  .btn-jr-pack {
    background: #16a34a;
    color: #ffffff !important;
  }
  .btn-rentacar {
    background: #dc2626;
    color: #ffffff !important;
  }
  .btn-asoview {
    background: #ea580c;
    color: #ffffff !important;
  }
</style>
