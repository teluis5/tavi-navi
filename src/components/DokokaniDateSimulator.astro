<section class="simulator" aria-labelledby="dokokani-simulator-title">
  <p class="simulator-kicker">DATE SIMULATOR</p>
  <h2 id="dokokani-simulator-title">出発日から予約日を調べる</h2>
  <p class="simulator-intro">行きの新幹線に乗る日を選んでください。申し込み期間と帰りの日の範囲がわかります。</p>
  <form class="simulator-form">
    <label for="dokokani-departure">行きの乗車日</label>
    <div class="simulator-controls">
      <input id="dokokani-departure" name="departure" type="date" min="1900-01-22" max="9999-12-25" required />
    </div>
  </form>
  <div class="simulator-result" aria-live="polite" hidden>
    <p class="result-lead">行き <strong data-departure></strong> の場合</p>
    <dl>
      <div><dt>申し込み開始</dt><dd><strong data-opening></strong><span>0:00から</span></dd></div>
      <div><dt>申し込み締切</dt><dd><strong data-closing></strong><span>23:59まで</span></dd></div>
      <div><dt>帰りの日</dt><dd><strong data-return></strong><span>日帰りから、行きの日を含む7日間</span></dd></div>
    </dl>
    <div class="calendar-section">
      <h3>カレンダーで見る</h3>
      <p class="calendar-intro">オレンジ色の1〜7日目が帰りの日の候補です。1日目は日帰り、7日目が帰りの最終日です。</p>
      <ul class="calendar-legend" aria-label="カレンダーの凡例">
        <li><span class="legend-swatch booking" aria-hidden="true"></span>申し込み期間</li>
        <li><span class="legend-swatch travel" aria-hidden="true"></span>帰りの日の範囲</li>
      </ul>
      <div class="calendar-months" data-calendar></div>
    </div>
    <div class="calendar-save">
      <h3>申し込み開始日をカレンダーに登録</h3>
      <p>受付開始日を終日の予定として追加します。</p>
      <div class="calendar-save-links">
        <a data-google-calendar target="_blank" rel="noopener noreferrer">Googleカレンダーに登録 ↗</a>
      </div>
    </div>
    <p class="simulator-note">日付の計算結果です。候補駅や座席の有無は、公式サイトでご確認ください。</p>
    <a class="official-link" href="https://dokokani-eki-net.com/dokokani/trial/index">公式のお試しページで検索する →</a>
  </div>
  <noscript><p class="simulator-note">日付の自動計算にはJavaScriptを有効にしてください。申し込みは行きの21日前から6日前まで、帰りは行きを含む7日間です。</p></noscript>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.simulator').forEach((simulator) => {
    const form = simulator.querySelector<HTMLFormElement>('.simulator-form');
    const input = simulator.querySelector<HTMLInputElement>('input[name="departure"]');
    const result = simulator.querySelector<HTMLElement>('.simulator-result');
    if (!form || !input || !result) return;

    const dateFormat = new Intl.DateTimeFormat('ja-JP', {
      timeZone: 'UTC', year: 'numeric', month: 'long', day: 'numeric', weekday: 'short',
    });
    const shiftDate = (date: Date, days: number) => {
      const shifted = new Date(date.getTime());
      shifted.setUTCDate(shifted.getUTCDate() + days);
      return shifted;
    };
    const calendar = result.querySelector<HTMLElement>('[data-calendar]');
    const googleLink = result.querySelector<HTMLAnchorElement>('[data-google-calendar]');
    const calendarDate = (date: Date) => date.toISOString().slice(0, 10).replace(/-/g, '');
    const updateCalendarLinks = (departure: Date, opening: Date, closing: Date) => {
      const title = 'どこかにビューーン！申し込み開始';
      const detail = `出発日：${dateFormat.format(departure)}\n申し込み締切：${dateFormat.format(closing)} 23:59\nhttps://dokokani-eki-net.com/`;
      const start = calendarDate(opening);
      const end = calendarDate(shiftDate(opening, 1));
      if (googleLink) {
        const params = new URLSearchParams({ action: 'TEMPLATE', text: title, dates: `${start}/${end}`, details: detail });
        googleLink.href = `https://calendar.google.com/calendar/render?${params.toString()}`;
      }
    };
    const renderCalendar = (departure: Date, opening: Date, closing: Date, returnLast: Date) => {
      if (!calendar) return;
      calendar.replaceChildren();
      const days = ['日', '月', '火', '水', '木', '金', '土'];
      const month = new Date(Date.UTC(opening.getUTCFullYear(), opening.getUTCMonth(), 1));
      const lastMonth = new Date(Date.UTC(returnLast.getUTCFullYear(), returnLast.getUTCMonth(), 1));
      const sameDay = (a: Date, b: Date) => a.getTime() === b.getTime();
      while (month <= lastMonth) {
        const year = month.getUTCFullYear();
        const monthIndex = month.getUTCMonth();
        const monthPanel = document.createElement('section');
        monthPanel.className = 'calendar-month';
        const title = document.createElement('h4');
        title.textContent = `${year}年${monthIndex + 1}月`;
        monthPanel.append(title);
        const grid = document.createElement('div');
        grid.className = 'calendar-grid';
        grid.setAttribute('aria-label', `${year}年${monthIndex + 1}月のカレンダー`);
        days.forEach((day) => {
          const header = document.createElement('span');
          header.className = 'calendar-weekday';
          header.textContent = day;
          grid.append(header);
        });
        for (let i = 0; i < month.getUTCDay(); i++) {
          const blank = document.createElement('span');
          blank.setAttribute('aria-hidden', 'true');
          grid.append(blank);
        }
        const count = new Date(Date.UTC(year, monthIndex + 1, 0)).getUTCDate();
        for (let day = 1; day <= count; day++) {
          const current = new Date(Date.UTC(year, monthIndex, day));
          const cell = document.createElement('div');
          cell.className = 'calendar-day';
          const labels: string[] = [];
          if (current >= opening && current <= closing) { cell.classList.add('is-booking'); labels.push('申し込み期間'); }
          const isReturnDay = current >= departure && current <= returnLast;
          if (isReturnDay) { cell.classList.add('is-travel'); labels.push('帰りの日の候補'); }
          let badge = '';
          if (sameDay(current, opening)) { badge = '開始'; labels.push('申し込み開始'); }
          else if (sameDay(current, closing)) { badge = '締切'; labels.push('申し込み締切'); }
          else if (isReturnDay) {
            const tripDay = Math.round((current.getTime() - departure.getTime()) / 86400000) + 1;
            badge = `${tripDay}日目`;
            labels.push(`旅行${tripDay}日目`);
            if (sameDay(current, departure)) { cell.classList.add('is-departure'); labels.push('出発日・日帰り'); }
            if (sameDay(current, returnLast)) labels.push('帰りの最終日');
          }
          cell.setAttribute('aria-label', `${year}年${monthIndex + 1}月${day}日${labels.length ? `、${labels.join('、')}` : ''}`);
          const number = document.createElement('span');
          number.textContent = String(day);
          cell.append(number);
          if (badge) {
            const marker = document.createElement('small');
            marker.textContent = badge;
            cell.append(marker);
          }
          grid.append(cell);
        }
        monthPanel.append(grid);
        calendar.append(monthPanel);
        month.setUTCMonth(month.getUTCMonth() + 1);
      }
    };
    const update = () => {
      if (!input.value || !input.checkValidity()) { result.hidden = true; return; }
      const departure = new Date(`${input.value}T00:00:00Z`);
      if (Number.isNaN(departure.getTime())) { result.hidden = true; return; }
      const display = (selector: string, text: string) => {
        const target = result.querySelector<HTMLElement>(selector);
        if (target) target.textContent = text;
      };
      const formattedDeparture = dateFormat.format(departure);
      display('[data-departure]', formattedDeparture);
      display('[data-opening]', dateFormat.format(shiftDate(departure, -21)));
      display('[data-closing]', dateFormat.format(shiftDate(departure, -6)));
      display('[data-return]', `${formattedDeparture} 〜 ${dateFormat.format(shiftDate(departure, 6))}`);
      updateCalendarLinks(departure, shiftDate(departure, -21), shiftDate(departure, -6));
      renderCalendar(departure, shiftDate(departure, -21), shiftDate(departure, -6), shiftDate(departure, 6));
      result.hidden = false;
    };
    input.addEventListener('input', update);
    input.addEventListener('change', update);
    form.addEventListener('submit', (event) => { event.preventDefault(); update(); });
  });
</script>

<style>
  .simulator { margin: 32px 0; padding: 24px; background: #edf6f8; border-radius: 12px; color: #193748; }
  .simulator .simulator-kicker { margin: 0 0 8px; color: #126078; font-size: 12px; font-weight: 700; letter-spacing: .08em; }
  .simulator h2 { margin: 0 0 8px; padding: 0; border: 0; background: transparent; color: #153e50; font-size: 21px; line-height: 1.35; }
  .simulator .simulator-intro { margin: 0 0 20px; color: #36515f; font-size: 14px; line-height: 1.7; }
  .simulator-form label { display: block; margin-bottom: 8px; font-size: 14px; font-weight: 700; }
  .simulator-controls { display: flex; flex-wrap: wrap; gap: 8px; }
  .simulator-controls input { flex: 1 1 160px; min-width: 0; min-height: 48px; padding: 8px 12px; border: 1px solid #91aab5; border-radius: 8px; background: white; color: #193748; font: inherit; box-sizing: border-box; }
  .simulator-controls input:focus-visible, .official-link:focus-visible { outline: 3px solid #193748; outline-offset: 2px; }
  .simulator-result[hidden] { display: none; }
  .simulator .result-lead { margin: 24px 0 12px; font-size: 14px; }
  .simulator-result dl { margin: 0; }
  .simulator-result dl div { padding: 12px 0; border-top: 1px solid #c7dce2; }
  .simulator-result dt { color: #36515f; font-size: 13px; font-weight: 700; }
  .simulator-result dd { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin: 4px 0 0; color: #193748; }
  .simulator-result dd strong { font-size: 16px; line-height: 1.5; }
  .simulator-result dd span { font-size: 12px; color: #36515f; }
  .calendar-save { margin-top: 24px; }
  .calendar-save h3 { margin: 0 0 8px; padding: 0; border: 0; color: #193748; font-size: 16px; line-height: 1.4; }
  .simulator .calendar-save p { margin: 0 0 12px; color: #36515f; font-size: 13px; line-height: 1.6; }
  .calendar-save-links { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr)); gap: 8px; }
  .calendar-save-links a { display: flex; align-items: center; justify-content: center; min-height: 48px; padding: 8px 12px; border: 1px solid #126078; border-radius: 8px; background: #fff; color: #12566b; font-size: 13px; font-weight: 700; text-align: center; text-decoration: none; }
  .calendar-save-links a:first-child { background: #126078; color: #fff; }
  .calendar-save-links a:focus-visible { outline: 3px solid #193748; outline-offset: 2px; }
  .calendar-section { margin-top: 24px; }
  .calendar-section h3 { margin: 0 0 4px; padding: 0; border: 0; font-size: 17px; color: #193748; }
  .simulator .calendar-intro { margin: 0; color: #36515f; font-size: 13px; line-height: 1.6; }
  .calendar-legend { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 12px 0 16px; padding: 0; list-style: none; font-size: 12px; color: #193748; }
  .calendar-legend li { display: flex; align-items: center; gap: 6px; margin: 0; }
  .legend-swatch { width: 14px; height: 14px; border-radius: 4px; flex: none; }
  .legend-swatch.booking { background: #b8e4e9; }
  .legend-swatch.travel { background: #ffe4b4; }
  .calendar-months { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); gap: 16px; }
  .simulator :global(.calendar-month) { min-width: 0; padding: 16px; background: #fff; border-radius: 8px; }
  .simulator :global(.calendar-month h4) { margin: 0 0 12px; padding: 0; font-size: 16px; line-height: 1.3; color: #193748; }
  .simulator :global(.calendar-grid) { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 3px; }
  .simulator :global(.calendar-weekday) { padding: 0 0 4px; text-align: center; color: #526676; font-size: 11px; font-weight: 700; }
  .simulator :global(.calendar-day) { min-width: 0; min-height: 36px; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2px 0; border-radius: 4px; color: #193748; font-size: 13px; line-height: 1.2; }
  .simulator :global(.calendar-day.is-booking) { background: #d4eef0; }
  .simulator :global(.calendar-day.is-travel) { background: #ffebc9; }
  .simulator :global(.calendar-day.is-departure) { box-shadow: inset 0 0 0 2px #9b5b00; }
  .simulator :global(.calendar-day small) { font-size: 9px; font-weight: 700; color: #193748; line-height: 1.2; }
  .simulator .simulator-note { margin: 16px 0 0; color: #36515f; font-size: 12px; line-height: 1.7; }
  .official-link { display: inline-block; margin-top: 12px; color: #125c75; font-size: 14px; font-weight: 700; }
  @media (max-width: 380px) { .simulator { padding: 20px 16px; } }
</style>
