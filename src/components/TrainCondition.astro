---
interface Props { text: string }
const { text } = Astro.props;
---
<aside class="train-condition" aria-label="こまちの時間条件">
  <strong>このコースの列車選び</strong>
  <p>{text}</p>
</aside>
<style>
  .train-condition { margin: 20px 0 28px; padding: 16px 20px; border-left: 4px solid #b34f23; background: #fff5ed; border-radius: 4px; color: #473021; }
  .train-condition strong { color: #963a16; font-size: .9rem; }
  .train-condition p { margin: 6px 0 0; font-size: 1rem; font-weight: 700; line-height: 1.7; white-space: pre-line; }
</style>
