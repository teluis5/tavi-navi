---
import type { ImageMetadata } from 'astro';
import SpotCard, { type SpotData, type SpotAmenity } from './SpotCard.astro';
import { buildRakutenTravelUrl } from '../utils/affiliate';

export interface TimelineHotelData {
  rating?: string;        // e.g. "4.4"
  reviewCount?: string;   // e.g. "2,150"
  rakutenUrl?: string;    // アフィリエイトURL（未指定時はホテル名等から自動生成）
  hotelNo?: string | number; // 楽天トラベルの施設番号
  areaUrl?: string;       // エリア一覧検索URL（例: "https://search.travel.rakuten.co.jp/ds/hotellist/Japan-Akita-Semboku-Tazawako"）
  priceText?: string;     // e.g. "2名1室 税込14,800円〜"
  features?: string[];
}

export interface TimelineTransitDetail {
  method: string;         // e.g. "湯〜遊〜バス 約12分"
  route?: string;         // e.g. "熱海銀座バス停 → サンビーチ前"
  specs?: string[];       // e.g. ["運行：1時間に3〜4本（約15〜20分間隔）", "運賃200円（交通系IC可）"]
}

export interface TimelinePhotoItem {
  image: string | ImageMetadata;
  caption?: string;
  imageCredit?: string;
}

export type HotelCategory =
  | '温泉旅館'
  | '天然温泉ホテル'
  | '大浴場付きホテル'
  | 'ラグジュアリー'
  | 'シティホテル'
  | 'ビジネスホテル'
  | 'リゾートホテル'
  | 'ゲストハウス';

export interface TimelineStep {
  id?: string;
  leadHeading?: string;   // e.g. "サザンビーチで海を見ながら散歩"（体験アクション見出し）
  areaLabel?: string;     // e.g. "海沿いエリア", "熱海銀座商店街"（場所イメージ補強用）
  duration?: string;      // e.g. "目安 75分", "ランチ 60分", "宿泊"
  time?: string;          // 後方互換用
  title: string;          // e.g. "熱海サンビーチ & 親水公園"
  icon?: string;
  categoryLabel?: HotelCategory | string; // 宿の場合は8大カテゴリ（温泉旅館/天然温泉ホテル/大浴場付きホテル/ラグジュアリー/シティホテル/ビジネスホテル/リゾートホテル/ゲストハウス）
  isImageSample?: boolean; // 食事等で実際の店舗メニューでない場合の「※写真はイメージです」表記
  image?: string | ImageMetadata; // サムネイル・ワイド画像URLまたはインポート画像
  imageCredit?: string;   // 写真クレジット提供元（例: "秋田県観光連盟"）
  images?: (string | ImageMetadata | TimelinePhotoItem)[]; // 単一箇所での複数写真
  imageLayout?: 'carousel' | 'grid-2' | 'grid-3' | 'pip'; // 写真のレイアウト形式（pip: ピクチャーインピクチャ、メイン大＋右上に子写真小）
  desc?: string;
  points?: string[];      // 箇条書きポイント（最大2〜3行）
  amenities?: SpotAmenity[]; // 設備情報
  transit?: string;       // 移動情報メイン（e.g. "徒歩 約8分"）
  transitRoute?: string;  // 移動区間・道のりイメージ（e.g. "サンビーチ海沿いデッキ → 熱海銀座アーケード"）
  transitSpecs?: string[];// 運行本数・高低差・運賃などの実用ディテール
  transitDetail?: TimelineTransitDetail;
  transitBadge?: string;

  // 横スワイプ候補（カルーセル）機能
  alternativeLabel?: string; // 短縮ラベル推奨（例: "海鮮丼", "静岡牛", "イタリアン"）
  alternatives?: TimelineStep[]; // スワイプで切り替え可能な代替候補たち

  // 全画面スポットカードポップアップ用
  spotData?: SpotData;

  // 宿アフィリエイト用
  isHotel?: boolean;
  hotelData?: TimelineHotelData;
}

export interface TimelineDay {
  dayNumber?: number;
  title: string;
  subtitle?: string;
  steps: TimelineStep[];
}

interface Props {
  dayTitle?: string;
  steps?: TimelineStep[];
  days?: TimelineDay[];
}

const { dayTitle, steps, days: rawDays } = Astro.props;

const timelineDays: TimelineDay[] = rawDays || (steps ? [{
  dayNumber: 1,
  title: dayTitle || '',
  steps: steps
}] : []);

// 全ステップからモーダル用のspotDataを収集
const allModalSpots: SpotData[] = [];
timelineDays.forEach(day => {
  day.steps.forEach(step => {
    if (step.spotData) allModalSpots.push(step.spotData);
    if (step.alternatives) {
      step.alternatives.forEach(alt => {
        if (alt.spotData) allModalSpots.push(alt.spotData);
      });
    }
  });
});

function cleanText(text?: string): string {
  if (!text) return '';
  return text.replace(/^[\p{Emoji_Presentation}\p{Extended_Pictographic}\s]+/u, '').trim() || text;
}

// Unsplash等の小サイズ画像パラメータをシネマワイド用高解像度(w=1080)へ自動最適化、またはImageMetadataを展開
function getWideImageUrl(url?: string | ImageMetadata, fallbackUrl?: string | ImageMetadata): string {
  let target = '';
  if (fallbackUrl) {
    target = typeof fallbackUrl === 'object' ? fallbackUrl.src : fallbackUrl;
  } else if (url) {
    target = typeof url === 'object' ? url.src : url;
  }
  if (!target) return '';
  if (target.includes('images.unsplash.com')) {
    return target.replace(/w=\d+/, 'w=1080').replace(/q=\d+/, 'q=85');
  }
  return target;
}

function isAllowedHotelCategory(cat?: string): string | null {
  const allowed = [
    '温泉旅館',
    '天然温泉ホテル',
    '大浴場付きホテル',
    'ラグジュアリー',
    'シティホテル',
    'ビジネスホテル',
    'リゾートホテル',
    'ゲストハウス',
  ];
  if (cat && allowed.includes(cat.trim())) {
    return cat.trim();
  }
  return null;
}

// ホテルの楽天トラベル予約URL解決ヘルパー
function resolveHotelBookingUrl(step: TimelineStep): { url: string; label: string } | null {
  const isHotelStep = step.isHotel || !!isAllowedHotelCategory(step.categoryLabel);
  if (!isHotelStep && !step.hotelData?.rakutenUrl) {
    return null;
  }

  // 「他の宿を探す」カードなどのカスタム判定
  const isSearchMore = step.title.includes('他の宿') || step.title.includes('宿を探す') || step.title.includes('ホテル一覧');
  const label = isSearchMore
    ? '楽天トラベルでこのエリアの宿を探す'
    : '楽天トラベルでこのホテルを予約する';

  if (step.hotelData?.rakutenUrl) {
    return { url: step.hotelData.rakutenUrl, label };
  }
  if (step.hotelData?.hotelNo) {
    return { url: buildRakutenTravelUrl({ hotelNo: step.hotelData.hotelNo }), label };
  }
  if (step.hotelData?.areaUrl) {
    return { url: buildRakutenTravelUrl({ areaUrl: step.hotelData.areaUrl }), label };
  }
  if (step.title) {
    return { url: buildRakutenTravelUrl({ keyword: step.title }), label };
  }
  return null;
}

// グリッド・PiPレイアウト用の複数クレジット合成表示ヘルパー
function formatGridCredits(photos: TimelinePhotoItem[], defaultCredit?: string, layout?: 'grid-2' | 'grid-3' | 'pip'): string {
  const count = layout === 'grid-2' || layout === 'pip' ? 2 : 3;
  const targetPhotos = photos.slice(0, count);
  const credits = targetPhotos.map(p => p.imageCredit || defaultCredit || '').filter(Boolean);

  if (credits.length === 0) return '';

  // 全て同じ提供元の場合 ➔ 「写真提供：秋田県観光連盟」
  const allSame = credits.every(c => c === credits[0]);
  if (allSame) {
    return formatCredit(credits[0]);
  }

  // 異なる提供元が含まれる場合
  const labels = layout === 'pip'
    ? ['背景', '小枠']
    : layout === 'grid-2'
      ? ['左', '右']
      : ['左', '右上', '右下'];

  const parts: string[] = [];
  targetPhotos.forEach((p, idx) => {
    const cred = p.imageCredit || defaultCredit;
    if (cred) {
      parts.push(`${cred}(${labels[idx] || `位置${idx + 1}`})`);
    }
  });

  return `写真提供：${parts.join('、')}`;
}

// 移動（トランジット）情報の正規化ヘルパー
function formatCredit(credit?: string, isImageSample?: boolean): string {
  let text = '';
  if (credit) {
    text = credit.startsWith('写真提供') || credit.startsWith('©') || credit.startsWith('Photo')
      ? credit
      : `写真提供：${credit}`;
  }
  if (isImageSample) {
    return text ? `${text}（イメージ写真）` : '※写真はイメージです';
  }
  return text;
}

// 単一スポット内の複数写真（ギャラリー・カルーセル・グリッド）の正規化
function resolvePhotos(step: TimelineStep): TimelinePhotoItem[] {
  if (step.images && step.images.length > 0) {
    return step.images.map((item) => {
      if (typeof item === 'object' && item !== null && 'image' in item) {
        const photoObj = item as TimelinePhotoItem;
        return {
          image: photoObj.image,
          caption: photoObj.caption,
          imageCredit: photoObj.imageCredit || step.imageCredit,
        };
      }
      return {
        image: item as string | ImageMetadata,
        imageCredit: step.imageCredit,
      };
    });
  }
  if (step.image) {
    return [{
      image: step.image,
      imageCredit: step.imageCredit,
    }];
  }
  return [];
}

function resolveTransitInfo(step: TimelineStep): TimelineTransitDetail | null {
  if (step.transitDetail) {
    return {
      method: cleanText(step.transitDetail.method),
      route: step.transitDetail.route,
      specs: step.transitDetail.specs || [],
    };
  }
  const rawMain = cleanText(step.transit || step.transitBadge);
  if (!rawMain && !step.transitRoute && (!step.transitSpecs || step.transitSpecs.length === 0)) {
    return null;
  }

  let method = rawMain;
  const specs = step.transitSpecs ? [...step.transitSpecs] : [];

  // 既存記事で "徒歩 8分（平坦・歩道あり）" のように括弧書きが含まれ、かつ transitSpecs 未指定の場合は自動分割
  if (specs.length === 0 && rawMain) {
    const match = rawMain.match(/^(.+?)[（(](.+?)[）)]$/);
    if (match) {
      method = match[1].trim();
      specs.push(match[2].trim());
    }
  }

  return {
    method,
    route: step.transitRoute,
    specs,
  };
}
---

<div class="tavinavi-timeline-wide">
  {timelineDays.map((day) => (
    <div class="timeline-day-block">
      {day.title && (
        <div class="day-header-banner">
          <span class="day-number-pill">DAY {day.dayNumber || 1}</span>
          <h3 class="day-title-text">{day.title}</h3>
        </div>
      )}

      <div class="step-flow-list">
        {day.steps && day.steps.map((step, index) => {
          const isLast = index === day.steps.length - 1;
          const hasAlternatives = step.alternatives && step.alternatives.length > 0;
          // 親ステップにalternativeLabelがある場合は親自身も第1候補とし、ない場合はalternatives自体を全候補とする
          const allOptions = hasAlternatives
            ? (step.alternativeLabel ? [step, ...step.alternatives!] : step.alternatives!)
            : [step];
          const transitInfo = !isLast ? resolveTransitInfo(step) : null;

          return (
            <div class={`flow-step-item ${isLast ? 'is-last-step' : ''}`}>
              <div class="step-place-surface">
                {hasAlternatives && (
                  <div class="carousel-section-header" data-track-id={`wide-track-${index}`}>
                    {step.leadHeading && (
                      <div class="step-lead-heading">
                        <h3 class="step-lead-text">{step.leadHeading}</h3>
                      </div>
                    )}

                    <div class="swipe-tab-scroll">
                      {allOptions.map((opt, optIdx) => (
                        <button
                          type="button"
                          class={`swipe-tab-btn ${optIdx === 0 ? 'is-active' : ''}`}
                          aria-pressed={optIdx === 0 ? 'true' : 'false'}
                          data-slide-index={optIdx}
                        >
                          {cleanText(opt.alternativeLabel) || `候補${optIdx + 1}`}
                        </button>
                      ))}
                    </div>
                  </div>
                )}

                <div class="step-content-area">
                  {hasAlternatives ? (
                    <div class="peeking-carousel-wrapper">
                      <div class="peeking-carousel-track" tabindex="0" role="region" aria-label="候補一覧。左右の矢印キーで移動できます">
                        {allOptions.map((opt, optIdx) => {
                          const optPhotos = resolvePhotos(opt);
                          const isOptMulti = optPhotos.length > 1;
                          const optLayout = opt.imageLayout || (isOptMulti ? 'carousel' : 'single');
                          const heroImg = getWideImageUrl(opt.image, opt.spotData?.heroImage);
                          const areaText = opt.areaLabel || step.areaLabel;
                          const optPill = isAllowedHotelCategory(opt.categoryLabel) || cleanText(opt.alternativeLabel);
                          const optCreditText = (optLayout === 'grid-2' || optLayout === 'grid-3' || optLayout === 'pip') && isOptMulti
                            ? formatGridCredits(optPhotos, opt.imageCredit || step.imageCredit, optLayout)
                            : formatCredit(opt.imageCredit || step.imageCredit, opt.isImageSample || step.isImageSample);
                          const optBookingUrl = resolveHotelBookingUrl(opt);

                          return (
                            <div class={`carousel-slide-item ${optIdx === 0 ? 'is-active-slide' : ''}`}>
                              <div
                                class="wide-spot-unit clickable-unit"
                                data-open-spot={opt.spotData?.id}
                                role={opt.spotData ? "button" : undefined}
                                tabindex={opt.spotData ? "0" : undefined}
                              >
                                {optLayout === 'pip' && isOptMulti ? (
                                  /* カルーセル内PiP */
                                  <div class="wide-photo-container photo-pip-container">
                                    <img src={getWideImageUrl(optPhotos[0].image)} alt={opt.title} class="wide-photo-img" loading="lazy" />
                                    <div class="pip-inset-frame">
                                      <img src={getWideImageUrl(optPhotos[1].image)} alt={optPhotos[1].caption || opt.title} class="pip-inset-img" loading="lazy" />
                                    </div>
                                    <div class="wide-photo-overlay pointer-events-none">
                                      <div class="overlay-title-column align-left">
                                        {optPill && (
                                          <div class="overlay-tag-above-title">
                                            <span class="photo-category-pill">{optPill}</span>
                                          </div>
                                        )}
                                        <div class="overlay-title-row">
                                          <h4 class="overlay-heading single-line-heading">{opt.title}</h4>
                                          {opt.spotData && <span class="overlay-chevron">›</span>}
                                        </div>
                                      </div>
                                      <div class="overlay-bottom-bar">
                                        <div class="overlay-meta-right">
                                          {optCreditText && (
                                            <span class="photo-credit-tag tiny-credit">{optCreditText}</span>
                                          )}
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                ) : optLayout === 'grid-2' && isOptMulti ? (
                                  /* カルーセル内2分割グリッド */
                                  <div class="wide-photo-container photo-grid-wrapper">
                                    <div class="photo-gallery-grid-2">
                                      {optPhotos.slice(0, 2).map((photo) => (
                                        <div class="grid-cell-photo-container">
                                          <img src={getWideImageUrl(photo.image)} alt={opt.title} class="grid-cell-img" loading="lazy" />
                                        </div>
                                      ))}
                                    </div>
                                    <div class="wide-photo-overlay pointer-events-none">
                                      <div class="overlay-title-column align-left">
                                        {optPill && (
                                          <div class="overlay-tag-above-title">
                                            <span class="photo-category-pill">{optPill}</span>
                                          </div>
                                        )}
                                        <div class="overlay-title-row">
                                          <h4 class="overlay-heading single-line-heading">{opt.title}</h4>
                                          {opt.spotData && <span class="overlay-chevron">›</span>}
                                        </div>
                                      </div>
                                      <div class="overlay-bottom-bar">
                                        <div class="overlay-meta-right">
                                          {optCreditText && (
                                            <span class="photo-credit-tag tiny-credit">{optCreditText}</span>
                                          )}
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                ) : optLayout === 'grid-3' && isOptMulti ? (
                                  /* カルーセル内3分割グリッド */
                                  <div class="wide-photo-container photo-grid-wrapper">
                                    <div class="photo-gallery-grid-3">
                                      <div class="grid-3-main-cell">
                                        <img src={getWideImageUrl(optPhotos[0].image)} alt={opt.title} class="grid-cell-img" loading="lazy" />
                                      </div>
                                      <div class="grid-3-sub-column">
                                        {optPhotos.slice(1, 3).map((photo) => (
                                          <div class="grid-3-sub-cell">
                                            <img src={getWideImageUrl(photo.image)} alt={opt.title} class="grid-cell-img" loading="lazy" />
                                          </div>
                                        ))}
                                      </div>
                                    </div>
                                    <div class="wide-photo-overlay pointer-events-none">
                                      <div class="overlay-title-column align-left">
                                        {optPill && (
                                          <div class="overlay-tag-above-title">
                                            <span class="photo-category-pill">{optPill}</span>
                                          </div>
                                        )}
                                        <div class="overlay-title-row">
                                          <h4 class="overlay-heading single-line-heading">{opt.title}</h4>
                                          {opt.spotData && <span class="overlay-chevron">›</span>}
                                        </div>
                                      </div>
                                      <div class="overlay-bottom-bar">
                                        <div class="overlay-meta-right">
                                          {optCreditText && (
                                            <span class="photo-credit-tag tiny-credit">{optCreditText}</span>
                                          )}
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                ) : (
                                  /* 通常1枚写真 */
                                  <div class="wide-photo-container">
                                    {heroImg && (
                                      <img src={heroImg} alt={opt.title} class="wide-photo-img" loading="lazy" />
                                    )}
                                    <div class="wide-photo-overlay">
                                      <div class="overlay-title-column align-left">
                                        {optPill && (
                                          <div class="overlay-tag-above-title">
                                            <span class="photo-category-pill">{optPill}</span>
                                          </div>
                                        )}
                                        <div class="overlay-title-row">
                                          <h4 class="overlay-heading single-line-heading">{opt.title}</h4>
                                          {opt.spotData && <span class="overlay-chevron">›</span>}
                                        </div>
                                      </div>
                                      <div class="overlay-bottom-bar">
                                        <div class="overlay-meta-right">
                                          {optCreditText && (
                                            <span class="photo-credit-tag tiny-credit">{optCreditText}</span>
                                          )}
                                        </div>
                                      </div>
                                    </div>
                                  </div>
                                )}

                                <div class="wide-spot-body">
                                  {opt.points && opt.points.length > 0 && (
                                    <ul class="wide-points-list">
                                      {opt.points.map((pt) => (
                                        <li>{pt}</li>
                                      ))}
                                    </ul>
                                  )}

                                  {opt.amenities && opt.amenities.length > 0 && (
                                    <p class="wide-amenities-line">
                                      {opt.amenities.map((am) => am.label).join(' · ')}
                                    </p>
                                  )}

                                  {optBookingUrl && (
                                    <a
                                      href={optBookingUrl.url}
                                      target="_blank"
                                      rel="noopener sponsored"
                                      class="wide-hotel-cta"
                                    >
                                      <span>{optBookingUrl.label}</span>
                                      <span class="cta-arrow">→</span>
                                    </a>
                                  )}
                                </div>
                              </div>
                            </div>
                          );
                        })}
                      </div>

                      <div class="carousel-dots-row">
                        {allOptions.map((_, dotIdx) => (
                          <span class={`indicator-dot ${dotIdx === 0 ? 'is-active' : ''}`} data-dot-index={dotIdx}></span>
                        ))}
                      </div>
                    </div>
                  ) : step.isHotel ? (
                    <div class="wide-hotel-unit">
                      {step.leadHeading && (
                        <div class="step-lead-heading">
                          <h3 class="step-lead-text">{step.leadHeading}</h3>
                        </div>
                      )}

                      <div class="wide-photo-container">
                        {step.image && (
                          <img src={getWideImageUrl(step.image)} alt={step.title} class="wide-photo-img" loading="lazy" />
                        )}
                        <div class="wide-photo-overlay">
                          <div class="overlay-title-column align-left">
                            {isAllowedHotelCategory(step.categoryLabel) && (
                              <div class="overlay-tag-above-title">
                                <span class="photo-category-pill">{isAllowedHotelCategory(step.categoryLabel)}</span>
                              </div>
                            )}
                            <div class="overlay-title-row">
                              <h4 class="overlay-heading single-line-heading">{step.title}</h4>
                            </div>
                          </div>
                          <div class="overlay-bottom-bar">
                            <div class="overlay-meta-right">
                              {step.imageCredit && (
                                <span class="photo-credit-tag tiny-credit">{formatCredit(step.imageCredit)}</span>
                              )}
                            </div>
                            {step.hotelData && (
                              <div class="overlay-hotel-rating">
                                <span class="rating-star">★ {step.hotelData.rating}</span>
                                <span class="rating-count">({step.hotelData.reviewCount}件)</span>
                                {step.hotelData.priceText && (
                                  <span class="rating-price">· {step.hotelData.priceText}</span>
                                )}
                              </div>
                            )}
                          </div>
                        </div>
                      </div>

                      <div class="wide-spot-body">
                        {step.points && (
                          <ul class="wide-points-list">
                            {step.points.map((pt) => (
                              <li>{pt}</li>
                            ))}
                          </ul>
                        )}

                        {resolveHotelBookingUrl(step) && (
                          <a
                            href={resolveHotelBookingUrl(step)!.url}
                            target="_blank"
                            rel="noopener sponsored"
                            class="wide-hotel-cta"
                          >
                            <span>{resolveHotelBookingUrl(step)!.label}</span>
                            <span class="cta-arrow">→</span>
                          </a>
                        )}
                      </div>
                    </div>
                  ) : (() => {
                    const photoItems = resolvePhotos(step);
                    const isMulti = photoItems.length > 1;
                    const layout = step.imageLayout || (isMulti ? 'carousel' : 'single');

                    return (
                      <div
                        class="wide-spot-unit clickable-unit"
                        data-open-spot={step.spotData?.id}
                        role={step.spotData ? "button" : undefined}
                        tabindex={step.spotData ? "0" : undefined}
                      >
                        {step.leadHeading && (
                          <div class="step-lead-heading">
                            <h3 class="step-lead-text">{step.leadHeading}</h3>
                          </div>
                        )}

                        {layout === 'pip' && isMulti ? (
                          /* ピクチャーインピクチャ（PiP）レイアウト：メイン写真（背景全面）＋右上にサブ写真（小枠） */
                          <div class="wide-photo-container photo-pip-container">
                            <img src={getWideImageUrl(photoItems[0].image)} alt={step.title} class="wide-photo-img" loading="lazy" />

                            <div class="pip-inset-frame">
                              <img src={getWideImageUrl(photoItems[1].image)} alt={photoItems[1].caption || step.title} class="pip-inset-img" loading="lazy" />
                            </div>

                            <div class="wide-photo-overlay pointer-events-none">
                              <div class="overlay-title-row align-left">
                                <h4 class="overlay-heading single-line-heading">{step.title}</h4>
                                {step.spotData && <span class="overlay-chevron">›</span>}
                              </div>
                              <div class="overlay-bottom-bar">
                                <div class="overlay-meta-right">
                                  <span class="photo-credit-tag tiny-credit">{formatGridCredits(photoItems, step.imageCredit, 'pip')}</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        ) : layout === 'grid-2' && isMulti ? (
                          /* 2分割グリッドレイアウト（写真は2分割、文字・タイトルは全体に1つだけ固定オーバーレイ） */
                          <div class="wide-photo-container photo-grid-wrapper">
                            <div class="photo-gallery-grid-2">
                              {photoItems.slice(0, 2).map((photo) => (
                                <div class="grid-cell-photo-container">
                                  <img src={getWideImageUrl(photo.image)} alt={step.title} class="grid-cell-img" loading="lazy" />
                                </div>
                              ))}
                            </div>

                            <div class="wide-photo-overlay pointer-events-none">
                              <div class="overlay-title-row align-left">
                                <h4 class="overlay-heading single-line-heading">{step.title}</h4>
                                {step.spotData && <span class="overlay-chevron">›</span>}
                              </div>
                              <div class="overlay-bottom-bar">
                                <div class="overlay-meta-right">
                                  <span class="photo-credit-tag tiny-credit">{formatGridCredits(photoItems, step.imageCredit, 'grid-2')}</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        ) : layout === 'grid-3' && isMulti ? (
                          /* 3分割グリッドレイアウト（左大型1枚＋右サブ2枚、文字・タイトルは全体に1つだけ固定オーバーレイ） */
                          <div class="wide-photo-container photo-grid-wrapper">
                            <div class="photo-gallery-grid-3">
                              <div class="grid-3-main-cell">
                                <img src={getWideImageUrl(photoItems[0].image)} alt={step.title} class="grid-cell-img" loading="lazy" />
                              </div>
                              <div class="grid-3-sub-column">
                                {photoItems.slice(1, 3).map((photo) => (
                                  <div class="grid-3-sub-cell">
                                    <img src={getWideImageUrl(photo.image)} alt={step.title} class="grid-cell-img" loading="lazy" />
                                  </div>
                                ))}
                              </div>
                            </div>

                            <div class="wide-photo-overlay pointer-events-none">
                              <div class="overlay-title-row align-left">
                                <h4 class="overlay-heading single-line-heading">{step.title}</h4>
                                {step.spotData && <span class="overlay-chevron">›</span>}
                              </div>
                              <div class="overlay-bottom-bar">
                                <div class="overlay-meta-right">
                                  <span class="photo-credit-tag tiny-credit">{formatGridCredits(photoItems, step.imageCredit, 'grid-3')}</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        ) : isMulti ? (
                          /* 写真カルーセル（画像だけが横スワイプし、文字・タイトル・オーバーレイは固定） */
                          <div class="wide-photo-container spot-photo-slider-container">
                            <div class="spot-photo-only-track" tabindex="0" role="region" aria-label="写真一覧。左右の矢印キーで移動できます">
                              {photoItems.map((photo, pIdx) => (
                                <div class="spot-photo-only-slide">
                                  <img
                                    src={getWideImageUrl(photo.image)}
                                    alt={photo.caption || step.title}
                                    class="wide-photo-img"
                                    loading="lazy"
                                  />
                                </div>
                              ))}
                            </div>

                            <div class="wide-photo-overlay pointer-events-none">
                              <div class="overlay-title-row align-left">
                                <h4 class="overlay-heading single-line-heading">{step.title}</h4>
                                {step.spotData && <span class="overlay-chevron">›</span>}
                              </div>
                              <div class="overlay-bottom-bar">
                                <div class="overlay-meta-right">
                                  <span class="photo-credit-tag tiny-credit">{formatCredit(photoItems[0]?.imageCredit || step.imageCredit)}</span>
                                </div>
                              </div>
                            </div>
                          </div>
                        ) : (
                          /* 単一写真（従来の1枚写真・場所名は左寄せ、クレジットは最も右下） */
                          <div class="wide-photo-container">
                            {photoItems[0] && (
                              <img
                                src={getWideImageUrl(photoItems[0].image, step.spotData?.heroImage)}
                                alt={step.title}
                                class="wide-photo-img"
                                loading="lazy"
                              />
                            )}
                            <div class="wide-photo-overlay">
                              <div class="overlay-title-row align-left">
                                <h4 class="overlay-heading single-line-heading">{step.title}</h4>
                                {step.spotData && <span class="overlay-chevron">›</span>}
                              </div>
                              <div class="overlay-bottom-bar">
                                <div class="overlay-meta-right">
                                  {((photoItems[0]?.imageCredit || step.imageCredit) || step.isImageSample) && (
                                    <span class="photo-credit-tag tiny-credit">{formatCredit(photoItems[0]?.imageCredit || step.imageCredit, step.isImageSample)}</span>
                                  )}
                                </div>
                              </div>
                            </div>
                          </div>
                        )}

                        <div class="wide-spot-body">
                          {step.points && step.points.length > 0 && (
                            <ul class="wide-points-list">
                              {step.points.map((pt) => (
                                <li>{pt}</li>
                              ))}
                            </ul>
                          )}

                          {step.amenities && step.amenities.length > 0 && (
                            <p class="wide-amenities-line">
                              {step.amenities.map((am) => am.label).join(' · ')}
                            </p>
                          )}

                          {resolveHotelBookingUrl(step) && (
                            <a
                              href={resolveHotelBookingUrl(step)!.url}
                              target="_blank"
                              rel="noopener sponsored"
                              class="wide-hotel-cta"
                            >
                              <span>{resolveHotelBookingUrl(step)!.label}</span>
                              <span class="cta-arrow">→</span>
                            </a>
                          )}
                        </div>
                      </div>
                    );
                  })()}
                </div>
              </div>

              {transitInfo && (
                <div class="transit-vector-block" aria-label="次のスポットへの移動">
                  <div class="transit-vector-axis" aria-hidden="true">
                    <span class="vector-origin-dot"></span>
                    <span class="vector-stem-line"></span>
                    <svg class="vector-arrow-head" viewBox="0 0 12 12" fill="none">
                      <path
                        d="M2.5 4.5L6 8L9.5 4.5"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </div>

                  <div class="transit-vector-content">
                    <div class="transit-primary-row">
                      <span class="transit-method-title">{transitInfo.method}</span>
                      {transitInfo.route && (
                        <span class="transit-route-flow">{transitInfo.route}</span>
                      )}
                    </div>

                    {transitInfo.specs && transitInfo.specs.length > 0 && (
                      <ul class="transit-specs-list">
                        {transitInfo.specs.map((spec) => (
                          <li>{spec}</li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ))}

  {allModalSpots.map((spot) => (
    <dialog class="tavinavi-spot-dialog" id={`dialog-${spot.id}`}>
      <SpotCard spot={spot} mode="modal-view" />
    </dialog>
  ))}
</div>

<script>
  function initWideTimelineInteractions() {
    document.querySelectorAll('.spot-photo-only-track, .peeking-carousel-track').forEach((element) => {
      const track = element as HTMLElement;
      if (track.dataset.keyboardReady) return;
      track.dataset.keyboardReady = 'true';
      track.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        const slide = track.firstElementChild as HTMLElement | null;
        const distance = slide?.offsetWidth || track.clientWidth;
        track.scrollBy({ left: (event.key === 'ArrowRight' ? 1 : -1) * distance, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      });
    });
    // 1. スポット全画面ダイアログの開閉
    document.querySelectorAll('[data-open-spot]').forEach((card) => {
      card.addEventListener('click', () => {
        const spotId = card.getAttribute('data-open-spot');
        if (!spotId) return;
        const dialog = document.getElementById(`dialog-${spotId}`) as HTMLDialogElement | null;
        if (dialog) {
          dialog.showModal();
          document.body.style.overflow = 'hidden';
        }
      });
      card.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          (card as HTMLElement).click();
        }
      });
    });

    // 閉じるボタン
    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const dialog = btn.closest('dialog') as HTMLDialogElement | null;
        if (dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });
    });

    // ダイアログ外側クリックで閉じる
    document.querySelectorAll('.tavinavi-spot-dialog').forEach((dialog) => {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          (dialog as HTMLDialogElement).close();
          document.body.style.overflow = '';
        }
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    });

    // スライド移動ヘルパー
    function scrollToSlide(track: HTMLElement, slideIdx: number) {
      const slides = track.querySelectorAll('.carousel-slide-item');
      if (!slides.length) return;
      const targetIdx = Math.max(0, Math.min(slides.length - 1, slideIdx));
      const slideLeft = (slides[targetIdx] as HTMLElement).offsetLeft;
      track.scrollTo({ left: slideLeft, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
    }

    // 2. カルーセルのタブクリック連動
    document.querySelectorAll('.carousel-section-header').forEach((header) => {
      const track = header.closest('.flow-step-item')?.querySelector('.peeking-carousel-track') as HTMLElement | null;
      if (!track) return;

      header.querySelectorAll('.swipe-tab-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slideIdx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
          scrollToSlide(track, slideIdx);
        });
      });
    });

    // 4. 写真のみカルーセル（画像だけ横スワイプ、文字は固定、5秒自動ローテーション）
    document.querySelectorAll('.spot-photo-slider-container').forEach((container) => {
      const track = container.querySelector('.spot-photo-only-track') as HTMLElement | null;
      if (!track) return;

      const slides = track.querySelectorAll('.spot-photo-only-slide');
      const total = slides.length;
      if (total <= 1) return;

      let currentIdx = 0;
      let timer: number | null = null;
      let isInteracting = false;
      let resumeTimer: number | null = null;

      const pauseAuto = () => {
        isInteracting = true;
        if (resumeTimer) clearTimeout(resumeTimer);
        resumeTimer = window.setTimeout(() => {
          isInteracting = false;
        }, 7000);
      };

      // 5秒ごとの自動スライド切り替え
      const startAutoPlay = () => {
        if (timer) clearInterval(timer);
        timer = window.setInterval(() => {
          if (isInteracting) return;
          const slideWidth = track.clientWidth;
          if (slideWidth <= 0) return;
          currentIdx = (currentIdx + 1) % total;
          track.scrollTo({
            left: currentIdx * slideWidth,
            behavior: 'smooth',
          });
        }, 5000);
      };

      // タッチ・ドラッグによる手動スワイプ実装（最後の写真からさらにスワイプで最初へループ）
      let startX = 0;
      let startScrollLeft = 0;
      let isDragging = false;
      let totalWalk = 0;

      track.addEventListener('touchstart', (e: TouchEvent) => {
        pauseAuto();
        isDragging = true;
        startX = e.touches[0].pageX;
        startScrollLeft = track.scrollLeft;
        totalWalk = 0;
      }, { passive: true });

      track.addEventListener('touchmove', (e: TouchEvent) => {
        if (!isDragging) return;
        const x = e.touches[0].pageX;
        totalWalk = x - startX;
        track.scrollLeft = startScrollLeft - totalWalk;
      }, { passive: true });

      track.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        const slideWidth = track.clientWidth;
        if (slideWidth > 0) {
          const maxScroll = (total - 1) * slideWidth;
          const currentScroll = track.scrollLeft;

          // 最後のスライドにいる状態でわずかでも左スワイプ（totalWalk < -10）した場合、最初（0）へループ
          if (startScrollLeft >= maxScroll - 15 && totalWalk < -10) {
            currentIdx = 0;
            track.scrollTo({
              left: 0,
              behavior: 'smooth',
            });
          }
          // 最初のスライドにいる状態でわずかでも右スワイプ（totalWalk > 10）した場合、最後へループ
          else if (startScrollLeft <= 15 && totalWalk > 10) {
            currentIdx = total - 1;
            track.scrollTo({
              left: (total - 1) * slideWidth,
              behavior: 'smooth',
            });
          }
          // 通常スワイプ時：少しのフリック（|totalWalk| > 20）でも確実に前後の写真へめくる
          else if (totalWalk < -20 && currentIdx < total - 1) {
            currentIdx++;
            track.scrollTo({
              left: currentIdx * slideWidth,
              behavior: 'smooth',
            });
          } else if (totalWalk > 20 && currentIdx > 0) {
            currentIdx--;
            track.scrollTo({
              left: currentIdx * slideWidth,
              behavior: 'smooth',
            });
          }
          // 通常の最寄りスライドスナップ
          else {
            currentIdx = Math.max(0, Math.min(total - 1, Math.round(currentScroll / slideWidth)));
            track.scrollTo({
              left: currentIdx * slideWidth,
              behavior: 'smooth',
            });
          }
        }
      }, { passive: true });

      track.addEventListener('mousedown', pauseAuto, { passive: true });

      // 自動再生を行わず、読者が操作するまで写真を固定する。
    });
    // 5. 並列場所カルーセル（横スワイプ操作 ＋ 10秒自動スクロール、ユーザー操作で自動スクロール完全無効化）
    document.querySelectorAll('.peeking-carousel-track').forEach((track) => {
      const htmlTrack = track as HTMLElement;
      let startX = 0;
      let startScrollLeft = 0;
      let isDragging = false;
      let totalWalk = 0;
      let autoScrollDisabled = false;
      let autoTimer: number | null = null;

      const slides = htmlTrack.querySelectorAll('.carousel-slide-item');
      const totalSlides = slides.length;
      if (totalSlides <= 1) return;

      // 10秒ごとの自動スクロール
      const startAuto = () => {
        if (autoTimer) clearInterval(autoTimer);
        autoTimer = window.setInterval(() => {
          if (autoScrollDisabled) {
            if (autoTimer) clearInterval(autoTimer);
            return;
          }
          const itemWidth = (slides[0] as HTMLElement).offsetWidth || htmlTrack.clientWidth * 0.92;
          const currentIdx = Math.round(htmlTrack.scrollLeft / itemWidth);
          const nextIdx = (currentIdx + 1) % totalSlides;
          const targetSlide = slides[nextIdx] as HTMLElement;
          if (targetSlide) {
            htmlTrack.scrollTo({
              left: targetSlide.offsetLeft,
              behavior: 'smooth',
            });
          }
        }, 10000);
      };

      // ユーザーが自発的にスクロール・タッチ・タブクリックした場合は自動スクロールを完全無効化
      const disableAuto = () => {
        autoScrollDisabled = true;
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = null;
        }
      };

      htmlTrack.addEventListener('touchstart', (e: TouchEvent) => {
        disableAuto();
        isDragging = true;
        startX = e.touches[0].pageX;
        startScrollLeft = htmlTrack.scrollLeft;
        totalWalk = 0;
      }, { passive: true });

      htmlTrack.addEventListener('touchmove', (e: TouchEvent) => {
        if (!isDragging) return;
        const x = e.touches[0].pageX;
        totalWalk = x - startX;
        htmlTrack.scrollLeft = startScrollLeft - totalWalk;
      }, { passive: true });

      htmlTrack.addEventListener('touchend', () => {
        if (!isDragging) return;
        isDragging = false;
        const itemWidth = (slides[0] as HTMLElement).offsetWidth || htmlTrack.clientWidth * 0.92;
        const currentIdx = Math.max(0, Math.min(totalSlides - 1, Math.round(htmlTrack.scrollLeft / itemWidth)));
        const targetSlide = slides[currentIdx] as HTMLElement;
        if (targetSlide) {
          htmlTrack.scrollTo({
            left: targetSlide.offsetLeft,
            behavior: 'smooth',
          });
        }
      }, { passive: true });

      htmlTrack.addEventListener('mousedown', disableAuto, { passive: true });

      // 上部のタブボタンをクリックした際もユーザー操作と判定して自動スクロールを停止
      const parentStep = htmlTrack.closest('.flow-step-item');
      if (parentStep) {
        parentStep.querySelectorAll('.swipe-tab-btn').forEach((btn) => {
          btn.addEventListener('click', disableAuto, { passive: true });
        });
      }

      // 自動再生を行わず、読者が操作するまで候補を固定する。

      htmlTrack.addEventListener('scroll', () => {
        const slides = htmlTrack.querySelectorAll('.carousel-slide-item');
        if (!slides.length) return;
        const itemWidth = (slides[0] as HTMLElement).offsetWidth || htmlTrack.clientWidth * 0.92;
        const scrollLeft = htmlTrack.scrollLeft;
        const activeIdx = Math.min(
          slides.length - 1,
          Math.max(0, Math.round(scrollLeft / itemWidth))
        );

        slides.forEach((slide, idx) => {
          slide.classList.toggle('is-active-slide', idx === activeIdx);
        });

        const parent = htmlTrack.closest('.flow-step-item');
        if (parent) {
          const tabScroll = parent.querySelector('.swipe-tab-scroll') as HTMLElement | null;
          parent.querySelectorAll('.swipe-tab-btn').forEach((btn, idx) => {
            const isActive = idx === activeIdx;
            btn.classList.toggle('is-active', isActive);
            btn.setAttribute('aria-pressed', String(isActive));
            if (isActive && tabScroll) {
              const btnEl = btn as HTMLElement;
              const targetScroll = btnEl.offsetLeft - tabScroll.clientWidth / 2 + btnEl.clientWidth / 2;
              tabScroll.scrollTo({ left: Math.max(0, targetScroll), behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
            }
          });

          parent.querySelectorAll('.indicator-dot').forEach((dot, idx) => {
            dot.classList.toggle('is-active', idx === activeIdx);
          });
        }
      }, { passive: true });
    });
  }

  initWideTimelineInteractions();
  document.addEventListener('astro:page-load', initWideTimelineInteractions);
</script>

<style>
  /* 全体コンテナ */
