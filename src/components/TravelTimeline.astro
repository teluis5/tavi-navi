---
import SpotCard, { type SpotData, type SpotAmenity } from './SpotCard.astro';

export interface TimelineHotelData {
  rating: string;         // e.g. "4.4"
  reviewCount: string;    // e.g. "2,150"
  rakutenUrl: string;     // アフィリエイトURL
  priceText?: string;     // e.g. "2名1室 税込14,800円〜"
  features?: string[];    // e.g. ["オーシャンビュー", "露天風呂"]
}

export interface TimelineStep {
  id?: string;
  time: string;           // e.g. "08:26" or "12:00 - 13:15"
  title: string;          // e.g. "熱海銀座 おさかな食堂"
  icon?: string;          // e.g. "📍", "🍴", "🚶", "🚌", "🏨"
  categoryLabel?: string; // e.g. "ランチ", "絶景", "宿泊"
  image?: string;         // サムネイル画像URL
  desc?: string;          // 説明文
  points?: string[];      // 箇条書きポイント（最大2〜3行）
  amenities?: SpotAmenity[]; // ピクトグラムバッジ（🚻 🪑 👶 ☔ ♿）
  transit?: string;       // 移動情報（e.g. "徒歩 約8分"）
  transitBadge?: string;  // e.g. "湯〜遊〜バス 12分"
  
  // 横スワイプ候補（カルーセル）機能
  alternativeLabel?: string; // e.g. "🍣 海鮮", "🥩 お肉", "🍜 麺"
  alternatives?: TimelineStep[]; // スワイプで切り替え可能な代替候補たち

  // 全画面スポットカードポップアップ用
  spotData?: SpotData;

  // 宿アフィリエイト用
  isHotel?: boolean;
  hotelData?: TimelineHotelData;
}

export interface TimelineDay {
  dayNumber?: number;
  title: string;
  subtitle?: string;
  steps: TimelineStep[];
}

interface Props {
  dayTitle?: string;
  steps?: TimelineStep[];
  days?: TimelineDay[];
}

const { dayTitle, steps, days: rawDays } = Astro.props;

// 正規化
const timelineDays: TimelineDay[] = rawDays || (steps ? [{
  dayNumber: 1,
  title: dayTitle || '',
  steps: steps
}] : []);

// 全ステップからモーダル用のspotDataを収集
const allModalSpots: SpotData[] = [];
timelineDays.forEach(day => {
  day.steps.forEach(step => {
    if (step.spotData) allModalSpots.push(step.spotData);
    if (step.alternatives) {
      step.alternatives.forEach(alt => {
        if (alt.spotData) allModalSpots.push(alt.spotData);
      });
    }
  });
});
---

<div class="tavinavi-timeline-wrapper">
  {timelineDays.map((day) => (
    <div class="travel-timeline">
      {day.title && (
        <div class="timeline-day-header">
          <span class="timeline-day-badge">
            {day.dayNumber ? `DAY ${day.dayNumber}` : 'DAY'}
          </span>
          <div class="timeline-day-title-group">
            <h3 class="timeline-day-title">{day.title}</h3>
            {day.subtitle && <p class="timeline-day-subtitle">{day.subtitle}</p>}
          </div>
        </div>
      )}

      <div class="timeline-steps">
        {day.steps && day.steps.map((step, index) => {
          const isLast = index === day.steps.length - 1;
          const hasAlternatives = step.alternatives && step.alternatives.length > 0;
          const allOptions = hasAlternatives ? [step, ...step.alternatives!] : [step];

          return (
            <div class={`timeline-step ${isLast ? 'is-last' : ''} ${step.isHotel ? 'is-hotel-step' : ''}`}>
              {/* 左側タイムライン軸（時間とアイコン） */}
              <div class="timeline-left">
                <span class="timeline-time">{step.time}</span>
                <div class={`timeline-node ${step.isHotel ? 'hotel-node' : ''}`}>
                  <span class="timeline-node-icon">{step.icon || (step.isHotel ? '🏨' : '📍')}</span>
                </div>
                {!isLast && <div class="timeline-line" />}
              </div>

              {/* 右側コンテンツ（横スワイプカルーセル対応） */}
              <div class="timeline-content">
                {hasAlternatives ? (
                  <div class="swipe-container-outer">
                    {/* スワイプ案内＆カテゴリピル */}
                    <div class="swipe-header-bar">
                      <span class="swipe-hint-badge">👉 横スワイプで変更可</span>
                      <div class="swipe-tabs">
                        {allOptions.map((opt, optIdx) => (
                          <span class={`swipe-tab-pill ${optIdx === 0 ? 'active' : ''}`} data-tab-for={`step-${index}-${optIdx}`}>
                            {opt.alternativeLabel || `候補 ${optIdx + 1}`}
                          </span>
                        ))}
                      </div>
                    </div>

                    {/* CSS Scroll-Snap カルーセル */}
                    <div class="swipe-carousel-track" data-track-id={`track-${index}`}>
                      {allOptions.map((opt, optIdx) => (
                        <div class="swipe-card-item" id={`step-${index}-${optIdx}`}>
                          {/* コンパクトカード本体 */}
                          <div class="compact-spot-card">
                            {opt.image && (
                              <div
                                class="compact-thumb-wrapper"
                                data-open-spot={opt.spotData ? opt.spotData.id : undefined}
                              >
                                <img src={opt.image} alt={opt.title} class="compact-thumb-img" loading="lazy" />
                                {opt.spotData && <span class="thumb-zoom-badge">🔍 詳細</span>}
                              </div>
                            )}

                            <div class="compact-info-wrapper">
                              <div class="compact-title-row">
                                <h4 class="compact-title">{opt.title}</h4>
                                {opt.categoryLabel && (
                                  <span class="compact-category-tag">{opt.categoryLabel}</span>
                                )}
                              </div>

                              {opt.desc && <p class="compact-desc">{opt.desc}</p>}

                              {opt.points && opt.points.length > 0 && (
                                <ul class="compact-points">
                                  {opt.points.map((pt) => (
                                    <li>{pt}</li>
                                  ))}
                                </ul>
                              )}

                              {opt.amenities && opt.amenities.length > 0 && (
                                <div class="compact-amenity-bar">
                                  {opt.amenities.map((am) => (
                                    <span class={`compact-amenity-chip ${am.type || 'info'}`}>
                                      {am.icon} {am.label}
                                    </span>
                                  ))}
                                </div>
                              )}
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>

                    {/* スワイプインジケーター（ドット） */}
                    <div class="swipe-dots-bar">
                      {allOptions.map((_, dotIdx) => (
                        <span class={`swipe-dot ${dotIdx === 0 ? 'active' : ''}`} data-dot-for={dotIdx}></span>
                      ))}
                    </div>
                  </div>
                ) : step.isHotel ? (
                  {/* 宿アフィリエイト専用カード */}
                  <div class="timeline-hotel-card">
                    <div class="hotel-header-badge">
                      <span>🏨</span>
                      <span>今夜の厳選宿・温泉ステイ</span>
                    </div>

                    <div class="hotel-body-grid">
                      {step.image && (
                        <img src={step.image} alt={step.title} class="hotel-thumb" loading="lazy" />
                      )}
                      <div class="hotel-info">
                        <h4 class="hotel-title">{step.title}</h4>
                        {step.hotelData && (
                          <div class="hotel-rating-row">
                            <span class="hotel-stars">★★★★☆</span>
                            <span class="hotel-score">{step.hotelData.rating}</span>
                            <span class="hotel-reviews">({step.hotelData.reviewCount}件)</span>
                          </div>
                        )}
                        {step.points && (
                          <ul class="hotel-points">
                            {step.points.map(pt => <li>{pt}</li>)}
                          </ul>
                        )}
                      </div>
                    </div>

                    {step.hotelData?.rakutenUrl && (
                      <div class="hotel-cta-row">
                        <a
                          href={step.hotelData.rakutenUrl}
                          target="_blank"
                          rel="noopener sponsored"
                          class="rakuten-booking-btn"
                        >
                          <span class="rakuten-icon">🔴</span>
                          <span class="rakuten-btn-text">楽天トラベルで今夜の空室を見る ▶</span>
                        </a>
                      </div>
                    )}
                  </div>
                ) : (
                  {/* 通常の単独コンパクトスポットカード */}
                  <div class="compact-spot-card">
                    {step.image && (
                      <div
                        class="compact-thumb-wrapper"
                        data-open-spot={step.spotData ? step.spotData.id : undefined}
                      >
                        <img src={step.image} alt={step.title} class="compact-thumb-img" loading="lazy" />
                        {step.spotData && <span class="thumb-zoom-badge">🔍 詳細</span>}
                      </div>
                    )}

                    <div class="compact-info-wrapper">
                      <div class="compact-title-row">
                        <h4 class="compact-title">{step.title}</h4>
                        {step.categoryLabel && (
                          <span class="compact-category-tag">{step.categoryLabel}</span>
                        )}
                      </div>

                      {step.desc && <p class="compact-desc">{step.desc}</p>}

                      {step.points && step.points.length > 0 && (
                        <ul class="compact-points">
                          {step.points.map((pt) => (
                            <li>{pt}</li>
                          ))}
                        </ul>
                      )}

                      {step.amenities && step.amenities.length > 0 && (
                        <div class="compact-amenity-bar">
                          {step.amenities.map((am) => (
                            <span class={`compact-amenity-chip ${am.type || 'info'}`}>
                              {am.icon} {am.label}
                            </span>
                          ))}
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {/* 移動トランジット線＆バッジ */}
                {(step.transit || step.transitBadge) && !isLast && (
                  <div class="timeline-transit-badge">
                    <span class="transit-arrow">↓</span>
                    <span class="transit-text">{step.transit || step.transitBadge}</span>
                  </div>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}

  {/* 全画面スポットカード用モーダルダイアログ群 */}
  {allModalSpots.map(spot => (
    <dialog class="tavinavi-spot-dialog" id={`dialog-${spot.id}`}>
      <SpotCard spot={spot} mode="modal-view" />
    </dialog>
  ))}
</div>

<script>
  // スポット全画面モーダル開閉ロジック
  function initSpotModals() {
    // 開くボタン
    document.querySelectorAll('[data-open-spot]').forEach(el => {
      el.addEventListener('click', () => {
        const spotId = el.getAttribute('data-open-spot');
        if (!spotId) return;
        const dialog = document.getElementById(`dialog-${spotId}`) as HTMLDialogElement | null;
        if (dialog) {
          dialog.showModal();
          document.body.style.overflow = 'hidden'; // 背景スクロール停止
        }
      });
    });

    // 閉じるボタン
    document.querySelectorAll('[data-close-modal]').forEach(btn => {
      btn.addEventListener('click', () => {
        const dialog = btn.closest('dialog') as HTMLDialogElement | null;
        if (dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });
    });

    // ダイアログ外側クリックで閉じる
    document.querySelectorAll('.tavinavi-spot-dialog').forEach(dialog => {
      dialog.addEventListener('click', (e) => {
        const rect = dialog.getBoundingClientRect();
        const isInDialog = (
          rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
          rect.left <= e.clientX && e.clientX <= rect.left + rect.width
        );
        // 背景クリック時
        if (e.target === dialog) {
          (dialog as HTMLDialogElement).close();
          document.body.style.overflow = '';
        }
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    });

    // カルーセルのスクロール監視でインジケータードットを連動
    document.querySelectorAll('.swipe-carousel-track').forEach(track => {
      track.addEventListener('scroll', () => {
        const itemWidth = track.clientWidth;
        const scrollLeft = track.scrollLeft;
        const activeIndex = Math.round(scrollLeft / itemWidth);
        const container = track.closest('.swipe-container-outer');
        if (container) {
          // ドット更新
          container.querySelectorAll('.swipe-dot').forEach((dot, idx) => {
            dot.classList.toggle('active', idx === activeIndex);
          });
          // タブピル更新
          container.querySelectorAll('.swipe-tab-pill').forEach((pill, idx) => {
            pill.classList.toggle('active', idx === activeIndex);
          });
        }
      }, { passive: true });
    });
  }

  // 初回 & Astro View Transitions 対応
  initSpotModals();
  document.addEventListener('astro:page-load', initSpotModals);
</script>

<style>
