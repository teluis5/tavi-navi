    color: #b45309;
    font-size: 0.72rem;
    font-weight: 800;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    margin-bottom: 0.5rem;
  }

  .hotel-body-grid {
    display: flex;
    gap: 0.75rem;
  }

  .hotel-thumb {
    width: 80px;
    height: 80px;
    border-radius: 8px;
    object-fit: cover;
    flex-shrink: 0;
  }

  .hotel-info {
