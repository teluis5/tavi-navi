    width: 100%;
    margin: 1rem 0 3rem;
    box-sizing: border-box;
    color: #111827;
  }

  .timeline-day-block {
    margin-bottom: 3rem;
  }

  /* DAY見出し */
  .day-header-banner {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding-bottom: 0.7rem;
    margin-bottom: 1.35rem;
    border-bottom: 2px solid #111827;
  }

  .day-number-pill {
    background: #111827;
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    padding: 0.22rem 0.55rem;
    border-radius: 4px;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .day-title-text {
    font-size: 0.95rem;
    font-weight: 800;
    color: #111827;
    margin: 0;
    line-height: 1.35;
  }

  .step-flow-list {
    display: flex;
    flex-direction: column;
  }

  .flow-step-item {
    position: relative;
  }

  /* 場所（スポット）セクションの淡色背景（PCは角丸カード、スマホは横画面いっぱいのフルブリード） */
  .step-place-surface {
    background: #e3e7ed;
    border: none;
    border-radius: 12px;
    padding: 1.15rem 1.1rem;
    box-sizing: border-box;
    width: 100%;
  }

  @media (max-width: 800px) {
    .step-place-surface {
      margin-left: -1rem;
      margin-right: -1rem;
      width: calc(100% + 2rem);
      border-radius: 0;
      padding: 1.15rem 1rem;
    }
  }

  /* .prose からの見出しスタイル干渉（下線・左縦線・下青バー::after）を強制リセット */
  :global(.prose) .step-place-surface h3,
  :global(.prose) .step-place-surface h4,
  :global(.prose) .day-header-banner h3 {
    border: none !important;
    background: transparent !important;
    padding: 0 !important;
    margin: 0 !important;
    position: static !important;
  }

  :global(.prose) .step-place-surface h3::after,
  :global(.prose) .step-place-surface h4::after,
  :global(.prose) .day-header-banner h3::after {
    content: none !important;
    display: none !important;
  }

  /* 体験アクション見出し（写真の直上に配置） */
  .step-lead-heading {
    margin-bottom: 0.45rem;
  }

  .step-lead-text {
    font-size: 1.05rem;
    font-weight: 800;
    color: #111827;
    margin: 0;
    line-height: 1.38;
    letter-spacing: -0.015em;
  }

  /* カルーセル専用ヘッダー（見出し ＋ 横スクロールジャンルタブ） */
  .carousel-section-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 0.55rem;
  }

  .swipe-tab-scroll {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    overflow-x: auto;
    white-space: nowrap;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .swipe-tab-scroll::-webkit-scrollbar {
    display: none;
  }

  .swipe-tab-btn {
    background: #ffffff;
    border: none;
    border-radius: 9999px;
    padding: 0.24rem 0.68rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: #4b5563;
    cursor: pointer;
    flex-shrink: 0;
    line-height: 1.3;
    transition: all 0.15s;
  }

  .swipe-tab-btn.is-active {
