---
import SpotCard, { type SpotData, type SpotAmenity } from './SpotCard.astro';

export interface TimelineHotelData {
  rating: string;         // e.g. "4.4"
  reviewCount: string;    // e.g. "2,150"
  rakutenUrl: string;     // アフィリエイトURL
  priceText?: string;     // e.g. "2名1室 税込14,800円〜"
  features?: string[];
}

export interface TimelineStep {
  id?: string;
  duration?: string;      // e.g. "目安 75分", "ランチ 60分", "宿泊"
  time?: string;          // 後方互換用
  title: string;          // e.g. "熱海サンビーチ & 親水公園"
  icon?: string;
  categoryLabel?: string; // e.g. "絶景・散策", "ランチ", "宿泊"
  image?: string;         // サムネイル画像URL
  desc?: string;
  points?: string[];      // 箇条書きポイント（最大2〜3行）
  amenities?: SpotAmenity[]; // 設備情報
  transit?: string;       // 移動情報（e.g. "徒歩 8分（平坦・歩道あり）"）
  transitBadge?: string;
  
  // 横スワイプ候補（カルーセル）機能
  alternativeLabel?: string; // e.g. "魚：海鮮丼", "肉：静岡牛バーガー"
  alternatives?: TimelineStep[]; // スワイプで切り替え可能な代替候補たち

  // 全画面スポットカードポップアップ用
  spotData?: SpotData;

  // 宿アフィリエイト用
  isHotel?: boolean;
  hotelData?: TimelineHotelData;
}

export interface TimelineDay {
  dayNumber?: number;
  title: string;
  subtitle?: string;
  steps: TimelineStep[];
}

interface Props {
  dayTitle?: string;
  steps?: TimelineStep[];
  days?: TimelineDay[];
}

const { dayTitle, steps, days: rawDays } = Astro.props;

// 正規化
const timelineDays: TimelineDay[] = rawDays || (steps ? [{
  dayNumber: 1,
  title: dayTitle || '',
  steps: steps
}] : []);

// 全ステップからモーダル用のspotDataを収集
const allModalSpots: SpotData[] = [];
timelineDays.forEach(day => {
  day.steps.forEach(step => {
    if (step.spotData) allModalSpots.push(step.spotData);
    if (step.alternatives) {
      step.alternatives.forEach(alt => {
        if (alt.spotData) allModalSpots.push(alt.spotData);
      });
    }
  });
});

// 先頭の装飾絵文字を除去してミニマルに整えるヘルパー
function cleanText(text?: string): string {
  if (!text) return '';
  return text.replace(/^[\p{Emoji_Presentation}\p{Extended_Pictographic}\s]+/u, '').trim() || text;
}
---

<div class="tavinavi-timeline-editorial">
  {timelineDays.map((day) => (
    <div class="timeline-day-block">
      {day.title && (
        <div class="day-header-row">
          <span class="day-number-label">DAY {String(day.dayNumber || 1).padStart(2, '0')}</span>
          <h3 class="day-title-text">{day.title}</h3>
        </div>
      )}

      <div class="step-flow-list">
        {day.steps && day.steps.map((step, index) => {
          const isLast = index === day.steps.length - 1;
          const stepNum = String(index + 1).padStart(2, '0');
          const hasAlternatives = step.alternatives && step.alternatives.length > 0;
          const allOptions = hasAlternatives ? [step, ...step.alternatives!] : [step];

          return (
            <div class={`flow-step-item ${isLast ? 'is-last-step' : ''}`}>
              {hasAlternatives && (
                <div class="swipe-tab-bar" data-track-id={`track-${index}`}>
                  <span class="step-num-inline">{stepNum}</span>
                  <div class="swipe-tab-controls">
                    {allOptions.map((opt, optIdx) => (
                      <button
                        type="button"
                        class={`swipe-tab-btn ${optIdx === 0 ? 'is-active' : ''}`}
                        data-slide-index={optIdx}
                      >
                        {cleanText(opt.alternativeLabel) || `候補 ${optIdx + 1}`}
                      </button>
                    ))}
                  </div>
                </div>
              )}

              <div class="step-content-area">
                {hasAlternatives ? (
                  <div class="peeking-carousel-wrapper">
                    <div class="peeking-carousel-track" id={`track-${index}`}>
                      {allOptions.map((opt) => (
                        <div class="carousel-slide-item">
                          <div
                            class="editorial-spot-unit clickable-unit"
                            data-open-spot={opt.spotData?.id}
                            role={opt.spotData ? "button" : undefined}
                            tabindex={opt.spotData ? "0" : undefined}
                          >
                            <div class="spot-header-line">
                              <h4 class="spot-heading">{opt.title}</h4>
                              <div class="spot-meta-right">
                                {(opt.duration || opt.time) && (
                                  <span class="spot-duration-text">{opt.duration || opt.time}</span>
                                )}
                                {opt.spotData && <span class="open-chevron">›</span>}
                              </div>
                            </div>

                            <div class="spot-body-grid">
                              {opt.image && (
                                <div class="spot-thumb-box">
                                  <img src={opt.image} alt={opt.title} class="thumb-img" loading="lazy" />
                                </div>
                              )}

                              <div class="spot-details-col">
                                {opt.points && opt.points.length > 0 && (
                                  <ul class="spot-points-list">
                                    {opt.points.map((pt) => (
                                      <li>{pt}</li>
                                    ))}
                                  </ul>
                                )}

                                {opt.amenities && opt.amenities.length > 0 && (
                                  <p class="spot-amenities-text">
                                    {opt.amenities.map((am) => am.label).join(' · ')}
                                  </p>
                                )}
                              </div>
                            </div>
                          </div>
                        </div>
                      ))}
                    </div>

                    <div class="carousel-dots-row">
                      {allOptions.map((_, dotIdx) => (
                        <span class={`indicator-dot ${dotIdx === 0 ? 'is-active' : ''}`} data-dot-index={dotIdx}></span>
                      ))}
                    </div>
                  </div>
                ) : step.isHotel ? (
                  <div class="editorial-hotel-unit">
                    <div class="spot-header-line">
                      <div class="spot-title-left">
                        <span class="step-num">{stepNum}</span>
                        <h4 class="spot-heading">{step.title}</h4>
                      </div>
                      <div class="spot-meta-right">
                        <span class="spot-duration-text">{step.duration || step.categoryLabel || '宿泊'}</span>
                      </div>
                    </div>

                    <div class="spot-body-grid">
                      {step.image && (
                        <div class="spot-thumb-box">
                          <img src={step.image} alt={step.title} class="thumb-img" loading="lazy" />
                        </div>
                      )}

                      <div class="spot-details-col">
                        {step.hotelData && (
                          <div class="hotel-meta-line">
                            <span class="hotel-rating">★ {step.hotelData.rating}</span>
                            <span class="hotel-reviews">({step.hotelData.reviewCount}件)</span>
                            {step.hotelData.priceText && (
                              <span class="hotel-price">· {step.hotelData.priceText}</span>
                            )}
                          </div>
                        )}
                        {step.points && (
                          <ul class="spot-points-list">
                            {step.points.map((pt) => (
                              <li>{pt}</li>
                            ))}
                          </ul>
                        )}
                      </div>
                    </div>

                    {step.hotelData?.rakutenUrl && (
                      <a
                        href={step.hotelData.rakutenUrl}
                        target="_blank"
                        rel="noopener sponsored"
                        class="minimal-hotel-btn"
                      >
                        <span>楽天トラベルで空室・プランを見る</span>
                        <span class="btn-arrow">→</span>
                      </a>
                    )}
                  </div>
                ) : (
                  <div
                    class="editorial-spot-unit clickable-unit"
                    data-open-spot={step.spotData?.id}
                    role={step.spotData ? "button" : undefined}
                    tabindex={step.spotData ? "0" : undefined}
                  >
                    <div class="spot-header-line">
                      <div class="spot-title-left">
                        <span class="step-num">{stepNum}</span>
                        <h4 class="spot-heading">{step.title}</h4>
                      </div>
                      <div class="spot-meta-right">
                        {(step.duration || step.time) && (
                          <span class="spot-duration-text">{step.duration || step.time}</span>
                        )}
                        {step.spotData && <span class="open-chevron">›</span>}
                      </div>
                    </div>

                    <div class="spot-body-grid">
                      {step.image && (
                        <div class="spot-thumb-box">
                          <img src={step.image} alt={step.title} class="thumb-img" loading="lazy" />
                        </div>
                      )}

                      <div class="spot-details-col">
                        {step.points && step.points.length > 0 && (
                          <ul class="spot-points-list">
                            {step.points.map((pt) => (
                              <li>{pt}</li>
                            ))}
                          </ul>
                        )}

                        {step.amenities && step.amenities.length > 0 && (
                          <p class="spot-amenities-text">
                            {step.amenities.map((am) => am.label).join(' · ')}
                          </p>
                        )}
                      </div>
                    </div>
                  </div>
                )}
              </div>

              {(step.transit || step.transitBadge) && !isLast && (
                <div class="transit-divider-row">
                  <span class="transit-divider-text">{cleanText(step.transit || step.transitBadge)}</span>
                </div>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ))}

  {allModalSpots.map((spot) => (
    <dialog class="tavinavi-spot-dialog" id={`dialog-${spot.id}`}>
      <SpotCard spot={spot} mode="modal-view" />
    </dialog>
  ))}
</div>

<script>
  function initTimelineInteractions() {
    // 1. スポット全画面ダイアログの開閉
    document.querySelectorAll('[data-open-spot]').forEach((card) => {
      card.addEventListener('click', () => {
        const spotId = card.getAttribute('data-open-spot');
        if (!spotId) return;
        const dialog = document.getElementById(`dialog-${spotId}`) as HTMLDialogElement | null;
        if (dialog) {
          dialog.showModal();
          document.body.style.overflow = 'hidden';
        }
      });
      card.addEventListener('keydown', (e: any) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          (card as HTMLElement).click();
        }
      });
    });

    // 閉じるボタン
    document.querySelectorAll('[data-close-modal]').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const dialog = btn.closest('dialog') as HTMLDialogElement | null;
        if (dialog) {
          dialog.close();
          document.body.style.overflow = '';
        }
      });
    });

    // ダイアログ外側クリックで閉じる
    document.querySelectorAll('.tavinavi-spot-dialog').forEach((dialog) => {
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) {
          (dialog as HTMLDialogElement).close();
          document.body.style.overflow = '';
        }
      });
      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    });

    // 2. カルーセルのタブクリック連動
    document.querySelectorAll('.swipe-tab-bar').forEach((bar) => {
      const trackId = bar.getAttribute('data-track-id');
      const track = document.getElementById(trackId || '');
      if (!track) return;

      bar.querySelectorAll('.swipe-tab-btn').forEach((btn) => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const slideIdx = parseInt(btn.getAttribute('data-slide-index') || '0', 10);
          const slides = track.querySelectorAll('.carousel-slide-item');
          if (slides[slideIdx]) {
            const slideLeft = (slides[slideIdx] as HTMLElement).offsetLeft;
            track.scrollTo({ left: slideLeft, behavior: 'smooth' });
          }
        });
      });
    });

    // 3. カルーセルの横スクロール監視（タブ＆ドット同期）
    document.querySelectorAll('.peeking-carousel-track').forEach((track) => {
      track.addEventListener('scroll', () => {
        const itemWidth = track.clientWidth * 0.88;
        const scrollLeft = track.scrollLeft;
        const activeIdx = Math.round(scrollLeft / itemWidth);

        const parent = track.closest('.flow-step-item');
        if (parent) {
          parent.querySelectorAll('.swipe-tab-btn').forEach((btn, idx) => {
            btn.classList.toggle('is-active', idx === activeIdx);
          });
          parent.querySelectorAll('.indicator-dot').forEach((dot, idx) => {
            dot.classList.toggle('is-active', idx === activeIdx);
          });
        }
      }, { passive: true });
    });
  }

  initTimelineInteractions();
  document.addEventListener('astro:page-load', initTimelineInteractions);
</script>

<style>
  /* 全体コンテナ：モノトーン・エディトリアル調 */
  .tavinavi-timeline-editorial {
    width: 100%;
    margin: 1rem 0 2.5rem;
    box-sizing: border-box;
    color: #111827;
  }

  .timeline-day-block {
    margin-bottom: 2.5rem;
  }

  /* DAY見出し：ミニマルな黒ライン */
  .day-header-row {
    display: flex;
    align-items: baseline;
    gap: 0.65rem;
    padding-bottom: 0.6rem;
    margin-bottom: 1.25rem;
    border-bottom: 1.5px solid #111827;
  }

  .day-number-label {
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: #111827;
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .day-title-text {
    font-size: 0.95rem;
    font-weight: 700;
    color: #374151;
    margin: 0;
    line-height: 1.4;
  }

  /* ステップリスト */
  .step-flow-list {
    display: flex;
    flex-direction: column;
  }

  .flow-step-item {
    position: relative;
  }

  /* スワイプ候補用のアンダーラインタブバー */
  .swipe-tab-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
    border-bottom: 1px solid #f3f4f6;
  }

  .step-num-inline {
    font-size: 0.78rem;
    font-weight: 700;
    color: #9ca3af;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    padding-bottom: 0.4rem;
  }

  .swipe-tab-controls {
    display: flex;
    gap: 1.25rem;
  }

  .swipe-tab-btn {
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    padding: 0 0 0.4rem 0;
    font-size: 0.8rem;
    font-weight: 600;
    color: #9ca3af;
    cursor: pointer;
    transition: color 0.15s, border-color 0.15s;
  }

  .swipe-tab-btn.is-active {
    color: #111827;
    font-weight: 800;
    border-bottom-color: #111827;
  }

  /* スポット本体（枠線ゼロ・雑誌エディトリアル構成） */
  .editorial-spot-unit,
  .editorial-hotel-unit {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.25rem 0;
    width: 100%;
    box-sizing: border-box;
  }

  .clickable-unit {
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .clickable-unit:active {
    opacity: 0.75;
  }

  /* ① 上部：番号 ＋ タイトル ＆ 所要時間 */
  .spot-header-line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .spot-title-left {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    min-width: 0;
  }

  .step-num {
    font-size: 0.78rem;
    font-weight: 700;
    color: #9ca3af;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }

  .spot-heading {
    font-size: 1rem;
    font-weight: 800;
    color: #111827;
    margin: 0;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }

  .spot-meta-right {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    flex-shrink: 0;
  }

  .spot-duration-text {
    font-size: 0.75rem;
    font-weight: 500;
    color: #6b7280;
    font-variant-numeric: tabular-nums;
  }

  .open-chevron {
    font-size: 1rem;
    font-weight: 400;
    color: #9ca3af;
    line-height: 1;
  }

  /* ② 下部：左に画像（88px）、右に説明 */
  .spot-body-grid {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
  }

  .spot-thumb-box {
    width: 88px;
    height: 88px;
    flex-shrink: 0;
    border-radius: 6px;
    overflow: hidden;
    background: #f3f4f6;
  }

  .thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .spot-details-col {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .spot-points-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  .spot-points-list li {
    font-size: 0.8rem;
    color: #374151;
    line-height: 1.45;
    position: relative;
    padding-left: 0.65rem;
  }

  .spot-points-list li::before {
    content: "·";
    position: absolute;
    left: 0;
    color: #9ca3af;
    font-weight: 900;
  }

  /* 設備情報：色付きバッジを廃し1行のドット区切りテキストへ */
  .spot-amenities-text {
    margin: 0.1rem 0 0;
    font-size: 0.72rem;
    color: #6b7280;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  /* 横スワイプ カルーセル（枠線なしPeeking UI） */
  .peeking-carousel-wrapper {
    position: relative;
    width: 100%;
  }

  .peeking-carousel-track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .peeking-carousel-track::-webkit-scrollbar {
    display: none;
  }

  .carousel-slide-item {
    flex: 0 0 88%;
    width: 88%;
    scroll-snap-align: start;
    box-sizing: border-box;
    padding-right: 0.75rem;
    border-right: 1px solid #f3f4f6;
  }

  .carousel-slide-item:last-child {
    border-right: none;
    padding-right: 0;
  }

  /* カルーセルインジケーター（極小モノトーン） */
  .carousel-dots-row {
    display: flex;
    justify-content: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .indicator-dot {
    width: 5px;
    height: 5px;
    border-radius: 9999px;
    background: #e5e7eb;
    transition: all 0.2s;
  }

  .indicator-dot.is-active {
    width: 14px;
    background: #111827;
  }

  /* 宿セクション：黄色枠や赤グラデを廃止しモノトーン統一 */
  .hotel-meta-line {
    display: flex;
    align-items: baseline;
    gap: 0.3rem;
    font-size: 0.76rem;
    margin-bottom: 0.1rem;
  }

  .hotel-rating {
    font-weight: 800;
    color: #111827;
  }

  .hotel-reviews,
  .hotel-price {
    color: #6b7280;
  }

  .minimal-hotel-btn {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #111827;
    color: #ffffff;
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.65rem 1rem;
    border-radius: 6px;
    text-decoration: none;
    margin-top: 0.35rem;
    letter-spacing: 0.02em;
    transition: opacity 0.15s;
  }

  .minimal-hotel-btn:hover {
    opacity: 0.88;
  }

  .minimal-hotel-btn:active {
    opacity: 0.75;
  }

  .btn-arrow {
    font-size: 0.9rem;
    font-weight: 400;
  }

  /* 移動手段（トランジット）：極細水平ライン＋中央テキスト */
  .transit-divider-row {
    display: flex;
    align-items: center;
    margin: 1.25rem 0;
    color: #6b7280;
  }

  .transit-divider-row::before,
  .transit-divider-row::after {
    content: "";
    flex: 1;
    height: 1px;
    background: #e5e7eb;
  }

  .transit-divider-text {
    font-size: 0.72rem;
    font-weight: 500;
    color: #6b7280;
    padding: 0 0.85rem;
    letter-spacing: 0.03em;
    white-space: nowrap;
  }

  /* 全画面スポットモーダルダイアログ */
  .tavinavi-spot-dialog {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    width: 100vw;
    height: 100dvh;
    max-width: 100vw;
    max-height: 100dvh;
    overflow: hidden;
  }

  .tavinavi-spot-dialog::backdrop {
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(8px);
  }

  .tavinavi-spot-dialog[open] {
    animation: dialogSlideUp 0.25s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes dialogSlideUp {
    from {
      opacity: 0;
      transform: translateY(24px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media (min-width: 641px) {
    .carousel-slide-item {
      flex: 0 0 80%;
      width: 80%;
    }
  }
</style>
