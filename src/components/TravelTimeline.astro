    line-height: 1.2;
  }

  .timeline-node {
    width: 30px;
    height: 30px;
    border-radius: 9999px;
    background: #f8fafc;
    border: 2px solid var(--color-primary, #0ea5e9);
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }

  .timeline-node.hotel-node {
    border-color: #f59e0b;
    background: #fffbeb;
  }

  .timeline-node-icon {
    font-size: 0.85rem;
    line-height: 1;
  }

  .timeline-line {
    position: absolute;
    top: 48px;
    bottom: -6px;
    width: 2px;
    background: #e5e7eb;
    z-index: 1;
  }

  /* 右側コンテンツ */
  .timeline-content {
    flex: 1;
    min-width: 0;
    padding-top: 0.1rem;
  }

  /* コンパクトスポットカード（縦幅圧縮） */
