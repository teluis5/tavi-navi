---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../utils/slug';

export interface Props {
  pref?: string;
  currentSlug?: string;
  limit?: number;
  courseSlugs?: string[];
  title?: string;
}

const {
  pref,
  currentSlug = '',
  limit = 3,
  courseSlugs,
  title = '別のモデルコースを見る',
} = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && !data.draft;
});

let matchedArticles: { article: CollectionEntry<'articles'>; url: string; slug: string }[] = [];

if (courseSlugs && courseSlugs.length > 0) {
  // 指定されたスラッグリストに一致するものを順序通りに抽出
  for (const slugQuery of courseSlugs) {
    const cleanQuery = slugQuery.replace(/^\//, '').replace(/\/$/, '').split('/').pop() || slugQuery;
    const found = allArticles.find((art) => {
      const artSlug = getArticleSlug(art.id, art.data.pref);
      return art.id === cleanQuery || artSlug === cleanQuery || art.id.includes(cleanQuery);
    });
    if (found) {
      const slug = getArticleSlug(found.id, found.data.pref);
      const url = `/${found.data.pref}/${slug}/`;
      if (!currentSlug || !url.includes(currentSlug)) {
        matchedArticles.push({ article: found, url, slug });
      }
    }
  }
} else {
  // 都道府県またはモデルコースカテゴリから自動抽出
  const filtered = allArticles.filter((art) => {
    const slug = getArticleSlug(art.id, art.data.pref);
    const url = `/${art.data.pref}/${slug}/`;
    if (currentSlug && (url.includes(currentSlug) || currentSlug.includes(slug))) {
      return false;
    }
    if (pref && art.data.pref === pref) {
      return true;
    }
    return art.data.category === 'モデルコース';
  });

  // 同じ都道府県のものを優先し、最大件数まで取得
  matchedArticles = filtered.slice(0, limit).map((art) => {
    const slug = getArticleSlug(art.id, art.data.pref);
    return {
      article: art,
      url: `/${art.data.pref}/${slug}/`,
      slug,
    };
  });
}
---

{matchedArticles.length > 0 && (
  <section class="related-courses-section">
    <div class="related-courses-header">
      <span class="related-badge">🧭 MODEL COURSES</span>
      <h2 class="related-courses-title">{title}</h2>
    </div>

    <div class="related-courses-grid">
      {matchedArticles.map(({ article, url }) => {
        const data = article.data;
        const heroImg = data.heroImage || '/thumbnails/default.png';
        const duration = data.duration || '1泊2日';
        const displayTags = (data.tags || []).slice(0, 3);

        return (
          <a href={url} class="course-card">
            <div class="course-thumb-wrap">
              <img src={heroImg} alt={data.title} loading="lazy" class="course-thumb" />
              <span class="course-duration-badge">{duration}</span>
            </div>
            <div class="course-content">
              {displayTags.length > 0 && (
                <div class="course-tags">
                  {displayTags.map((t) => (
                    <span class="course-tag">#{t}</span>
                  ))}
                </div>
              )}
              <h3 class="course-title">{data.title}</h3>
              <p class="course-desc">{data.description}</p>
              <div class="course-footer">
                <span class="course-read-more">コース詳細を見る →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<style>
  .related-courses-section {
    margin: 40px 0 24px;
    padding: 24px 20px;
    background: #f8faf9;
    border-radius: 14px;
    border: 1px solid #e1ebe6;
  }
  .related-courses-header {
    margin-bottom: 20px;
  }
  .related-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    color: #2b5c4b;
    background: #e2ede8;
    padding: 3px 8px;
    border-radius: 4px;
    letter-spacing: 0.05em;
    margin-bottom: 6px;
  }
  .related-courses-title {
    margin: 0;
    font-size: 1.25rem;
    color: #1a332a;
    font-weight: 800;
    border-left: 4px solid #2b5c4b;
    padding-left: 10px;
    line-height: 1.3;
  }
  .related-courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .course-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none !important;
    border: 1px solid #e6eeea;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
  }
  .course-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.08);
    border-color: #2b5c4b;
  }
  .course-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #e9ecef;
    overflow: hidden;
  }
  .course-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }
  .course-card:hover .course-thumb {
    transform: scale(1.04);
  }
  .course-duration-badge {
    position: absolute;
    bottom: 8px;
    left: 8px;
    background: rgba(26, 51, 42, 0.88);
    color: #ffffff;
    font-size: 0.72rem;
    font-weight: 700;
    padding: 3px 8px;
    border-radius: 4px;
    backdrop-filter: blur(2px);
  }
  .course-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 14px 14px 12px;
  }
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 8px;
  }
  .course-tag {
    font-size: 0.68rem;
    color: #496d60;
    background: #f0f5f3;
    padding: 2px 6px;
    border-radius: 3px;
  }
  .course-title {
    margin: 0 0 6px;
    font-size: 0.96rem;
    font-weight: 700;
    color: #1a332a;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .course-desc {
    margin: 0 0 12px;
    font-size: 0.78rem;
    color: #63756e;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .course-footer {
    display: flex;
    justify-content: flex-end;
    border-top: 1px dashed #e8efe9;
    padding-top: 8px;
  }
  .course-read-more {
    font-size: 0.75rem;
    font-weight: 700;
    color: #2b5c4b;
  }
</style>
