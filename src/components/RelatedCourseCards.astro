---
import { getCollection, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../utils/slug';

export interface Props {
  pref?: string;
  currentSlug?: string;
  limit?: number;
  courseSlugs?: string[];
  title?: string;
}

const {
  pref,
  currentSlug = '',
  limit = 3,
  courseSlugs,
  title = '他のモデルコースを見る',
} = Astro.props;

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && !data.draft;
});

let matchedArticles: { article: CollectionEntry<'articles'>; url: string; slug: string }[] = [];

if (courseSlugs && courseSlugs.length > 0) {
  for (const slugQuery of courseSlugs) {
    const cleanQuery = slugQuery.replace(/^\//, '').replace(/\/$/, '').split('/').pop() || slugQuery;
    const found = allArticles.find((art) => {
      const artSlug = getArticleSlug(art.id, art.data.pref);
      return art.id === cleanQuery || artSlug === cleanQuery || art.id.includes(cleanQuery);
    });
    if (found) {
      const slug = getArticleSlug(found.id, found.data.pref);
      const url = `/${found.data.pref}/${slug}/`;
      if (!currentSlug || !url.includes(currentSlug)) {
        matchedArticles.push({ article: found, url, slug });
      }
    }
  }
} else {
  const filtered = allArticles.filter((art) => {
    const slug = getArticleSlug(art.id, art.data.pref);
    const url = `/${art.data.pref}/${slug}/`;
    if (currentSlug && (url.includes(currentSlug) || currentSlug.includes(slug))) {
      return false;
    }
    if (pref && art.data.pref === pref) {
      return true;
    }
    return art.data.category === 'モデルコース';
  });

  matchedArticles = filtered.slice(0, limit).map((art) => {
    const slug = getArticleSlug(art.id, art.data.pref);
    return {
      article: art,
      url: `/${art.data.pref}/${slug}/`,
      slug,
    };
  });
}
---

{matchedArticles.length > 0 && (
  <aside class="related-courses-section" aria-labelledby="related-courses">
    <div class="related-courses-section-header">
      <span class="related-badge">関連コース</span>
      <h2 class="related-courses-title" id="related-courses">{title}</h2>
    </div>

    <div class="related-courses-grid">
      {matchedArticles.map(({ article, url }) => {
        const data = article.data;
        const heroImg = data.heroImage || '/thumbnails/default.png';
        const duration = data.duration || '1泊2日';
        const displayTags = (data.tags || []).slice(0, 3);

        return (
          <a href={url} class="course-card">
            <div class="course-thumb-wrap">
              <img src={heroImg} alt={data.title} loading="lazy" class="course-thumb" />
              <span class="course-duration-badge">{duration}</span>
            </div>
            <div class="course-content">
              {displayTags.length > 0 && (
                <div class="course-tags">
                  {displayTags.map((t) => (
                    <span class="course-tag">#{t}</span>
                  ))}
                </div>
              )}
              <h4 class="course-title">{data.title}</h4>
              <p class="course-desc">{data.description}</p>
              <div class="course-footer">
                <span class="course-read-more">コース詳細を見る →</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </aside>
)}

<style>
  .related-courses-section {
    margin: 2.5rem 0;
  }
  .related-courses-section-header {
    margin-bottom: 0.85rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  .related-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    color: #475569;
    background: #e2e8f0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }
  :global(.prose) .related-courses-section h2,
  .related-courses-title {
    margin: 0 !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #111827 !important;
    line-height: 1.35 !important;
    letter-spacing: -0.015em;
    border: none !important;
    padding: 0 !important;
    background: transparent !important;
    border-radius: 0 !important;
  }
  .related-courses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }
  .course-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border-radius: 8px;
    overflow: hidden;
    text-decoration: none !important;
    border: 1px solid #e2e8f0;
    transition: transform 0.15s ease, border-color 0.15s ease;
  }
  .course-card:hover {
    transform: translateY(-2px);
    border-color: #cbd5e1;
  }
  .course-thumb-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #1f2937;
    overflow: hidden;
  }
  .course-thumb {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .course-duration-badge {
    position: absolute;
    bottom: 6px;
    left: 6px;
    background: rgba(17, 24, 39, 0.85);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 3px;
    backdrop-filter: blur(2px);
  }
  .course-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 0.85rem;
  }
  .course-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-bottom: 0.4rem;
  }
  .course-tag {
    font-size: 0.68rem;
    color: #64748b;
    background: #f1f5f9;
    padding: 0.1rem 0.4rem;
    border-radius: 3px;
  }
  .course-title {
    margin: 0 0 0.35rem !important;
    font-size: 0.9rem !important;
    font-weight: 700 !important;
    color: #111827 !important;
    line-height: 1.4 !important;
    border: none !important;
    padding: 0 !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .course-desc {
    margin: 0 0 0.75rem !important;
    font-size: 0.74rem !important;
    color: #64748b !important;
    line-height: 1.45 !important;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }
  .course-footer {
    display: flex;
    justify-content: flex-end;
    border-top: 1px solid #f1f5f9;
    padding-top: 0.5rem;
  }
  .course-read-more {
    font-size: 0.74rem;
    font-weight: 700;
    color: #12627c;
  }
  .course-card:hover .course-read-more {
    color: #0c4a5e;
  }
</style>
