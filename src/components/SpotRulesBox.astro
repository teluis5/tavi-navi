---
export interface RuleItem {
  title: string;
  desc?: string;
  type?: 'ng' | 'ok' | 'info' | 'warn';
  icon?: string;
}

export interface Props {
  title?: string;
  lead?: string;
  rules: (RuleItem | string)[];
}

const {
  title = "見学マナー・利用時の注意点",
  lead,
  rules = [],
} = Astro.props;

// 正規化
const normalizedRules: RuleItem[] = rules.map((r) => {
  if (typeof r === 'string') {
    // プレフィックス判定（簡易）
    if (r.startsWith('NG:') || r.includes('禁止') || r.includes('厳禁')) {
      return { title: r, type: 'ng' };
    }
    return { title: r, type: 'info' };
  }
  return r;
});

function getBadge(type?: string) {
  switch (type) {
    case 'ng':
      return { label: '禁止', color: '#ef4444', bg: '#fef2f2', border: '#fecaca', icon: '✕' };
    case 'ok':
      return { label: '推奨', color: '#10b981', bg: '#f0fdf4', border: '#bbf7d0', icon: '✓' };
    case 'warn':
      return { label: '注意', color: '#f59e0b', bg: '#fffbeb', border: '#fde68a', icon: '!' };
    default:
      return { label: 'マナー', color: '#0284c7', bg: '#f0f9ff', border: '#bae6fd', icon: '●' };
  }
}
---

<div class="spot-rules-card" role="region" aria-label={title}>
  <div class="spot-rules-header">
    <h3 class="spot-rules-heading">{title}</h3>
  </div>

  {lead && <p class="spot-rules-lead">{lead}</p>}

  <ul class="spot-rules-list">
    {normalizedRules.map((item) => {
      const badge = getBadge(item.type);
      return (
        <li class={`spot-rules-item is-${item.type || 'info'}`}>
          <span class="spot-rules-badge">{item.icon && <span aria-hidden="true">{item.icon} </span>}{badge.label}</span>
          <div class="spot-rules-content">
            <strong class="spot-rules-item-title">{item.title}</strong>
            {item.desc && <p class="spot-rules-item-desc">{item.desc}</p>}
          </div>
        </li>
      );
    })}
  </ul>
</div>

<style>
  .spot-rules-card { --spot-ink: #1e293b; --spot-muted: #475569; --spot-accent: #075985; margin: 1.5rem 0 2rem; padding: 24px; background: #f2f7fa; border-radius: 8px; color: var(--spot-ink); }
  .spot-rules-header { margin-bottom: 16px; }
  .spot-rules-heading { margin: 0; font-size: 1.125rem; line-height: 1.3; font-weight: 700; color: var(--spot-ink); }
  .spot-rules-lead { margin: 0 0 16px; color: var(--spot-muted); font-size: 1rem; line-height: 1.7; }
  .spot-rules-list { list-style: none; margin: 0; padding: 0; }
  .spot-rules-item { display: grid; grid-template-columns: 3.5rem minmax(0, 1fr); gap: 16px; padding: 16px 0; }
  .spot-rules-item + .spot-rules-item { border-top: 1px solid #d5e2e9; }
  .spot-rules-item:last-child { padding-bottom: 0; }
  .spot-rules-badge { align-self: start; color: var(--spot-accent); font-size: .875rem; font-weight: 700; line-height: 1.7; }
  .is-ng .spot-rules-badge { color: #a12626; }
  .is-warn .spot-rules-badge { color: #805500; }
  .is-ok .spot-rules-badge { color: #166534; }
  .spot-rules-content { min-width: 0; }
  .spot-rules-item-title { display: block; font-size: 1rem; font-weight: 700; line-height: 1.7; }
  .spot-rules-item-desc { margin: 4px 0 0; color: var(--spot-muted); font-size: 1rem; line-height: 1.7; }
  @media (max-width: 640px) { .spot-rules-card { padding: 24px 16px; } .spot-rules-item { grid-template-columns: 3rem minmax(0, 1fr); gap: 8px; } }
</style>
