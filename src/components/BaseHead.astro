---
interface Props {
  title: string;
  description: string;
  image?: string;
  lang?: 'ja' | 'en';
  canonicalPath?: string;
}

const { title, description, image = '/favicon.svg', lang = 'ja', canonicalPath } = Astro.props;

// Google 検索結果にブランド名（サイト名）を表示させるための WebSite 構造化データ
const siteUrl = Astro.site ? Astro.site.toString() : Astro.url.origin;
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'name': 'タビナビ',
	'alternateName': ['tavi-navi', 'タビナビ（tavi-navi）', 'TaviNavi'],
	'url': siteUrl,
};

// Canonical URL normalization (enforce trailing slash per workspace rules)
const currentPath = canonicalPath || Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') || /\.[a-z0-9]+$/i.test(currentPath)
  ? currentPath
  : `${currentPath}/`;

const canonicalURL = new URL(normalizedPath, Astro.site);

// Generate alternate hreflang URLs
const pathWithoutLang = lang === 'en' 
  ? normalizedPath.replace(/^\/en/, '') || '/'
  : normalizedPath;

const jaURL = new URL(pathWithoutLang, Astro.site);
const enURL = new URL(`/en${pathWithoutLang === '/' ? '/' : pathWithoutLang}`, Astro.site);
---

<!-- Google Tag Manager (管理者除外対応) -->
<script is:inline>
(function(w,d,s,l,i){
  try {
    var params = new URLSearchParams(w.location.search);
    var hostname = w.location.hostname;
    var domainAttr = hostname.endsWith('tavi-navi.net') ? '; domain=.tavi-navi.net' : '';
    if (params.get('admin') === 'true') {
      d.cookie = "teluis_admin=true; path=/" + domainAttr + "; max-age=31536000; SameSite=Lax";
      localStorage.setItem('teluis_admin', 'true');
      console.log('[Admin Mode] GA/GTM 計測除外モードを有効化しました');
    } else if (params.get('admin') === 'false') {
      d.cookie = "teluis_admin=; path=/" + domainAttr + "; max-age=0";
      localStorage.removeItem('teluis_admin');
      console.log('[Admin Mode] GA/GTM 計測除外モードを解除しました');
    }
  } catch (e) {}

  var isAdmin = (d.cookie.indexOf('teluis_admin=true') !== -1);
  try {
    if (!isAdmin && localStorage.getItem('teluis_admin') === 'true') {
      isAdmin = true;
    }
  } catch (e) {}

  w[l] = w[l] || [];
  w.gtag = w.gtag || function(){ w[l].push(arguments); };

  if (isAdmin) {
    console.info('[Admin Mode] GTMの読み込みをスキップしました (自アクセス除外中)');
    return;
  }

  function loadGTM() {
    if (w['__gtm_loaded']) return;
    w['__gtm_loaded'] = true;
    w.gtag('js', new Date());
    w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
    var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  }

  ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(function(evt) {
    w.addEventListener(evt, loadGTM, { once: true, passive: true });
  });
})(window,document,'script','dataLayer','GTM-M3BFR377');
</script>
<script is:inline async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8011635154814608" crossorigin="anonymous"></script>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="generator" content={Astro.generator} />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Google サイト名表示用 構造化データ (WebSite JSON-LD) -->
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Multilingual SEO (hreflang) -->
<!-- 英語ページは公開停止中のため代替言語リンクを出力しない。 -->

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<meta property="og:site_name" content="tavi-navi（タビナビ）" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />
