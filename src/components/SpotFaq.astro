---
export interface FaqItem {
  q: string;
  a: string;
}

export interface Props {
  items: FaqItem[];
  title?: string;
  includeLdJson?: boolean;
}

const { items = [], title, includeLdJson = true } = Astro.props;

// Schema.org FAQPage JSON-LD
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": items.map((item) => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<div class="spot-faq-wrapper">
  {title && <h3 class="spot-faq-heading">{title}</h3>}
  <div class="spot-faq-list">
    {items.map((item, index) => (
      <div class="spot-faq-item">
        <div class="spot-faq-q">
          <span class="spot-faq-badge-q" aria-hidden="true">Q</span>
          <span class="spot-faq-text-q">{item.q}</span>
        </div>
        <div class="spot-faq-a">
          <span class="spot-faq-badge-a" aria-hidden="true">A</span>
          <div class="spot-faq-text-a">
            <p>{item.a}</p>
          </div>
        </div>
      </div>
    ))}
  </div>

  {includeLdJson && items.length > 0 && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
</div>

<style>
  .spot-faq-wrapper { --spot-ink: #1e293b; --spot-muted: #334155; --spot-accent: #075985; margin: 1.5rem 0 2rem; }
  .spot-faq-heading { margin: 0 0 16px; color: var(--spot-ink); font-size: 1.125rem; font-weight: 700; line-height: 1.3; }
  .spot-faq-list { border-top: 1px solid #dbe3e8; }
  .spot-faq-item { padding: 24px 0; border-bottom: 1px solid #dbe3e8; }
  .spot-faq-q, .spot-faq-a { display: grid; grid-template-columns: 24px minmax(0, 1fr); gap: 16px; line-height: 1.7; }
  .spot-faq-q { margin-bottom: 12px; color: var(--spot-ink); font-size: 1rem; font-weight: 700; }
  .spot-faq-a { color: var(--spot-muted); font-size: 1rem; }
  .spot-faq-badge-q, .spot-faq-badge-a { color: var(--spot-accent); font-weight: 700; font-size: 1.125rem; }
  .spot-faq-badge-a { color: #475569; }
  .spot-faq-text-a p { margin: 0; }
  @media (max-width: 640px) { .spot-faq-q, .spot-faq-a { gap: 8px; } }
</style>
