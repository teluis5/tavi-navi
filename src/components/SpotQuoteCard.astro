---
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../utils/slug';

export interface Props {
  slug: string;
  pref?: string;
  label?: string;
}

const { slug: rawSlug, pref = 'akita', label = 'あわせて立ち寄りたい周辺スポット' } = Astro.props;

const cleanQuery = rawSlug.replace(/^\//, '').replace(/\/$/, '').split('/').pop() || rawSlug;

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && !data.draft;
});

const article = allArticles.find((art) => {
  const artSlug = getArticleSlug(art.id, art.data.pref);
  return art.id === cleanQuery || artSlug === cleanQuery || art.id.includes(cleanQuery);
});

let targetUrl = '';
let targetTitle = '';
let targetDesc = '';
let targetCategory = '';
let targetImage = '';

if (article) {
  const artSlug = getArticleSlug(article.id, article.data.pref);
  targetUrl = `/${article.data.pref}/${artSlug}/`;
  targetTitle = article.data.title;
  targetDesc = article.data.description;
  targetCategory = article.data.category;
  targetImage = article.data.heroImage || '';
}
---

{article && (
  <aside class="spot-quote-card" aria-label={label}>
    <div class="spot-quote-badge">
      <span class="spot-quote-label">{label}</span>
      {targetCategory && <span class="spot-quote-cat">{targetCategory}</span>}
    </div>

    <a href={targetUrl} class="spot-quote-body">
      <div class="spot-quote-content">
        <h4 class="spot-quote-title">{targetTitle}</h4>
        <p class="spot-quote-desc">{targetDesc}</p>
        <span class="spot-quote-link">
          詳細ガイドを読む <span aria-hidden="true">&rarr;</span>
        </span>
      </div>
    </a>
  </aside>
)}

<style>
  .spot-quote-card { --spot-ink: #1e293b; --spot-muted: #475569; --spot-accent: #075985; margin: 1.25rem 0 1.5rem; padding: 24px; background: #f2f7fa; border-radius: 8px; }
  .spot-quote-badge { display: flex; flex-wrap: wrap; align-items: baseline; gap: 8px 16px; margin-bottom: 12px; }
  .spot-quote-label { color: var(--spot-accent); font-size: .875rem; font-weight: 700; line-height: 1.5; }
  .spot-quote-cat { color: var(--spot-muted); font-size: .875rem; line-height: 1.5; }
  .spot-quote-body { display: block; color: inherit; text-decoration: none; border-radius: 2px; }
  .spot-quote-body:focus-visible { outline: 2px solid #075985; outline-offset: 4px; }
  .spot-quote-title { margin: 0 0 8px; color: var(--spot-ink); font-size: 1.125rem; font-weight: 700; line-height: 1.5; }
  .spot-quote-desc { margin: 0 0 16px; color: var(--spot-muted); font-size: 1rem; line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .spot-quote-link { color: var(--spot-accent); font-size: .875rem; font-weight: 700; }
  .spot-quote-body:hover .spot-quote-title, .spot-quote-body:hover .spot-quote-link { text-decoration: underline; text-underline-offset: 3px; }
  @media (max-width: 640px) { .spot-quote-card { padding: 24px 16px; } }
</style>
