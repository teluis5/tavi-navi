---
import type { ImageMetadata } from 'astro';

export interface PhotoItem {
  image: string | ImageMetadata;
  caption?: string;
  imageCredit?: string;
  isSample?: boolean;
}

export interface Props {
  title: string;
  pillText?: string | null;
  image?: string | ImageMetadata;
  images?: (string | ImageMetadata | PhotoItem)[];
  imageLayout?: 'single' | 'carousel' | 'grid-2' | 'grid-3' | 'pip';
  imageCredit?: string;
  isImageSample?: boolean;
  spotData?: any;
}

const {
  title,
  pillText,
  image,
  images,
  imageLayout: propLayout,
  imageCredit,
  isImageSample,
  spotData,
} = Astro.props;

function getImageUrl(img: any): string {
  if (!img) return '';
  if (typeof img === 'string') return img;
  if (typeof img === 'object' && 'src' in img) return img.src;
  return '';
}

const photoItems: PhotoItem[] = [];
if (images && images.length > 0) {
  images.forEach((item) => {
    if (typeof item === 'object' && item !== null && 'image' in item) {
      photoItems.push(item as PhotoItem);
    } else {
      photoItems.push({ image: item as string | ImageMetadata });
    }
  });
} else if (image) {
  photoItems.push({ image, imageCredit, isSample: isImageSample });
}

const isMulti = photoItems.length > 1;
const layout = propLayout || (isMulti ? 'carousel' : 'single');
const heroImg = getImageUrl(image || photoItems[0]?.image || spotData?.heroImage);

// 複数写真のクレジット合成
function formatCredits(photos: PhotoItem[], defaultCredit?: string, currentLayout?: string): string {
  if (currentLayout === 'pip' || currentLayout === 'grid-2' || currentLayout === 'grid-3') {
    const count = currentLayout === 'grid-3' ? 3 : 2;
    const targets = photos.slice(0, count);
    const credits = targets.map((p) => p.imageCredit || defaultCredit || '').filter(Boolean);
    if (credits.length === 0) return '';
    const allSame = credits.every((c) => c === credits[0]);
    if (allSame) {
      const c = credits[0];
      return c.startsWith('写真提供') || c.startsWith('©') ? c : `写真提供：${c}`;
    }
    const labels = currentLayout === 'pip' ? ['背景', '小枠'] : currentLayout === 'grid-2' ? ['左', '右'] : ['左', '右上', '右下'];
    const parts = targets.map((p, idx) => {
      const cr = p.imageCredit || defaultCredit;
      return cr ? `${cr}(${labels[idx]})` : '';
    }).filter(Boolean);
    return `写真提供：${parts.join('、')}`;
  }

  // 通常・スライダー
  const c = photos[0]?.imageCredit || defaultCredit;
  let text = '';
  if (c) {
    text = c.startsWith('写真提供') || c.startsWith('©') ? c : `写真提供：${c}`;
  }
  if (isImageSample) {
    return text ? `${text}（イメージ写真）` : '※写真はイメージです';
  }
  return text;
}

const creditText = formatCredits(photoItems, imageCredit, layout);
---

{layout === 'pip' && isMulti ? (
  /* ピクチャー・イン・ピクチャー（PiP） */
  <div class="wide-photo-container photo-pip-container">
    <img src={getImageUrl(photoItems[0].image)} alt={title} class="wide-photo-img" loading="lazy" />
    <div class="pip-inset-frame">
      <img src={getImageUrl(photoItems[1].image)} alt={photoItems[1].caption || title} class="pip-inset-img" loading="lazy" />
    </div>
    <div class="wide-photo-overlay pointer-events-none">
      <div class="overlay-title-column align-left">
        {pillText && (
          <div class="overlay-tag-above-title">
            <span class="photo-category-pill">{pillText}</span>
          </div>
        )}
        <div class="overlay-title-row">
          <h4 class="overlay-heading single-line-heading">{title}</h4>
          {spotData && <span class="overlay-chevron">›</span>}
        </div>
      </div>
      <div class="overlay-bottom-bar">
        <div class="overlay-meta-right">
          {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
        </div>
      </div>
    </div>
  </div>
) : layout === 'grid-2' && isMulti ? (
  /* 2分割グリッド */
  <div class="wide-photo-container photo-grid-wrapper">
    <div class="photo-gallery-grid-2">
      <div class="grid-2-cell">
        <img src={getImageUrl(photoItems[0].image)} alt={title} class="grid-cell-img" loading="lazy" />
      </div>
      <div class="grid-2-cell">
        <img src={getImageUrl(photoItems[1].image)} alt={title} class="grid-cell-img" loading="lazy" />
      </div>
    </div>
    <div class="wide-photo-overlay pointer-events-none">
      <div class="overlay-title-column align-left">
        {pillText && (
          <div class="overlay-tag-above-title">
            <span class="photo-category-pill">{pillText}</span>
          </div>
        )}
        <div class="overlay-title-row">
          <h4 class="overlay-heading single-line-heading">{title}</h4>
          {spotData && <span class="overlay-chevron">›</span>}
        </div>
      </div>
      <div class="overlay-bottom-bar">
        <div class="overlay-meta-right">
          {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
        </div>
      </div>
    </div>
  </div>
) : layout === 'grid-3' && isMulti ? (
  /* 3分割グリッド */
  <div class="wide-photo-container photo-grid-wrapper">
    <div class="photo-gallery-grid-3">
      <div class="grid-3-main-cell">
        <img src={getImageUrl(photoItems[0].image)} alt={title} class="grid-cell-img" loading="lazy" />
      </div>
      <div class="grid-3-sub-column">
        {photoItems.slice(1, 3).map((p) => (
          <div class="grid-3-sub-cell">
            <img src={getImageUrl(p.image)} alt={title} class="grid-cell-img" loading="lazy" />
          </div>
        ))}
      </div>
    </div>
    <div class="wide-photo-overlay pointer-events-none">
      <div class="overlay-title-column align-left">
        {pillText && (
          <div class="overlay-tag-above-title">
            <span class="photo-category-pill">{pillText}</span>
          </div>
        )}
        <div class="overlay-title-row">
          <h4 class="overlay-heading single-line-heading">{title}</h4>
          {spotData && <span class="overlay-chevron">›</span>}
        </div>
      </div>
      <div class="overlay-bottom-bar">
        <div class="overlay-meta-right">
          {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
        </div>
      </div>
    </div>
  </div>
) : isMulti && layout === 'carousel' ? (
  /* 写真のみスライダートラック */
  <div class="wide-photo-container spot-photo-slider-container">
    <div class="spot-photo-only-track" tabindex="0" role="region" aria-label="写真一覧。左右の矢印キーで移動できます">
      {photoItems.map((photo) => (
        <div class="spot-photo-only-slide">
          <img src={getImageUrl(photo.image)} alt={photo.caption || title} class="wide-photo-img" loading="lazy" />
        </div>
      ))}
    </div>
    <div class="wide-photo-overlay pointer-events-none">
      <div class="overlay-title-column align-left">
        {pillText && (
          <div class="overlay-tag-above-title">
            <span class="photo-category-pill">{pillText}</span>
          </div>
        )}
        <div class="overlay-title-row">
          <h4 class="overlay-heading single-line-heading">{title}</h4>
          {spotData && <span class="overlay-chevron">›</span>}
        </div>
      </div>
      <div class="overlay-bottom-bar">
        <div class="overlay-meta-right">
          {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
        </div>
      </div>
    </div>
  </div>
) : (
  /* 通常1枚写真 */
  <div class="wide-photo-container">
    {heroImg && <img src={heroImg} alt={title} class="wide-photo-img" loading="lazy" />}
    <div class="wide-photo-overlay">
      <div class="overlay-title-column align-left">
        {pillText && (
          <div class="overlay-tag-above-title">
            <span class="photo-category-pill">{pillText}</span>
          </div>
        )}
        <div class="overlay-title-row">
          <h4 class="overlay-heading single-line-heading">{title}</h4>
          {spotData && <span class="overlay-chevron">›</span>}
        </div>
      </div>
      <div class="overlay-bottom-bar">
        <div class="overlay-meta-right">
          {creditText && <span class="photo-credit-tag tiny-credit">{creditText}</span>}
        </div>
      </div>
    </div>
  </div>
)}

<style>
  .wide-photo-container {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: #20332c;
    overflow: hidden;
  }
  .wide-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .wide-photo-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 12px 14px 10px;
    background: linear-gradient(180deg, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.1) 40%, rgba(0,0,0,0.65) 100%);
    color: #ffffff;
    z-index: 3;
  }
  .overlay-title-column {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .photo-category-pill {
    display: inline-block;
    font-size: 0.68rem;
    font-weight: 800;
    color: #ffffff;
    background: rgba(33, 92, 72, 0.9);
    padding: 2px 7px;
    border-radius: 4px;
    backdrop-filter: blur(2px);
  }
  .overlay-heading {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 800;
    color: #ffffff;
    text-shadow: 0 1px 3px rgba(0,0,0,0.6);
    line-height: 1.35;
  }
  .overlay-title-row {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .overlay-chevron {
    font-size: 1.2rem;
    color: #8ce4cb;
    font-weight: 700;
  }
  .overlay-bottom-bar {
    display: flex;
    justify-content: flex-end;
  }
  .photo-credit-tag {
    font-size: 0.64rem;
    color: rgba(255, 255, 255, 0.85);
    background: rgba(0, 0, 0, 0.45);
    padding: 2px 6px;
    border-radius: 3px;
    backdrop-filter: blur(2px);
  }

  /* PiP & Grid */
  .photo-pip-container {
    position: relative;
  }
  .pip-inset-frame {
    position: absolute;
    bottom: 12px;
    right: 12px;
    width: 32%;
    aspect-ratio: 4 / 3;
    border: 2px solid #ffffff;
    border-radius: 6px;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.4);
    z-index: 2;
  }
  .pip-inset-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo-gallery-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100%;
    gap: 2px;
  }
  .grid-2-cell {
    overflow: hidden;
  }
  .photo-gallery-grid-3 {
    display: grid;
    grid-template-columns: 2fr 1fr;
    height: 100%;
    gap: 2px;
  }
  .grid-3-main-cell {
    overflow: hidden;
  }
  .grid-3-sub-column {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 2px;
  }
  .grid-3-sub-cell {
    overflow: hidden;
  }
  .grid-cell-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .pointer-events-none {
    pointer-events: none;
  }

  /* 写真スライダー */
  .spot-photo-slider-container {
    position: relative;
  }
  .spot-photo-only-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    height: 100%;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .spot-photo-only-track::-webkit-scrollbar {
    display: none;
  }
  .spot-photo-only-slide {
    flex: 0 0 100%;
    width: 100%;
    height: 100%;
    scroll-snap-align: start;
  }
</style>
