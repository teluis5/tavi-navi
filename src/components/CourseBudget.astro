---
export interface BudgetItem {
  category: string;
  amount: number | string;
  note?: string;
}

export interface Props {
  total?: number | string;
  personLabel?: string;
  title?: string;
  items?: BudgetItem[];
  totalPerPerson?: string;
  totalNote?: string;
  // 簡易指定用プロパティ
  shinkansen?: number | string;
  hotel?: number | string;
  localTransit?: number | string;
  meals?: number | string;
}

const {
  total: propTotal,
  totalPerPerson,
  totalNote,
  personLabel = '大人1名あたり（2名1室利用時・概算目安）',
  title = 'このコースの概算予算・費用内訳',
  items: propItems,
  shinkansen,
  hotel,
  localTransit,
  meals,
} = Astro.props;

let budgetItems: BudgetItem[] = propItems || [];

if (!propItems || propItems.length === 0) {
  const autoItems: BudgetItem[] = [];
  if (shinkansen !== undefined) {
    autoItems.push({
      category: '往復交通（新幹線・特急等）',
      amount: shinkansen,
      note: typeof shinkansen === 'string' && shinkansen.includes('pt') ? 'JRE POINT利用' : '通常期指定席目安',
    });
  }
  if (hotel !== undefined) {
    autoItems.push({
      category: '宿泊費（1泊）',
      amount: hotel,
      note: '平日〜休前日の最安〜標準目安',
    });
  }
  if (localTransit !== undefined) {
    autoItems.push({
      category: '現地交通（バス・路線）',
      amount: localTransit,
      note: '周遊バス・路線バス運賃',
    });
  }
  if (meals !== undefined) {
    autoItems.push({
      category: '飲食・現地体験',
      amount: meals,
      note: 'ランチ・名物グルメ・入場料など',
    });
  }
  budgetItems = autoItems;
}

// 合計金額の算出
let displayTotal = totalPerPerson || propTotal;
if (!displayTotal) {
  const numSum = budgetItems.reduce((acc, item) => {
    if (typeof item.amount === 'number') {
      return acc + item.amount;
    }
    const parsed = parseInt(String(item.amount).replace(/[^0-9]/g, ''), 10);
    return !isNaN(parsed) && !String(item.amount).includes('pt') ? acc + parsed : acc;
  }, 0);

  if (numSum > 0) {
    displayTotal = `約${numSum.toLocaleString('ja-JP')}円〜`;
  } else {
    displayTotal = 'プランによる';
  }
} else if (typeof displayTotal === 'number') {
  displayTotal = `約${displayTotal.toLocaleString('ja-JP')}円〜`;
}

const formatAmount = (val: number | string) => {
  if (typeof val === 'number') {
    return `${val.toLocaleString('ja-JP')}円`;
  }
  return String(val);
};
---

<div class="course-budget-section" aria-labelledby="course-budget">
  <div class="budget-section-header">
    <span class="budget-badge">費用目安</span>
    <h2 class="budget-title" id="course-budget">{title}</h2>
  </div>

  <div class="budget-summary-bar">
    <span class="budget-person-label">{personLabel}</span>
    <div class="budget-total-box">
      <span class="total-label">1人あたり合計目安</span>
      <span class="total-value">{displayTotal}</span>
    </div>
  </div>

  <table class="budget-table">
    <tbody>
      {budgetItems.map((item) => (
        <tr class="budget-row">
          <th scope="row" class="budget-col-category">
            <span class="item-category-text">{item.category}</span>
            {item.note && <span class="item-note-text">{item.note}</span>}
          </th>
          <td class="budget-col-amount">
            <span class="amount-value">{formatAmount(item.amount)}</span>
          </td>
        </tr>
      ))}
    </tbody>
  </table>

  {(totalNote || budgetItems.length > 0) && (
    <div class="budget-footer-note">
      <p>{totalNote || '※表示料金は調査時点の標準的な目安です。宿泊日・予約タイミング・利用プランにより変動します。'}</p>
    </div>
  )}
</div>

<style>
  .course-budget-section {
    margin: 2.5rem 0 2rem;
  }

  .budget-section-header {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
    margin-bottom: 0.85rem;
  }

  .budget-badge {
    align-self: flex-start;
    font-size: 0.7rem;
    font-weight: 700;
    color: #475569;
    background: #e2e8f0;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.04em;
    line-height: 1.3;
  }

  :global(.prose) .course-budget-section h2,
  .budget-title {
    margin: 0 !important;
    font-size: 1.25rem !important;
    font-weight: 800 !important;
    color: #111827 !important;
    line-height: 1.35 !important;
    letter-spacing: -0.015em;
    border: none !important;
    padding: 0 !important;
    background: transparent !important;
    border-radius: 0 !important;
  }

  .budget-summary-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem 0;
    border-bottom: 2px solid #e2e8f0;
    margin-bottom: 0.5rem;
  }

  .budget-person-label {
    font-size: 0.74rem;
    color: #64748b;
  }

  .budget-total-box {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
  }

  .total-label {
    font-size: 0.68rem;
    font-weight: 600;
    color: #64748b;
  }

  .total-value {
    font-size: 1.35rem;
    font-weight: 900;
    color: #111827;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .budget-table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 0.75rem 0 !important;
  }

  .budget-row {
    border-bottom: 1px solid #f1f5f9;
  }

  .budget-row:last-child {
    border-bottom: none;
  }

  .budget-col-category {
    text-align: left;
    padding: 0.65rem 0;
    vertical-align: middle;
    font-weight: normal;
  }

  .item-category-text {
    display: block;
    font-size: 0.86rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.4;
  }

  .item-note-text {
    display: block;
    font-size: 0.73rem;
    color: #64748b;
    margin-top: 0.1rem;
    line-height: 1.35;
  }

  .budget-col-amount {
    text-align: right;
    padding: 0.65rem 0;
    vertical-align: middle;
    white-space: nowrap;
    width: 35%;
  }

  .amount-value {
    font-size: 0.95rem;
    font-weight: 800;
    color: #111827;
    font-variant-numeric: tabular-nums;
  }

  .budget-footer-note {
    border-top: 1px dashed #e2e8f0;
    padding-top: 0.65rem;
    margin-top: 0.25rem;
  }

  .budget-footer-note p {
    margin: 0 !important;
    font-size: 0.7rem !important;
    color: #64748b !important;
    line-height: 1.45 !important;
  }

  @media (max-width: 540px) {
    .course-budget-card {
      padding: 1rem 1.05rem;
    }
    .budget-header {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }
    .budget-total-box {
      align-items: flex-start;
      width: 100%;
      padding-top: 0.5rem;
      border-top: 1px dashed #e2e8f0;
    }
    .total-value {
      font-size: 1.25rem;
    }
  }
</style>
