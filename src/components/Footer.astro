---
import { REGIONS, PREFECTURES } from '../data/prefectures';

interface Props {
  lang?: 'ja' | 'en';
}

const { lang = 'ja' } = Astro.props;
const isEn = lang === 'en';
const prefPrefix = isEn ? '/en/' : '/';
---

<footer class="site-footer">
  <div class="container">
    <details class="footer-pref-fold">
      <summary class="footer-pref-summary">
        <span>{isEn ? 'Explore Japan by Prefecture (47 Prefectures)' : '47都道府県から旬の旅を探す'}</span>
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
      </summary>
      <div class="footer-pref-grid">
        {REGIONS.map((region) => {
          const prefs = PREFECTURES.filter((p) => p.region === region.id);
          return (
            <div>
              <h4 class="footer-region-title">
                {isEn ? region.nameEn : region.nameJa}
              </h4>
              <div class="footer-region-links">
                {prefs.map((p) => (
                  <a href={`${prefPrefix}${p.id}/`}>
                    {isEn ? p.nameEn : p.nameJa}
                  </a>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </details>

    <nav class="footer-nav">
      <a href={isEn ? '/en/' : '/'}>{isEn ? 'Home' : 'ホーム'}</a>
      <a href={isEn ? '/en/about/' : '/about/'}>{isEn ? 'About Us' : '当サイトについて'}</a>
      <a href={isEn ? '/en/privacy/' : '/privacy/'}>{isEn ? 'Privacy Policy' : 'プライバシーポリシー'}</a>
      <a href={isEn ? '/en/contact/' : '/contact/'}>{isEn ? 'Contact' : 'お問い合わせ'}</a>
    </nav>

    <div class="copyright">
      &copy; {new Date().getFullYear()} tavi-navi.net. All rights reserved.
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #ffffff;
    border-top: 1px solid var(--border-color, #e2e8f0);
    padding: 2rem 0 2rem;
    margin-top: 3.5rem;
    font-size: 0.9rem;
    color: var(--text-light, #64748b);
  }
  .footer-pref-fold {
    margin-bottom: 1.5rem;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background: #F8FAFB;
    overflow: hidden;
  }
  .footer-pref-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    font-size: 0.86rem;
    font-weight: 700;
    color: #334155;
    cursor: pointer;
    list-style: none;
  }
  .footer-pref-summary::-webkit-details-marker {
    display: none;
  }
  .footer-pref-summary svg {
    transition: transform 0.2s ease;
  }
  .footer-pref-fold[open] .footer-pref-summary svg {
    transform: rotate(180deg);
  }
  .footer-pref-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 1rem;
    padding: 1rem;
    background: #ffffff;
    border-top: 1px solid #e2e8f0;
  }
  .footer-region-title {
    font-size: 0.78rem;
    font-weight: 800;
    color: var(--color-teal, #0E7C94);
    margin: 0 0 0.35rem;
  }
  .footer-region-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.5rem;
    font-size: 0.76rem;
  }
  .footer-region-links a {
    color: #64748b;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    justify-content: center;
  }

  .footer-nav a {
    color: var(--text-light, #64748b);
    text-decoration: none;
  }
  .footer-nav a:hover {
    color: var(--theme-accent, #0284c7);
    text-decoration: underline;
  }

  .copyright {
    text-align: center;
    font-size: 0.8rem;
    color: var(--text-light, #64748b);
  }
</style>
