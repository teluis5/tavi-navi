---
import Layout from '../../layouts/Layout.astro';
import { DOKOKANI_LINES, stationUrl } from '../../data/dokokanibyun-lines';

const title = 'どこかにビューーン！攻略｜当たり駅の選び方・駅別ガイド';
const description = 'どこかにビューーン！の攻略ガイド。候補駅を路線別に探し、当たり駅の選び方、何日前からの予約、JRE BANKクーポンの使い方を確認できます。';
---

<Layout title={title} description={description}>
  <article class="page">
    <nav class="breadcrumbs" aria-label="パンくずリスト"><a href="/">トップ</a><span aria-hidden="true"> / </span><span>どこかにビューン！駅別ガイド</span></nav>
    <header class="hero">
      <p class="eyebrow">新幹線で、どこへ行こう。</p>
      <h1>どこかにビューーン！攻略<br />駅から探す旅ガイド</h1>
      <p>候補に出た駅も、行き先が決まった駅も。<br />見どころをチェックして、旅の準備を始めよう。</p>
    </header>

    <section class="finder" id="all-stations" aria-labelledby="finder-title">
      <div class="section-heading">
        <p class="eyebrow">STATION GUIDE</p>
        <h2 id="finder-title">路線から駅を探す</h2>
        <p>駅名をタップすると、見どころや旅のヒントを確認できます。</p>
      </div>
      <nav class="line-nav" aria-label="路線一覧">
        {DOKOKANI_LINES.map((line) => <a href={`#line-${line.id}`} style={`--line-color: ${line.color}; --line-tint: ${line.tint};`}>{line.name}<span>新幹線</span></a>)}
      </nav>
      <p class="order-note">掲載駅は東京方面からの順です。すべての対象駅を掲載しているわけではありません。</p>
      {DOKOKANI_LINES.map((line) => (
        <section class="line" id={`line-${line.id}`} aria-labelledby={`heading-${line.id}`} style={`--line-color: ${line.color}; --line-accent: ${line.accent}; --line-tint: ${line.tint};`}>
          <div class="line-heading"><h3 id={`heading-${line.id}`}>{line.name}新幹線</h3><span>{line.items.length}駅</span></div>
          <ul class="station-list">
            {line.items.map((station) => (
              <li><a class="station" href={stationUrl(station.id)}>
                <span class="station-copy"><span class="station-name">{station.name}<small>駅</small><span class="pref">{station.prefName}</span></span><span class="station-place">{station.bestSpot}</span></span>
                <span class="arrow" aria-hidden="true">›</span>
              </a></li>
            ))}
          </ul>
          <a class="back" href="#all-stations">↑ 路線一覧へ</a>
        </section>
      ))}
    </section>

    <section class="guide" id="tips">
      <p class="eyebrow">BEFORE YOU GO</p>
      <h2>申し込み前にチェック</h2>
      <p>4つの候補駅のどこに決まっても楽しめるか、見どころと現地の移動手段を確認しましょう。</p>
      <p>対象駅や必要ポイント、申し込み・変更の条件は、出発日や発着地によって異なる場合があります。最新情報は公式サイトで確認してください。</p>
      <a class="official" href="https://dokokani-eki-net.com/" target="_blank" rel="noopener noreferrer">どこかにビューン！公式サイトを見る <span aria-hidden="true">↗</span></a>
      <nav class="guide-articles" aria-label="申し込み攻略記事">
        <a href="/special/dynamic-rail-pack/">列車と宿を選ぶダイナミックレールパック特集 →</a>
        <a href="/tokyo/dokokani-four-stations-guide/">東京発：4候補駅の選び方 →</a>
        <a href="/saitama/dokokani-four-stations-guide/">大宮発：4候補駅の選び方 →</a>
        <a href="/tokyo/dokokani-nannichimae/">予約は何日前から？いつ決まる？ →</a>
        <a href="/tokyo/dokokani-jre-bank-coupon/">JRE BANKクーポンの条件と使い方 →</a>
      </nav>
    </section>
  </article>
</Layout>

<style>
  .page { max-width: 720px; margin: 0 auto; padding: 0 20px 64px; color: #172b3a; }
  .breadcrumbs { padding: 16px 0; font-size: 12px; color: #526676; }
  .breadcrumbs a { color: #35647a; }
  .hero { padding: 32px 24px; background: #eaf4f7; border-radius: 12px; }
  .eyebrow { margin: 0 0 8px; color: #12627c; font-size: 12px; font-weight: 700; letter-spacing: .08em; }
  .hero h1 { margin: 0 0 16px; color: #123d50; font-size: clamp(25px, 6vw, 36px); line-height: 1.35; }
  .hero > p:last-child { margin: 0; font-size: 14px; line-height: 1.8; }
  .finder { padding-top: 40px; scroll-margin-top: 80px; }
  .section-heading h2, .guide h2 { margin: 0 0 8px; font-size: 22px; line-height: 1.3; }
  .section-heading > p:last-child, .order-note { margin: 0; color: #526676; font-size: 13px; line-height: 1.7; }
  .line-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 20px 0 16px; }
  .line-nav a { min-height: 48px; display: flex; align-items: center; justify-content: center; color: var(--line-color); background: var(--line-tint); border-radius: 8px; font-size: 15px; font-weight: 700; text-decoration: none; }
  .line-nav a span { font-size: 11px; }
  .line { padding-top: 32px; scroll-margin-top: 72px; }
  .line-heading { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; border-bottom: 2px solid var(--line-accent); }
  .line-heading h3 { margin: 0; font-size: 18px; line-height: 1.3; }
  .line-heading > span { color: #526676; font-size: 12px; }
  .station-list { margin: 0; padding: 0; list-style: none; }
  .station-list li { border-bottom: 1px solid #dce5e9; }
  .station { display: flex; align-items: center; justify-content: space-between; min-height: 72px; gap: 16px; padding: 12px 4px; color: inherit; text-decoration: none; }
  .station-copy { display: block; min-width: 0; }
  .station-name { display: block; font-size: 17px; font-weight: 700; line-height: 1.4; }
  .station-name small { font-size: 12px; }
  .pref { margin-left: 8px; color: #526676; font-size: 12px; font-weight: 400; }
  .station-place { display: block; margin-top: 4px; color: #526676; font-size: 13px; line-height: 1.5; }
  .arrow { flex: none; color: var(--line-color); font-size: 28px; line-height: 1; }
  .back { display: inline-block; padding: 12px 0; color: var(--line-color); font-size: 13px; font-weight: 700; }
  .guide { margin-top: 40px; padding: 24px; background: #f2f6f7; border-radius: 12px; scroll-margin-top: 80px; }
  .guide p:not(.eyebrow) { margin: 12px 0 0; font-size: 14px; line-height: 1.8; }
  .official { display: inline-block; margin-top: 16px; color: #125c75; font-size: 14px; font-weight: 700; }
  .guide-articles { display: grid; gap: 12px; margin-top: 20px; }
  .guide-articles a { color: #125c75; font-size: 14px; font-weight: 700; line-height: 1.6; }
  a:focus-visible { outline: 3px solid #12627c; outline-offset: 3px; }
  .station:hover { background: var(--line-tint); }
  .line-nav a:hover { text-decoration: underline; }
  @media (min-width: 600px) { .hero { padding: 48px; } .line-nav { grid-template-columns: repeat(5, minmax(0, 1fr)); } }
</style>
