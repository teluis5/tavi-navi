---
import Layout from '../../../layouts/Layout.astro';
import accessMap from '../../../content/blog/yokohama-expo-2027-hotels/green-expo-access.svg?raw';

const title = '横浜花博（GREEN×EXPO 2027）沿線別ホテル・前泊拠点ガイド｜楽天トラベル予約';
const description =
  '横浜花博（GREEN×EXPO 2027）に便利な周辺ホテルを沿線別に紹介。相鉄線・相鉄東急/埼京線直通・JR横浜線・東急田園都市線の4路線ごとに、シャトルバス発着駅とおすすめ宿泊エリア（楽天トラベル）をまとめました。';

const STATION_URLS: Record<string, string> = {
  大和: 'https://travel.rakuten.co.jp/yado/traffic/kanagawa/00000000000000227143.html',
  橋本: 'https://hotel.travel.rakuten.co.jp/hotellist/list/00000000000000229106.html?f_target_key=station',
  八王子: 'https://hotel.travel.rakuten.co.jp/hotellist/list/00000000000000202854.html?f_target_key=station',
  桜木町: 'https://travel.rakuten.co.jp/yado/traffic/kanagawa/00000000000000229313.html',
  新宿: 'https://travel.rakuten.co.jp/yado/traffic/tokyo/00000000000000202276.html',
  品川: 'https://travel.rakuten.co.jp/yado/traffic/tokyo/00000000000000201974.html',
};
const affiliateUrl = (url: string) => `https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=${encodeURIComponent(url)}`;

const MAP_LABELS = [
  {
    "text": "東京",
    "x": 1060.0,
    "y": 95.0,
    "anchor": "end",
    "kind": "station"
  },
  {
    "text": "花博",
    "x": 420.0,
    "y": 391.0,
    "anchor": "start",
    "kind": "destination"
  },
  {
    "text": "会場",
    "x": 420.0,
    "y": 409.0,
    "anchor": "start",
    "kind": "destination"
  },
  {
    "text": "成田空港",
    "x": 1120.0,
    "y": 72.0,
    "anchor": "end",
    "kind": "minor"
  },
  {
    "text": "羽田空港",
    "x": 1120.0,
    "y": 473.0,
    "anchor": "end",
    "kind": "minor"
  },
  {
    "text": "名古屋・新大阪方面",
    "x": 445.0,
    "y": 576.0,
    "anchor": "start",
    "kind": "minor"
  }
];

const MAP_AREAS = [
  { name: '八王子', x: 80, y: 97.25, access: 'JR横浜線で十日市場駅へ。駅から会場行きシャトルバスを利用。', feature: '多摩エリアからの移動や八王子周辺の宿泊に便利な拠点。', target: 'yokohama-line', hotel: 0 },
  { name: '橋本', x: 205, y: 153.5, access: 'JR横浜線で十日市場駅へ。駅から会場行きシャトルバスを利用。', feature: 'JR横浜線・相模線と京王相模原線が乗り入れる宿泊拠点。', target: 'yokohama-line', hotel: 0 },
  { name: '大和', x: 205, y: 500, access: '相鉄線で瀬谷駅・三ツ境駅へ。駅から会場行きシャトルバスを利用。', feature: '会場に近い相鉄線沿線の宿泊拠点。駅周辺でホテルを探せます。', target: 'sotetsu', hotel: 1 },
  { name: '桜木町', x: 1095, y: 554, access: 'JR横浜線直通列車などで十日市場駅へ。直通列車の運行をご確認ください。', feature: 'みなとみらい観光と花博を組み合わせやすいエリア。', target: 'yokohama-line', hotel: 2 },
  { name: '新宿', x: 740, y: 100, access: '相鉄・JR直通列車などで相鉄線方面へ。列車の行き先と乗り換えをご確認ください。', feature: '都内観光も楽しみたい人に便利な宿泊拠点。', target: 'direct', hotel: 0 },
  { name: '品川', x: 1080, y: 220, access: '京急線などで横浜駅へ、相鉄線に乗り換えて瀬谷駅・三ツ境駅方面へ。', feature: '新幹線や羽田空港からのアクセスを重視する人に便利な拠点。', target: 'direct', hotel: 0 },
  { name: '横浜', x: 975, y: 500, access: '相鉄線で瀬谷駅・三ツ境駅へ。各駅から会場行きシャトルバスを利用。', feature: 'ホテルや飲食店が多く、みなとみらい観光と組み合わせやすいエリア。', target: 'sotetsu', hotel: 0 },
  { name: '新横浜', x: 765, y: 405.5, access: 'JR横浜線で十日市場駅へ。または相鉄・東急直通線で相鉄線方面へ。', feature: '東海道新幹線の停車駅。遠方からの前泊に便利な拠点。', target: 'direct', hotel: 0 },
  { name: '町田', x: 330, y: 209.75, access: 'JR横浜線で十日市場駅へ。駅から会場行きシャトルバスを利用。', feature: '駅周辺に宿泊施設や飲食店が集まるエリア。', target: 'yokohama-line', hotel: 0 },
  { name: '渋谷', x: 740, y: 170, access: '東急田園都市線で南町田グランベリーパーク駅へ。駅から会場行きシャトルバスを利用。', feature: '都内観光と花博を組み合わせたい人に便利な拠点。', target: 'denentoshi', hotel: 0 },
  { name: '海老名', x: 75, y: 500, access: '相鉄線で瀬谷駅・三ツ境駅へ。各駅から会場行きシャトルバスを利用。', feature: '神奈川西部の宿泊拠点。横浜中心部以外で宿を探したい人に。', target: 'sotetsu', hotel: 1 },
  { name: '武蔵小杉', x: 860, y: 290, access: '相鉄・JR直通線で相鉄線方面へ。列車の行き先と乗り換えをご確認ください。', feature: '都心や羽田方面からの移動にも使いやすい拠点。', target: 'direct', hotel: 1 },
];

const RAILWAY_LINES = [
  {
    id: 'sotetsu',
    name: '相鉄線（相鉄本線）沿線',
    station: '最寄りシャトルバス発着駅：瀬谷駅・三ツ境駅',
    summary: '会場に最も近い瀬谷駅・三ツ境駅へダイレクトにアクセスできる王道ルートです。',
    areas: [
      {
        area: '横浜駅・みなとみらいエリア',
        badge: '始発で座れる・観光も満喫',
        desc: '相鉄本線の始発「横浜駅」から瀬谷・三ツ境へ約20〜25分。ホテル数・飲食店ともに圧倒的に充実しています。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fyokohama.html',
      },
      {
        area: '海老名・大和エリア',
        badge: '会場アクセス最短・穴場',
        desc: '瀬谷駅まで約5〜10分。朝一番の入場を狙う前泊や、横浜中心部が満室時の回避先として優秀です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Febina.html',
      },
    ],
  },
  {
    id: 'direct',
    name: '相鉄・東急・JR（埼京線）直通線沿線',
    station: '最寄りシャトルバス発着駅：瀬谷駅・三ツ境駅（西谷乗り換え等）',
    summary: '新横浜や都心（渋谷・新宿方面）から乗り換え少なく相鉄線方面へ移動できるルートです。',
    areas: [
      {
        area: '新横浜エリア',
        badge: '新幹線＋直通線の最強拠点',
        desc: '東海道新幹線が停車し、相鉄・東急直通線でもJR横浜線でもアクセス可能。遠方組の前泊に最適です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fshinyokohama.html',
      },
      {
        area: '武蔵小杉・川崎エリア',
        badge: '都心・羽田方面からの拠点',
        desc: '東急・JR直通線の主要乗換駅。渋谷・品川・羽田空港方面からのアクセスが良く、ビジネスホテルも豊富です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fkawasaki.html',
      },
    ],
  },
  {
    id: 'yokohama-line',
    name: 'JR横浜線沿線',
    station: '最寄りシャトルバス発着駅：十日市場駅',
    summary: '新横浜や町田・八王子方面から「十日市場駅」のシャトルバスを利用するルートです。',
    areas: [
      {
        area: '町田エリア',
        badge: '十日市場駅へ約10分・宿が豊富',
        desc: '十日市場駅・南町田グランベリーパーク駅のどちらにも近く、駅周辺のビジネスホテルや飲食店が非常に充実しています。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fmachida.html',
      },
      {
        area: '新横浜エリア',
        badge: '新幹線直結・十日市場へ約15分',
        desc: 'JR横浜線で十日市場駅まで乗り換えなし約15分。新幹線利用の遠方組に最も選ばれる拠点です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fshinyokohama.html',
      },
      {
        area: 'みなとみらい・桜木町エリア',
        badge: '横浜線直通・観光と両立',
        desc: 'JR横浜線から根岸線直通で桜木町・関内へ乗り換えなし。花博とみなとみらい観光を1泊2日で満喫できます。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fyokohama.html',
      },
    ],
  },
  {
    id: 'denentoshi',
    name: '東急田園都市線沿線',
    station: '最寄りシャトルバス発着駅：南町田グランベリーパーク駅',
    summary: '渋谷・二子玉川方面から「南町田グランベリーパーク駅」のシャトルバスを利用するルートです。',
    areas: [
      {
        area: '渋谷・二子玉川エリア',
        badge: '都内観光と両立・急行で1本',
        desc: '急行で南町田グランベリーパーク駅へ直結。都内のホテルを拠点に花博へ日帰り感覚でアクセスできます。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fshibuya.html',
      },
      {
        area: '溝の口・新百合ヶ丘・町田周辺',
        badge: '神奈川寄りでコスパ重視',
        desc: '都心よりも宿泊費を抑えやすく、田園都市線沿線で朝スムーズに移動したい方におすすめです。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fmachida.html',
      },
    ],
  },
];
---

<Layout title={title} description={description} fullWidth>
  <article class="page">
    <nav class="breadcrumbs" aria-label="パンくずリスト">
      <a href="/">トップ</a><span aria-hidden="true"> / </span>
      <a href="/special/yokohama-expo-2027/">横浜花博特設ガイド</a><span aria-hidden="true"> / </span>
      <span>沿線別ホテル・前泊拠点</span>
    </nav>

    <header class="hero">
      <p class="eyebrow">HOTELS BY RAILWAY LINE</p>
      <h1>横浜花博 沿線別ホテル・前泊拠点ガイド</h1>
      <p>
        利用するシャトルバス発着駅に合わせて、4つの主要路線（相鉄線・相鉄東急/埼京線直通・JR横浜線・東急田園都市線）ごとに宿が探しやすいエリアを整理しました。
      </p>
    </header>

    <section class="map-section" aria-labelledby="access-map-title">
      <h2 id="access-map-title">路線図から宿泊エリアを探す</h2>
      <p>宿泊する駅から会場方面へのつながりを確認できます。オレンジ色は会場行きシャトルバスの発着駅です。</p>
      <p class="map-instruction">Hマークにマウスを合わせるか、タップすると宿泊エリアの紹介を見られます。</p>
      <div class="map-layout">
        <div class="map-image">
          <div class="map-canvas">
          <div class="map-svg" set:html={accessMap} />
          <svg class="map-labels" viewBox="0 0 1200 740" aria-hidden="true" focusable="false">
            {MAP_LABELS.map((label) => (
              <text x={label.x} y={label.y} text-anchor={label.anchor} class:list={['map-label', `map-label--${label.kind}`]}>{label.text}</text>
            ))}
          </svg>
          {MAP_AREAS.map((area) => (
            <button class="map-point" type="button" style={`left:${area.x / 12}%;top:${area.y / 7.4}%`} data-name={area.name} data-label-side={['新宿', '渋谷', '品川'].includes(area.name) ? 'left' : 'top'} data-access={area.access} data-feature={area.feature} data-url={STATION_URLS[area.name] ? affiliateUrl(STATION_URLS[area.name]) : RAILWAY_LINES.find((line) => line.id === area.target)?.areas[area.hotel].url} data-x={area.x} data-y={area.y} aria-label={`${area.name}の宿泊エリアを紹介`} aria-pressed="false"><span class="map-marker" aria-hidden="true">H</span><span class="map-point-label" aria-hidden="true">{area.name}</span></button>
          ))}
          </div>
          <div class="map-detail" id="map-detail" hidden aria-live="polite">
            <button type="button" class="map-close" aria-label="エリア紹介を閉じる">×</button>
            <svg class="map-illustration" viewBox="0 0 280 64" aria-hidden="true" focusable="false">
              <path d="M0 53H280" fill="none" stroke="#b6d8c0" stroke-width="2" />
              <path d="M23 53V23h28v30M33 23v-8h8v8M62 53V32h22v21M183 53V28h29v25M220 53V19h35v34" fill="#d4ead8" stroke="#80b894" stroke-width="2" stroke-linejoin="round" />
              <path d="M31 31h5m5 0h5m-15 8h5m5 0h5m-15 8h5m5 0h5M190 36h5m6 0h5m-16 8h5m6 0h5M228 27h6m6 0h6m-18 9h6m6 0h6m-18 9h6m6 0h6" fill="none" stroke="#80b894" stroke-width="2" stroke-linecap="round" />
              <path d="M98 53V32c0-6 5-11 11-11h36c6 0 11 5 11 11v21" fill="#fff" stroke="#38835b" stroke-width="2" />
              <path d="M106 29h18v11h-18zm24 0h18v11h-18z" fill="#d6edf1" stroke="#72a9a0" stroke-width="1.5" />
              <path d="M106 47h42M105 57l-4 4m48-4 4 4" fill="none" stroke="#38835b" stroke-width="2" stroke-linecap="round" />
              <circle cx="112" cy="48" r="2" fill="#d98e42" /><circle cx="142" cy="48" r="2" fill="#d98e42" />
              <path d="M166 53V40m-7 5c0-6 3-10 7-10s7 4 7 10-3 8-7 8-7-2-7-8z" fill="#a8d1ad" stroke="#76ae83" stroke-width="2" />
            </svg>
            <p class="map-detail-label">宿泊エリア</p>
            <h3 id="map-area-name"></h3>
            <p><strong>会場へのアクセス</strong><br /><span id="map-area-access"></span></p>
            <p><strong>エリアの特徴</strong><br /><span id="map-area-feature"></span></p>
            <a id="map-area-link" href="https://travel.rakuten.co.jp/" target="_blank" rel="noopener noreferrer sponsored">楽天トラベルでホテルを探す ↗</a>
          </div>
        </div>
      </div>
      <p class="map-caption">駅間距離や実際の経路とは異なる模式図です。直通運転は一部列車のみです。運行・予約の最新情報は各公式サイトをご確認ください。</p>
    </section>

    <nav class="line-nav" aria-label="路線別ショートカット">
      {RAILWAY_LINES.map((line) => (
        <a href={`#${line.id}`}>{line.name}</a>
      ))}
    </nav>

    {RAILWAY_LINES.map((line) => (
      <section class="block" id={line.id} aria-labelledby={`title-${line.id}`}>
        <div class="line-head">
          <h2 id={`title-${line.id}`}>{line.name}</h2>
          <p class="station-tag">{line.station}</p>
        </div>
        <p class="lead">{line.summary}</p>
        <div class="hotel-grid">
          {line.areas.map((item) => (
            <a class="hotel-card" href={item.url} target="_blank" rel="noopener noreferrer sponsored">
              <span class="badge">{item.badge}</span>
              <h3>{item.area}</h3>
              <p class="desc">{item.desc}</p>
              <span class="cta">楽天トラベルで空室・料金を見る ↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <nav class="sub-nav" aria-label="横浜花博 関連ガイド">
      <a href="/special/yokohama-expo-2027/">← 横浜花博 特設トップへ戻る</a>
      <a href="/special/yokohama-expo-2027/access/">アクセス・シャトルバス完全ガイド →</a>
      <a href="/special/yokohama-expo-2027/model-course/">モデルコース（日帰り・1泊2日） →</a>
    </nav>
  </article>
</Layout>

<style>
  .page { max-width: 1200px; margin: 0 auto; padding: 0 20px 64px; color: #172b23; }
  .breadcrumbs { padding: 16px 0; font-size: 12px; color: #52665c; }
  .breadcrumbs a { color: #166534; text-decoration: none; }
  .hero { padding: 28px 24px; background: linear-gradient(135deg, #ecfdf5 0%, #dcfce7 100%); border: 1px solid #bbf7d0; border-radius: 14px; }
  .eyebrow { margin: 0 0 8px; color: #15803d; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }
  .hero h1 { margin: 0 0 10px; color: #14532d; font-size: clamp(22px, 5vw, 30px); line-height: 1.35; }
  .hero p:last-child { margin: 0; font-size: 14px; line-height: 1.75; color: #1e3a2f; }
  .map-section { padding-top: 32px; }
  .map-section h2 { margin: 0 0 12px; font-size: 22px; line-height: 1.3; }
  .map-section p { line-height: 1.7; }
  .map-caption { color: #52665c; font-size: 13px; }
  .map-layout { position: relative; }
  .map-image { position: relative; min-width: 0; }
  .map-canvas { position: relative; }
  .map-svg :global(svg) { display: block; width: 100%; height: auto; }
  .map-labels { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .map-label { fill: #213841; font-size: 21px; font-weight: 700; paint-order: stroke; stroke: #fff; stroke-width: 6px; stroke-linejoin: round; }
  .map-label--station { font-size: 25px; }
  .map-label--minor { font-size: 16px; }
  .map-label--destination { fill: #fff; font-size: 19px; stroke: none; text-anchor: middle; }
  .map-point { position: absolute; transform: translate(-50%, -50%); width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .map-point .map-marker { display: flex; align-items: center; justify-content: center; box-sizing: border-box; width: 24px; height: 24px; margin: auto; border: 2px solid #fff; border-radius: 50%; background: #075e47; box-shadow: 0 0 0 1px #075e47; color: #fff; font-size: 13px; font-weight: 700; line-height: 1; }
  .map-point:hover .map-marker, .map-point[aria-pressed="true"] .map-marker { background: #123c30; box-shadow: 0 0 0 3px #a9d6ba; }
  .map-point-label { position: absolute; left: 50%; bottom: calc(50% + 16px); transform: translateX(-50%); color: #213841; font-size: clamp(12px, 1.9vw, 20px); font-weight: 700; line-height: 1.2; white-space: nowrap; pointer-events: none; text-shadow: -2px -2px #fff, 2px -2px #fff, -2px 2px #fff, 2px 2px #fff; }
  .map-point[data-label-side="left"] .map-point-label { left: auto; right: calc(50% + 16px); bottom: auto; top: 50%; transform: translateY(-50%); }
  .map-point:focus-visible { outline: 3px solid #14532d; outline-offset: 2px; }
  .map-detail { position: absolute; z-index: 3; left: var(--popup-x); top: var(--popup-y); width: min(320px, 90%); padding: 20px; background: #f1f8f1; border-radius: 12px; box-shadow: 0 8px 32px rgba(23, 43, 35, .24); }
  .map-detail[data-side="left"] { transform: translateX(-100%); }
  .map-detail[data-vertical="above"] { transform: translateY(-100%); }
  .map-detail[data-side="left"][data-vertical="above"] { transform: translate(-100%, -100%); }
  .map-detail[hidden] { display: none; }
  .map-close { position: absolute; top: 8px; right: 8px; width: 36px; height: 36px; border: 0; border-radius: 50%; background: #f0fdf4; color: #14532d; font-size: 24px; cursor: pointer; }
  .map-illustration { display: block; width: 100%; height: 64px; margin: 0 0 12px; }
  .map-detail-label { margin: 0 0 8px; color: #166534; font-size: 13px; font-weight: 700; }
  .map-detail h3 { margin: 0 0 8px; font-size: 18px; }
  .map-detail p { margin: 0 0 12px; font-size: 14px; }
  .map-detail a { display: block; padding: 12px; background: #166534; border-radius: 8px; color: #fff; font-size: 14px; font-weight: 700; text-align: center; text-decoration: none; }
  .map-instruction { color: #52665c; font-size: 14px; }
  @media (max-width: 800px) { .map-detail { position: relative; left: auto; top: auto; width: 100%; margin-top: 12px; } .map-detail[data-side][data-vertical] { transform: none; } .map-point { width: 36px; height: 36px; } .map-point .map-marker { width: 22px; height: 22px; font-size: 12px; } }
  .map-caption { margin: 8px 0; }
  .line-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 20px 0 4px; }
  .line-nav a { display: flex; align-items: center; justify-content: center; text-align: center; min-height: 44px; padding: 8px 10px; background: #f0fdf4; border: 1px solid #dcfce7; border-radius: 8px; color: #166534; font-size: 12px; font-weight: 700; text-decoration: none; }
  .line-nav a:hover { background: #dcfce7; }
  .block { padding-top: 32px; scroll-margin-top: 72px; }
  .line-head { border-bottom: 2px solid #16a34a; padding-bottom: 8px; margin-bottom: 10px; }
  .line-head h2 { margin: 0 0 4px; font-size: 20px; color: #14532d; }
  .station-tag { margin: 0; font-size: 12px; font-weight: 700; color: #15803d; }
  .lead { margin: 0 0 14px; font-size: 14px; color: #3f5248; line-height: 1.7; }
  .hotel-grid { display: grid; gap: 14px; }
  .hotel-card { display: block; padding: 18px; background: #fff; border: 1px solid #dce5df; border-radius: 12px; color: inherit; text-decoration: none; }
  .hotel-card:hover { border-color: #16a34a; box-shadow: 0 4px 12px rgba(20, 83, 45, 0.08); }
  .badge { display: inline-block; margin-bottom: 8px; padding: 3px 9px; background: #dcfce7; border-radius: 999px; font-size: 11px; font-weight: 700; color: #14532d; }
  .hotel-card h3 { margin: 0 0 6px; font-size: 17px; color: #14532d; }
  .desc { margin: 0 0 12px; font-size: 13px; line-height: 1.65; color: #3f5248; }
  .cta { font-size: 13px; font-weight: 700; color: #15803d; }
  .sub-nav { display: grid; gap: 10px; margin-top: 36px; padding: 20px; background: #f0fdf4; border-radius: 12px; }
  .sub-nav a { color: #15803d; font-size: 14px; font-weight: 700; text-decoration: none; }
  .sub-nav a:hover { text-decoration: underline; }
  @media (min-width: 600px) {
    .line-nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hotel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  const name = document.querySelector<HTMLElement>('#map-area-name');
  const access = document.querySelector<HTMLElement>('#map-area-access');
  const feature = document.querySelector<HTMLElement>('#map-area-feature');
  const link = document.querySelector<HTMLAnchorElement>('#map-area-link');
  const card = document.querySelector<HTMLElement>('#map-detail');
  const points = document.querySelectorAll<HTMLButtonElement>('.map-point');
  function selectArea(point: HTMLButtonElement) {
    if (!name || !access || !feature || !link || !card || !point.dataset.url) return;
    name.textContent = `${point.dataset.name}エリア`;
    access.textContent = point.dataset.access || '';
    feature.textContent = point.dataset.feature || '';
    link.href = point.dataset.url;
    const x = Number(point.dataset.x);
    const y = Number(point.dataset.y);
    card.style.setProperty('--popup-x', `${x / 12}%`);
    card.style.setProperty('--popup-y', `${y / 7.4}%`);
    card.dataset.side = x > 600 ? 'left' : 'right';
    card.dataset.vertical = y > 370 ? 'above' : 'below';
    card.hidden = false;
    points.forEach((item) => item.setAttribute('aria-pressed', String(item === point)));
  }
  function closeCard() {
    if (card) card.hidden = true;
    points.forEach((item) => item.setAttribute('aria-pressed', 'false'));
  }
  points.forEach((point) => {
    point.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') selectArea(point); });
    point.addEventListener('focus', () => selectArea(point));
    point.addEventListener('click', () => {
      selectArea(point);
      if (!window.matchMedia('(max-width: 800px)').matches) return;
      requestAnimationFrame(() => {
        const canvas = document.querySelector<HTMLElement>('.map-canvas');
        if (!card || card.hidden || !canvas) return;
        const cardBottom = card.getBoundingClientRect().bottom;
        const mapBottom = canvas.getBoundingClientRect().bottom;
        const needed = Math.max(0, cardBottom - window.innerHeight + 16);
        // Keep the bottom of the map visible even on a short screen.
        const room = Math.max(0, mapBottom - 96);
        const amount = Math.min(needed, room);
        if (amount > 0) {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollBy({ top: amount, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      });
    });
  });
  document.querySelector('.map-close')?.addEventListener('click', closeCard);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCard(); });
</script>
