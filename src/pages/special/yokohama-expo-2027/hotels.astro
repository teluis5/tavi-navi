<script>
  const checkin = document.querySelector<HTMLInputElement>('#hotel-checkin');
  const checkout = document.querySelector<HTMLInputElement>('#hotel-checkout');
  const formatDate = (date: Date) => `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, '0')}-${String(date.getDate()).padStart(2, '0')}`;
  if (checkin && checkout) {
    const today = new Date();
    const tomorrow = new Date(today.getFullYear(), today.getMonth(), today.getDate() + 1);
    checkin.min = formatDate(today);
    checkin.value = formatDate(today);
    checkout.min = formatDate(tomorrow);
    checkout.value = formatDate(tomorrow);
    checkin.addEventListener('change', () => {
      if (!checkin.value) return;
      const [year, month, day] = checkin.value.split('-').map(Number);
      const next = formatDate(new Date(year, month - 1, day + 1));
      checkout.min = next;
      if (!checkout.value || checkout.value < next) checkout.value = next;
    });
  }
  const priceStatus = document.querySelector<HTMLElement>('#hotel-price-status');
  const priceEndpoint = 'https://teluis-expo-hotel-prices.expo-price-cache.workers.dev';
  const areaPrice = document.querySelector<HTMLElement>('#map-area-price');
  let priceRequest = 0;
  async function updateAreaPrice(point: HTMLButtonElement) {
    const request = ++priceRequest;
    if (!areaPrice || !checkin || !checkout) return;
    const start = Date.parse(`${checkin.value}T00:00:00Z`);
    const end = Date.parse(`${checkout.value}T00:00:00Z`);
    if (!Number.isFinite(start) || end - start !== 86400000) {
      areaPrice.textContent = '目安料金は大人2名・1室の1泊に対応しています。';
      return;
    }
    areaPrice.textContent = '目安料金を確認しています。';
    try {
      const url = new URL('/price', priceEndpoint);
      url.searchParams.set('date', checkin.value);
      url.searchParams.set('station', point.dataset.code || '');
      const response = await fetch(url, { cache: 'no-store' });
      if (!response.ok) throw new Error('unavailable');
      const data = await response.json();
      if (request !== priceRequest) return;
      if (!Number.isFinite(data.price) || data.price <= 0 || !Number.isFinite(data.fetchedAt) || Date.now() - data.fetchedAt >= 86400000 || data.fetchedAt > Date.now()) {
        areaPrice.textContent = 'この日の目安料金はご案内できません。空室・料金はリンク先で確認できます。';
        return;
      }
      const checked = new Intl.DateTimeFormat('ja-JP', { timeZone: 'Asia/Tokyo', month: 'numeric', day: 'numeric', hour: '2-digit', minute: '2-digit' }).format(new Date(data.fetchedAt));
      areaPrice.textContent = `ツインの目安：${data.price.toLocaleString('ja-JP')}円（大人2名・1室・1泊、${checked}取得）。確認できたプランの一例です。価格や空室は変わります。予約時の楽天トラベルの表示をご確認ください。`;
    } catch {
      if (request === priceRequest) areaPrice.textContent = '目安料金を取得できませんでした。空室・料金はリンク先で確認できます。';
    }
  }
  const bookingUrl = (station: HTMLElement): string | null => {
    if (!checkin || !checkout || !checkin.value || !checkout.value || checkin.value < checkin.min || checkout.value <= checkin.value) return null;
    const { code, lat, lon } = station.dataset;
    if (!code || !lat || !lon) return null;
    const [yearIn, monthIn, dayIn] = checkin.value.split('-');
    const [yearOut, monthOut, dayOut] = checkout.value.split('-');
    const params = new URLSearchParams({
      f_eki: code, f_key: `${code}%2C${lat.replace('.', '')}%2C${lon.replace('.', '')}`,
      f_teikei: 'ensen', f_nen1: yearIn, f_tuki1: monthIn, f_hi1: dayIn,
      f_nen2: yearOut, f_tuki2: monthOut, f_hi2: dayOut,
      f_otona_su: '2', f_heya_su: '1', f_km: '1.0',
    });
    const target = `https://search.travel.rakuten.co.jp/ds/station/ensen?${params}`;
    return `https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=${encodeURIComponent(target)}`;
  };
  const updateLinks = () => {
    if (priceStatus && checkin?.value && checkout?.value && checkin.value >= checkin.min && checkout.value > checkin.value) priceStatus.textContent = '大人2名・1室で検索します。ツインなどの部屋タイプは検索先で選べます。';
    const selected = document.querySelector<HTMLButtonElement>('.map-point[aria-pressed="true"]');
    const popupLink = document.querySelector<HTMLAnchorElement>('#map-area-link');
    if (selected && popupLink) popupLink.href = bookingUrl(selected) || 'https://travel.rakuten.co.jp/';
    if (selected) void updateAreaPrice(selected);
  };
  const requireDates = (event: MouseEvent) => {
    if (checkin?.value && checkout?.value && checkin.value >= checkin.min && checkout.value > checkin.value) return;
    event.preventDefault();
    if (priceStatus) priceStatus.textContent = '本日以降のチェックイン日と、それより後のチェックアウト日を選んでください。';
    checkin?.focus();
  };
  document.querySelector<HTMLAnchorElement>('#map-area-link')?.addEventListener('click', requireDates);
  checkin?.addEventListener('change', updateLinks);
  checkout?.addEventListener('change', updateLinks);
  updateLinks();
  const name = document.querySelector<HTMLElement>('#map-area-name');
  const access = document.querySelector<HTMLElement>('#map-area-access');
  const minutes = document.querySelector<HTMLElement>('#map-area-minutes');
  const feature = document.querySelector<HTMLElement>('#map-area-feature');
  const directBus = document.querySelector<HTMLElement>('#map-direct-bus');
  const busRoute = document.querySelector<SVGPathElement>('#map-bus-route');
  const link = document.querySelector<HTMLAnchorElement>('#map-area-link');
  const card = document.querySelector<HTMLElement>('#map-detail');
  const points = document.querySelectorAll<HTMLButtonElement>('.map-point');
  function selectArea(point: HTMLButtonElement) {
    if (!name || !access || !feature || !link || !card) return;
    name.textContent = `${point.dataset.name}エリア`;
    access.textContent = point.dataset.access || '';
    if (minutes) minutes.textContent = Number(point.dataset.minutes) > 0 ? `約${point.dataset.minutes}分` : '';
    if (directBus) {
      directBus.hidden = point.dataset.directBus !== 'true' || Number(point.dataset.minutes) === 0;
      directBus.textContent = ['みなとみらい', '関内', '桜木町'].includes(point.dataset.name || '') ? '横浜都心臨海部からの直行バスを運行予定。乗り場・時刻などは調整中です。' : `${point.dataset.name}からの直行バスを運行予定。乗り場・時刻などは調整中です。`;
    }
    feature.textContent = point.dataset.feature || '';
    link.href = bookingUrl(point) || 'https://travel.rakuten.co.jp/';
    const x = Number(point.dataset.x);
    const y = Number(point.dataset.y);
    if (busRoute) {
      const curveY = y > 370 ? Math.max(y, 395) + 100 : Math.min(y, 395) - 100;
      busRoute.setAttribute('d', `M ${x} ${y} Q ${(x + 380.4) / 2} ${curveY} 380.4 395`);
      busRoute.style.display = point.dataset.directBus === 'true' ? '' : 'none';
      busRoute.removeAttribute('hidden');
    }
    card.style.setProperty('--popup-x', `${(x + 40) / 12.8}%`);
    card.style.setProperty('--popup-y', `${y / 7.4}%`);
    card.dataset.side = x > 600 ? 'left' : 'right';
    card.dataset.vertical = y > 370 ? 'above' : 'below';
    card.hidden = false;
    points.forEach((item) => item.setAttribute('aria-pressed', String(item === point)));
    void updateAreaPrice(point);
  }
  function closeCard() {
    priceRequest++;
    if (busRoute) busRoute.style.display = 'none';
    if (card) card.hidden = true;
    points.forEach((item) => item.setAttribute('aria-pressed', 'false'));
  }
  points.forEach((point) => {
    point.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') selectArea(point); });
    point.addEventListener('focus', () => selectArea(point));
    point.addEventListener('click', () => {
      selectArea(point);
      if (!window.matchMedia('(max-width: 800px)').matches) return;
      requestAnimationFrame(() => {
        const canvas = document.querySelector<HTMLElement>('.map-canvas');
        if (!card || card.hidden || !canvas) return;
        const cardBottom = card.getBoundingClientRect().bottom;
        const mapBottom = canvas.getBoundingClientRect().bottom;
        const needed = Math.max(0, cardBottom - window.innerHeight + 16);
        // Keep the bottom of the map visible even on a short screen.
        const room = Math.max(0, mapBottom - 96);
        const amount = Math.min(needed, room);
        if (amount > 0) {
          const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
          window.scrollBy({ top: amount, behavior: reduceMotion ? 'auto' : 'smooth' });
        }
      });
    });
  });
  const mobileMap = window.matchMedia('(max-width: 600px)');
  function showMapGroup(selected: string) {
    closeCard();
    points.forEach((point) => { point.hidden = selected.startsWith('main-') ? point.dataset.mapGroup !== 'main' || point.dataset.mobileGroup !== selected : point.dataset.mapGroup !== selected; });
    document.querySelectorAll<HTMLButtonElement>('.map-group').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.mapGroup === selected)));
  }
  document.querySelectorAll<HTMLButtonElement>('.map-group').forEach((group) => {
    group.addEventListener('click', () => {
      showMapGroup(group.dataset.mapGroup || 'main');
    });
  });
  showMapGroup(mobileMap.matches ? 'main-west' : 'main');
  mobileMap.addEventListener('change', () => showMapGroup(mobileMap.matches ? 'main-west' : 'main'));
  document.querySelector('.map-close')?.addEventListener('click', closeCard);
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeCard(); });
</script>
