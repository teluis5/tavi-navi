---
import Layout from '../../../layouts/Layout.astro';
import accessMap from '../../../content/blog/yokohama-expo-2027-hotels/green-expo-access.svg?raw';

const title = '横浜花博（GREEN×EXPO 2027）沿線別ホテル・前泊拠点ガイド｜楽天トラベル予約';
const description =
  '横浜花博（GREEN×EXPO 2027）に便利な周辺ホテルを沿線別に紹介。相鉄線・相鉄東急/埼京線直通・JR横浜線・東急田園都市線の4路線ごとに、シャトルバス発着駅とおすすめ宿泊エリア（楽天トラベル）をまとめました。';

const MAP_AREAS = [
  { name: '横浜', x: 910, y: 715, text: '相鉄線で瀬谷・三ツ境方面へ。横浜観光も楽しみたい人の拠点に。', target: 'sotetsu' },
  { name: '新横浜', x: 760, y: 565, text: '新幹線の停車駅。JR横浜線や相鉄・東急直通線を利用できます。', target: 'direct' },
  { name: '町田', x: 110, y: 355, text: 'JR横浜線で十日市場方面へ移動でき、飲食店や宿泊施設も探せます。', target: 'yokohama-line' },
  { name: '渋谷', x: 800, y: 260, text: '東急田園都市線で南町田グランベリーパーク方面へ。都内観光と組み合わせたい人に。', target: 'denentoshi' },
  { name: '海老名', x: 45, y: 715, text: '相鉄線で瀬谷・三ツ境方面へ向かえる、神奈川西部の宿泊拠点です。', target: 'sotetsu' },
  { name: '武蔵小杉', x: 795, y: 490, text: '相鉄方面への直通列車が利用できる駅。列車の行き先や乗り換えをご確認ください。', target: 'direct' },
];

const RAILWAY_LINES = [
  {
    id: 'sotetsu',
    name: '相鉄線（相鉄本線）沿線',
    station: '最寄りシャトルバス発着駅：瀬谷駅・三ツ境駅',
    summary: '会場に最も近い瀬谷駅・三ツ境駅へダイレクトにアクセスできる王道ルートです。',
    areas: [
      {
        area: '横浜駅・みなとみらいエリア',
        badge: '始発で座れる・観光も満喫',
        desc: '相鉄本線の始発「横浜駅」から瀬谷・三ツ境へ約20〜25分。ホテル数・飲食店ともに圧倒的に充実しています。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fyokohama.html',
      },
      {
        area: '海老名・大和エリア',
        badge: '会場アクセス最短・穴場',
        desc: '瀬谷駅まで約5〜10分。朝一番の入場を狙う前泊や、横浜中心部が満室時の回避先として優秀です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Febina.html',
      },
    ],
  },
  {
    id: 'direct',
    name: '相鉄・東急・JR（埼京線）直通線沿線',
    station: '最寄りシャトルバス発着駅：瀬谷駅・三ツ境駅（西谷乗り換え等）',
    summary: '新横浜や都心（渋谷・新宿方面）から乗り換え少なく相鉄線方面へ移動できるルートです。',
    areas: [
      {
        area: '新横浜エリア',
        badge: '新幹線＋直通線の最強拠点',
        desc: '東海道新幹線が停車し、相鉄・東急直通線でもJR横浜線でもアクセス可能。遠方組の前泊に最適です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fshinyokohama.html',
      },
      {
        area: '武蔵小杉・川崎エリア',
        badge: '都心・羽田方面からの拠点',
        desc: '東急・JR直通線の主要乗換駅。渋谷・品川・羽田空港方面からのアクセスが良く、ビジネスホテルも豊富です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fkawasaki.html',
      },
    ],
  },
  {
    id: 'yokohama-line',
    name: 'JR横浜線沿線',
    station: '最寄りシャトルバス発着駅：十日市場駅',
    summary: '新横浜や町田・八王子方面から「十日市場駅」のシャトルバスを利用するルートです。',
    areas: [
      {
        area: '町田エリア',
        badge: '十日市場駅へ約10分・宿が豊富',
        desc: '十日市場駅・南町田グランベリーパーク駅のどちらにも近く、駅周辺のビジネスホテルや飲食店が非常に充実しています。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fmachida.html',
      },
      {
        area: '新横浜エリア',
        badge: '新幹線直結・十日市場へ約15分',
        desc: 'JR横浜線で十日市場駅まで乗り換えなし約15分。新幹線利用の遠方組に最も選ばれる拠点です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fshinyokohama.html',
      },
      {
        area: 'みなとみらい・桜木町エリア',
        badge: '横浜線直通・観光と両立',
        desc: 'JR横浜線から根岸線直通で桜木町・関内へ乗り換えなし。花博とみなとみらい観光を1泊2日で満喫できます。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fyokohama.html',
      },
    ],
  },
  {
    id: 'denentoshi',
    name: '東急田園都市線沿線',
    station: '最寄りシャトルバス発着駅：南町田グランベリーパーク駅',
    summary: '渋谷・二子玉川方面から「南町田グランベリーパーク駅」のシャトルバスを利用するルートです。',
    areas: [
      {
        area: '渋谷・二子玉川エリア',
        badge: '都内観光と両立・急行で1本',
        desc: '急行で南町田グランベリーパーク駅へ直結。都内のホテルを拠点に花博へ日帰り感覚でアクセスできます。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fshibuya.html',
      },
      {
        area: '溝の口・新百合ヶ丘・町田周辺',
        badge: '神奈川寄りでコスパ重視',
        desc: '都心よりも宿泊費を抑えやすく、田園都市線沿線で朝スムーズに移動したい方におすすめです。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/5953a273.5cc8e490.5953a274.81eca08c/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fmachida.html',
      },
    ],
  },
];
---

<Layout title={title} description={description} fullWidth>
  <article class="page">
    <nav class="breadcrumbs" aria-label="パンくずリスト">
      <a href="/">トップ</a><span aria-hidden="true"> / </span>
      <a href="/special/yokohama-expo-2027/">横浜花博特設ガイド</a><span aria-hidden="true"> / </span>
      <span>沿線別ホテル・前泊拠点</span>
    </nav>

    <header class="hero">
      <p class="eyebrow">HOTELS BY RAILWAY LINE</p>
      <h1>横浜花博 沿線別ホテル・前泊拠点ガイド</h1>
      <p>
        利用するシャトルバス発着駅に合わせて、4つの主要路線（相鉄線・相鉄東急/埼京線直通・JR横浜線・東急田園都市線）ごとに宿が探しやすいエリアを整理しました。
      </p>
    </header>

    <section class="map-section" aria-labelledby="access-map-title">
      <h2 id="access-map-title">路線図から宿泊エリアを探す</h2>
      <p>宿泊する駅から、会場行きシャトルバスの発着駅までのつながりを確認できます。オレンジ色の駅が発着駅です。</p>
      <p class="map-instruction">駅にマウスを合わせるか、タップすると宿泊エリアの紹介を見られます。</p>
      <div class="map-layout">
        <div class="map-image">
          <div class="map-svg" set:html={accessMap} />
          {MAP_AREAS.map((area) => (
            <button class="map-point" type="button" style={`left:${area.x / 12}%;top:${area.y / 8.5}%`} data-name={area.name} data-text={area.text} data-target={area.target} aria-label={`${area.name}の宿泊エリアを紹介`} aria-pressed="false"><span aria-hidden="true"></span></button>
          ))}
        </div>
        <div class="map-detail" aria-live="polite">
          <p class="map-detail-label">宿泊エリア</p>
          <h3 id="map-area-name">駅を選んでください</h3>
          <p id="map-area-text">地図上の丸印から、宿泊拠点の特徴を確認できます。</p>
          <a id="map-area-link" href="#sotetsu" hidden>沿線のホテルを見る →</a>
        </div>
      </div>
      <p class="map-caption">駅間距離や実際の経路とは異なる模式図です。直通運転は一部列車のみです。運行・予約の最新情報は各公式サイトをご確認ください。</p>
    </section>

    <nav class="line-nav" aria-label="路線別ショートカット">
      {RAILWAY_LINES.map((line) => (
        <a href={`#${line.id}`}>{line.name}</a>
      ))}
    </nav>

    {RAILWAY_LINES.map((line) => (
      <section class="block" id={line.id} aria-labelledby={`title-${line.id}`}>
        <div class="line-head">
          <h2 id={`title-${line.id}`}>{line.name}</h2>
          <p class="station-tag">{line.station}</p>
        </div>
        <p class="lead">{line.summary}</p>
        <div class="hotel-grid">
          {line.areas.map((item) => (
            <a class="hotel-card" href={item.url} target="_blank" rel="noopener noreferrer sponsored">
              <span class="badge">{item.badge}</span>
              <h3>{item.area}</h3>
              <p class="desc">{item.desc}</p>
              <span class="cta">楽天トラベルで空室・料金を見る ↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}

    <nav class="sub-nav" aria-label="横浜花博 関連ガイド">
      <a href="/special/yokohama-expo-2027/">← 横浜花博 特設トップへ戻る</a>
      <a href="/special/yokohama-expo-2027/access/">アクセス・シャトルバス完全ガイド →</a>
      <a href="/special/yokohama-expo-2027/model-course/">モデルコース（日帰り・1泊2日） →</a>
    </nav>
  </article>
</Layout>

<style>
  .page { max-width: 1200px; margin: 0 auto; padding: 0 20px 64px; color: #172b23; }
  .breadcrumbs { padding: 16px 0; font-size: 12px; color: #52665c; }
  .breadcrumbs a { color: #166534; text-decoration: none; }
  .hero { padding: 28px 24px; background: linear-gradient(135deg, #ecfdf5 0%, #dcfce7 100%); border: 1px solid #bbf7d0; border-radius: 14px; }
  .eyebrow { margin: 0 0 8px; color: #15803d; font-size: 12px; font-weight: 700; letter-spacing: 0.08em; }
  .hero h1 { margin: 0 0 10px; color: #14532d; font-size: clamp(22px, 5vw, 30px); line-height: 1.35; }
  .hero p:last-child { margin: 0; font-size: 14px; line-height: 1.75; color: #1e3a2f; }
  .map-section { padding-top: 32px; }
  .map-section h2 { margin: 0 0 12px; font-size: 22px; line-height: 1.3; }
  .map-section p { line-height: 1.7; }
  .map-caption { color: #52665c; font-size: 13px; }
  .map-layout { display: grid; grid-template-columns: minmax(0, 1fr) 240px; gap: 24px; align-items: start; }
  .map-image { position: relative; min-width: 0; }
  .map-svg :global(svg) { display: block; width: 100%; height: auto; }
  .map-point { position: absolute; transform: translate(-50%, -50%); width: 36px; height: 36px; padding: 0; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .map-point span { display: block; width: 22px; height: 22px; margin: auto; border: 2px solid #14532d; border-radius: 50%; background: rgba(220, 252, 231, .45); }
  .map-point:hover span, .map-point[aria-pressed="true"] span { background: rgba(22, 163, 74, .35); box-shadow: 0 0 0 3px white; }
  .map-point:focus-visible { outline: 3px solid #14532d; outline-offset: 2px; }
  .map-detail { padding: 20px; background: #f0fdf4; border-radius: 8px; }
  .map-detail-label { margin: 0 0 8px; color: #166534; font-size: 13px; font-weight: 700; }
  .map-detail h3 { margin: 0 0 8px; font-size: 18px; }
  .map-detail p { margin: 0 0 12px; font-size: 14px; }
  .map-detail a { color: #166534; font-weight: 700; }
  .map-instruction { color: #52665c; font-size: 14px; }
  @media (max-width: 800px) { .map-layout { grid-template-columns: minmax(0, 1fr); gap: 12px; } .map-point { width: 30px; height: 30px; } .map-point span { width: 18px; height: 18px; } }
  .map-caption { margin: 8px 0; }
  .line-nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; margin: 20px 0 4px; }
  .line-nav a { display: flex; align-items: center; justify-content: center; text-align: center; min-height: 44px; padding: 8px 10px; background: #f0fdf4; border: 1px solid #dcfce7; border-radius: 8px; color: #166534; font-size: 12px; font-weight: 700; text-decoration: none; }
  .line-nav a:hover { background: #dcfce7; }
  .block { padding-top: 32px; scroll-margin-top: 72px; }
  .line-head { border-bottom: 2px solid #16a34a; padding-bottom: 8px; margin-bottom: 10px; }
  .line-head h2 { margin: 0 0 4px; font-size: 20px; color: #14532d; }
  .station-tag { margin: 0; font-size: 12px; font-weight: 700; color: #15803d; }
  .lead { margin: 0 0 14px; font-size: 14px; color: #3f5248; line-height: 1.7; }
  .hotel-grid { display: grid; gap: 14px; }
  .hotel-card { display: block; padding: 18px; background: #fff; border: 1px solid #dce5df; border-radius: 12px; color: inherit; text-decoration: none; }
  .hotel-card:hover { border-color: #16a34a; box-shadow: 0 4px 12px rgba(20, 83, 45, 0.08); }
  .badge { display: inline-block; margin-bottom: 8px; padding: 3px 9px; background: #dcfce7; border-radius: 999px; font-size: 11px; font-weight: 700; color: #14532d; }
  .hotel-card h3 { margin: 0 0 6px; font-size: 17px; color: #14532d; }
  .desc { margin: 0 0 12px; font-size: 13px; line-height: 1.65; color: #3f5248; }
  .cta { font-size: 13px; font-weight: 700; color: #15803d; }
  .sub-nav { display: grid; gap: 10px; margin-top: 36px; padding: 20px; background: #f0fdf4; border-radius: 12px; }
  .sub-nav a { color: #15803d; font-size: 14px; font-weight: 700; text-decoration: none; }
  .sub-nav a:hover { text-decoration: underline; }
  @media (min-width: 600px) {
    .line-nav { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .hotel-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>

<script>
  const name = document.querySelector<HTMLElement>('#map-area-name');
  const text = document.querySelector<HTMLElement>('#map-area-text');
  const link = document.querySelector<HTMLAnchorElement>('#map-area-link');
  const points = document.querySelectorAll<HTMLButtonElement>('.map-point');
  function selectArea(point: HTMLButtonElement) {
    if (!name || !text || !link) return;
    name.textContent = `${point.dataset.name}エリア`;
    text.textContent = point.dataset.text || '';
    link.href = `#${point.dataset.target}`;
    link.hidden = false;
    points.forEach((item) => item.setAttribute('aria-pressed', String(item === point)));
  }
  points.forEach((point) => {
    point.addEventListener('pointerenter', (event) => { if (event.pointerType === 'mouse') selectArea(point); });
    point.addEventListener('focus', () => selectArea(point));
    point.addEventListener('click', () => selectArea(point));
  });
</script>
