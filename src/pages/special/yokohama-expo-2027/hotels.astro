---
import Layout from '../../../layouts/Layout.astro';
import accessMap from '../../../content/blog/yokohama-expo-2027-hotels/green-expo-access.svg?raw';

const title = '横浜花博（GREEN×EXPO 2027）沿線別ホテル・前泊拠点ガイド｜楽天トラベル予約';
const description =
  '横浜花博（GREEN×EXPO 2027）に便利な周辺ホテルを沿線別に紹介。相鉄線・相鉄東急/埼京線直通・JR横浜線・東急田園都市線の4路線ごとに、シャトルバス発着駅とおすすめ宿泊エリア（楽天トラベル）をまとめました。';

const STATIONS: Record<string, { code: string; lat: string; lon: string }> = {
  八王子: { code: '2803', lat: '128348.16', lon: '501632.21' },
  橋本: { code: '2795', lat: '128129.83', lon: '501653.59' },
  大和: { code: '3232', lat: '127679.22', lon: '502072.85' },
  桜木町: { code: '2186', lat: '127606.47', lon: '502682.63' },
  新宿: { code: '2334', lat: '128473.30', lon: '502932.59' },
  品川: { code: '2236', lat: '128250.75', lon: '503070.84' },
  横浜: { code: '3260', lat: '127666.41', lon: '502652.78' },
  新横浜: { code: '2370', lat: '127815.16', lon: '502635.07' },
  町田: { code: '3034', lat: '127939.91', lon: '502014.89' },
  渋谷: { code: '2248', lat: '128356.88', lon: '502939.51' },
  海老名: { code: '1674', lat: '127618.22', lon: '501819.96' },
  武蔵小杉: { code: '3146', lat: '128061.07', lon: '502786.20' },
  みなとみらい: { code: '9313', lat: '127637.27', lon: '502687.64' },
  関内: { code: '1925', lat: '127587.35', lon: '502700.78' },
  羽田空港: { code: '9624', lat: '127950.59', lon: '503173.05' },
