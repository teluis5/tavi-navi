const MAP_LABELS = [
  {
    "text": "東京",
    "x": 1060.0,
    "y": 95.0,
    "anchor": "end",
    "kind": "station"
  },
  {
    "text": "花博",
    "x": 420.0,
    "y": 391.0,
    "anchor": "start",
    "kind": "destination"
  },
  {
    "text": "会場",
    "x": 420.0,
    "y": 409.0,
    "anchor": "start",
    "kind": "destination"
  },
  {
    "text": "成田空港",
    "x": 1120.0,
    "y": 72.0,
    "anchor": "end",
    "kind": "minor"
  },
  {
    "text": "名古屋・新大阪方面",
    "x": 445.0,
    "y": 576.0,
    "anchor": "start",
    "kind": "minor"
  }
];

const DIRECT_BUS_AREAS = new Set(['新横浜', '横浜', 'みなとみらい', '関内', '桜木町', '羽田空港']);
const MAP_AREAS = [
  { name: '八王子', x: 80, y: 97.25, access: 'JR横浜線（約34分）→ 十日市場駅 → シャトルバス（約25分）', accessMinutes: 70, feature: '多摩エリアからの移動や八王子周辺の宿泊に便利な拠点。', target: 'yokohama-line', hotel: 0 },
  { name: '橋本', x: 205, y: 153.5, access: 'JR横浜線（約22分）→ 十日市場駅 → シャトルバス（約25分）', accessMinutes: 60, feature: 'JR横浜線・相模線と京王相模原線が乗り入れる宿泊拠点。', target: 'yokohama-line', hotel: 0 },
  { name: '大和', x: 205, y: 500, access: '相鉄線（約2分）→ 瀬谷駅 → シャトルバス（約10分）', accessMinutes: 25, feature: '会場に近い相鉄線沿線の宿泊拠点。駅周辺でホテルを探せます。', target: 'sotetsu', hotel: 1 },
  { name: '桜木町', x: 1095, y: 554, access: 'JR横浜線直通（約28分）→ 十日市場駅 → シャトルバス（約25分）', accessMinutes: 65, feature: 'みなとみらい観光と花博を組み合わせやすいエリア。', target: 'yokohama-line', hotel: 2 },
  { name: 'みなとみらい', x: 1150, y: 590, access: '横浜都心臨海部から会場への直行バスを運行予定。乗り場は調整中です。', accessMinutes: 0, feature: 'みなとみらい観光と花博を組み合わせたい人に。', target: 'yokohama-line', hotel: 2 },
  { name: '関内', x: 1050, y: 650, access: '横浜都心臨海部から会場への直行バスを運行予定。乗り場は調整中です。', accessMinutes: 0, feature: '関内や横浜中華街周辺の観光を楽しみたい人に。', target: 'yokohama-line', hotel: 2 },
  { name: '羽田空港', x: 1130, y: 380, access: '羽田空港から会場への直行バスを運行予定。発着ターミナルは調整中です。', accessMinutes: 0, feature: '飛行機で到着する日や出発する日の前泊に便利な空港周辺。', target: 'direct', hotel: 0 },
  { name: '新宿', x: 900, y: 100, access: '相鉄・JR直通線（約50分）→ 瀬谷駅 → シャトルバス（約10分）', accessMinutes: 70, feature: '都内観光も楽しみたい人に便利な宿泊拠点。', target: 'direct', hotel: 0 },
  { name: '品川', x: 1080, y: 220, access: '京急線（約17分）→ 横浜駅 → 相鉄線（約22分）→ 瀬谷駅 → シャトルバス（約10分）', accessMinutes: 70, feature: '新幹線や羽田空港からのアクセスを重視する人に便利な拠点。', target: 'direct', hotel: 0 },
  { name: '横浜', x: 975, y: 500, access: '相鉄線（約22分）→ 瀬谷駅 → シャトルバス（約10分）', accessMinutes: 45, feature: 'ホテルや飲食店が多く、みなとみらい観光と組み合わせやすいエリア。', target: 'sotetsu', hotel: 0 },
  { name: '新横浜', x: 765, y: 405.5, access: 'JR横浜線（約12分）→ 十日市場駅 → シャトルバス（約25分）', accessMinutes: 50, feature: '東海道新幹線の停車駅。遠方からの前泊に便利な拠点。', target: 'direct', hotel: 0 },
  { name: '町田', x: 330, y: 209.75, access: 'JR横浜線（約8分）→ 十日市場駅 → シャトルバス（約25分）', accessMinutes: 45, feature: '駅周辺に宿泊施設や飲食店が集まるエリア。', target: 'yokohama-line', hotel: 0 },
  { name: '渋谷', x: 900, y: 170, access: '東急田園都市線・急行（約36分）→ 南町田グランベリーパーク駅 → シャトルバス（約20分）', accessMinutes: 70, feature: '都内観光と花博を組み合わせたい人に便利な拠点。', target: 'denentoshi', hotel: 0 },
  { name: '海老名', x: 75, y: 500, access: '相鉄線（約12分）→ 瀬谷駅 → シャトルバス（約10分）', accessMinutes: 35, feature: '神奈川西部の宿泊拠点。横浜中心部以外で宿を探したい人に。', target: 'sotetsu', hotel: 1 },
  { name: '武蔵小杉', x: 800, y: 290, access: '相鉄・JR直通線（約35分）→ 瀬谷駅 → シャトルバス（約10分）', accessMinutes: 55, feature: '都心や羽田方面からの移動にも使いやすい拠点。', target: 'direct', hotel: 1 },
];

const RAILWAY_LINES = [
  {
    id: 'sotetsu',
    name: '相鉄線（相鉄本線）沿線',
    station: '最寄りシャトルバス発着駅：瀬谷駅・三ツ境駅',
    summary: '会場に最も近い瀬谷駅・三ツ境駅へダイレクトにアクセスできる王道ルートです。',
    areas: [
      {
        area: '横浜駅・みなとみらいエリア',
        badge: '始発で座れる・観光も満喫',
        desc: '相鉄本線の始発「横浜駅」から瀬谷・三ツ境へ約20〜25分。ホテル数・飲食店ともに圧倒的に充実しています。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fyokohama.html',
      },
      {
        area: '海老名・大和エリア',
        badge: '会場アクセス最短・穴場',
        desc: '瀬谷駅まで約5〜10分。朝一番の入場を狙う前泊や、横浜中心部が満室時の回避先として優秀です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Febina.html',
      },
    ],
  },
  {
    id: 'direct',
    name: '相鉄・東急・JR（埼京線）直通線沿線',
    station: '最寄りシャトルバス発着駅：瀬谷駅・三ツ境駅（西谷乗り換え等）',
    summary: '新横浜や都心（渋谷・新宿方面）から乗り換え少なく相鉄線方面へ移動できるルートです。',
    areas: [
      {
        area: '新横浜エリア',
        badge: '新幹線＋直通線の最強拠点',
        desc: '東海道新幹線が停車し、相鉄・東急直通線でもJR横浜線でもアクセス可能。遠方組の前泊に最適です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fshinyokohama.html',
      },
      {
        area: '武蔵小杉・川崎エリア',
        badge: '都心・羽田方面からの拠点',
        desc: '東急・JR直通線の主要乗換駅。渋谷・品川・羽田空港方面からのアクセスが良く、ビジネスホテルも豊富です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fkawasaki.html',
      },
    ],
  },
  {
    id: 'yokohama-line',
    name: 'JR横浜線沿線',
    station: '最寄りシャトルバス発着駅：十日市場駅',
    summary: '新横浜や町田・八王子方面から「十日市場駅」のシャトルバスを利用するルートです。',
    areas: [
      {
        area: '町田エリア',
        badge: '十日市場駅へ約10分・宿が豊富',
        desc: '十日市場駅・南町田グランベリーパーク駅のどちらにも近く、駅周辺のビジネスホテルや飲食店が非常に充実しています。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fmachida.html',
      },
      {
        area: '新横浜エリア',
        badge: '新幹線直結・十日市場へ約15分',
        desc: 'JR横浜線で十日市場駅まで乗り換えなし約15分。新幹線利用の遠方組に最も選ばれる拠点です。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fshinyokohama.html',
      },
      {
        area: 'みなとみらい・桜木町エリア',
        badge: '横浜線直通・観光と両立',
        desc: 'JR横浜線から根岸線直通で桜木町・関内へ乗り換えなし。花博とみなとみらい観光を1泊2日で満喫できます。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Fkanagawa%2Fyokohama.html',
      },
    ],
  },
  {
    id: 'denentoshi',
    name: '東急田園都市線沿線',
    station: '最寄りシャトルバス発着駅：南町田グランベリーパーク駅',
    summary: '渋谷・二子玉川方面から「南町田グランベリーパーク駅」のシャトルバスを利用するルートです。',
    areas: [
      {
        area: '渋谷・二子玉川エリア',
        badge: '都内観光と両立・急行で1本',
        desc: '急行で南町田グランベリーパーク駅へ直結。都内のホテルを拠点に花博へ日帰り感覚でアクセスできます。',
        url: 'https://hb.afl.rakuten.co.jp/hgc/59cee293.4a6c5500.59cee294.af50e2ea/?pc=https%3A%2F%2Ftravel.rakuten.co.jp%2Fyado%2Ftokyo%2Fshibuya.html',
      },
      {
        area: '溝の口・新百合ヶ丘・町田周辺',
        badge: '神奈川寄りでコスパ重視',
