---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';
import { CITIES } from '../data/cities';

const article = await getEntry('articles', 'akita-akitainu-station');
if (!article) {
  throw new Error('Sample article akita-akitainu-station not found');
}

const { Content, headings } = await render(article);
const tocHeadings = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
const akitaCities = CITIES.filter((c) => c.prefId === 'akita');
---

<Layout
  title={`[案B比較] ${article.data.title} - tavi-navi`}
  description={article.data.description}
  image={article.data.heroImage}
  lang="ja"
  currentPref="akita"
>
  <div class="preview-switcher">
    <div class="preview-switcher-inner">
      <span class="preview-badge">レイアウト比較プレビュー</span>
      <span class="preview-desc">現在表示中：<strong>案B（左追従目次 ＋ 中央本文）</strong></span>
      <div class="preview-links">
        <a href="/preview-layout-b/" class="preview-btn active">案B：左目次</a>
        <a href="/preview-layout-d/" class="preview-btn">案D：左常駐ナビ</a>
        <a href="/preview-layout-e/" class="preview-btn">案E：全幅＋タブ切替</a>
        <a href="/akita/akitainu-station/" class="preview-btn ghost">現行本番 ↗</a>
      </div>
    </div>
  </div>

  <div class="layout-b-shell">
    <!-- 左カラム：追従目次 -->
    <aside class="layout-b-toc" aria-label="目次">
      <div class="toc-sticky">
        <p class="toc-heading">このページの目次</p>
        <nav class="toc-nav">
          <ul>
            {tocHeadings.map((h) => (
              <li class={`toc-item depth-${h.depth}`}>
                <a href={`#${h.slug}`} class="toc-link" data-toc-link={h.slug}>
                  {h.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>

        <div class="toc-sub-area">
          <p class="toc-sub-title">秋田県の主要エリア</p>
          <div class="toc-area-chips">
            {akitaCities.map((city) => (
              <a href={`/akita/${city.id}/`} class="toc-area-chip">{city.nameJa}</a>
            ))}
          </div>
        </div>
      </div>
    </aside>

    <!-- 中央カラム：記事本文（白背景フラット） -->
    <article class="layout-b-main google-anno-skip">
      <nav class="b-crumbs" aria-label="パンくず">
        <a href="/">ホーム</a>
        <span>›</span>
        <a href="/akita/">秋田県</a>
        <span>›</span>
        <span>{article.data.title}</span>
      </nav>

      <header class="b-header">
        <div class="b-badges">
          <a href="/akita/" class="b-badge primary">📍 秋田県</a>
          <span class="b-badge">{article.data.category}</span>
          {article.data.season && <span class="b-badge season">{article.data.season}</span>}
          <span class="b-badge outline">車なし</span>
        </div>

        <h1 class="b-title">{article.data.title}</h1>

        <div class="b-dates">
          <span>公開日: {article.data.pubDate.toLocaleDateString('ja-JP')}</span>
          {article.data.updatedDate && (
            <span>更新日: {article.data.updatedDate.toLocaleDateString('ja-JP')}</span>
          )}
        </div>
      </header>

      {article.data.heroImage && (
        <figure class="b-hero">
          <img
            src={article.data.heroImage}
            alt={article.data.title}
            width="1200"
            height="630"
          />
          <figcaption>写真提供：一般社団法人 秋田県観光連盟</figcaption>
        </figure>
      )}

      <div class="prose google-anno-skip">
        <Content />
      </div>

      <footer class="b-footer">
        <div class="b-tags">
          {article.data.tags.map((tag: string) => (
            <span class="b-tag">#{tag}</span>
          ))}
        </div>
        <div class="b-footer-nav">
          <a href="/akita/">← 秋田県の旅情報一覧へ</a>
          <a href="/">全国トップへ戻る</a>
        </div>
      </footer>
    </article>
  </div>
</Layout>

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const targets = links
    .map((link) => {
      const id = link.dataset.tocLink;
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('is-active'));
            const active = links.find((l) => l.dataset.tocLink === entry.target.id);
            if (active) active.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => observer.observe(t));
  }
</script>

<style>
  /* プレビューページ全体：グレー背景を白ベースへ */
  :global(body) {
    background: #ffffff !important;
  }
  :global(main) {
    max-width: 1200px !important;
    margin-top: 0 !important;
  }

  /* 比較切り替えバー */
  .preview-switcher {
    background: #0f172a;
    color: #f8fafc;
    border-radius: 10px;
    margin: 1rem 0 1.75rem;
    padding: 0.75rem 1.25rem;
  }
  .preview-switcher-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .preview-badge {
    font-size: 0.72rem;
    font-weight: 800;
    background: #0284c7;
    color: #ffffff;
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
  }
  .preview-desc {
    font-size: 0.88rem;
    color: #cbd5e1;
  }
  .preview-desc strong {
    color: #ffffff;
  }
  .preview-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-left: auto;
  }
  .preview-btn {
    font-size: 0.8rem;
    font-weight: 700;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    color: #e2e8f0;
    background: #1e293b;
    border: 1px solid #334155;
  }
  .preview-btn.active {
    background: #0284c7;
    border-color: #0284c7;
    color: #ffffff;
  }
  .preview-btn.ghost {
    background: transparent;
  }

  /* 案B：左追従目次＋中央本文 */
  .layout-b-shell {
    display: grid;
    grid-template-columns: 240px minmax(0, 760px);
    justify-content: center;
    gap: 3rem;
    padding-bottom: 4rem;
    align-items: start;
  }

  .layout-b-toc {
    position: sticky;
    top: 88px;
    max-height: calc(100vh - 110px);
    overflow-y: auto;
    padding-right: 0.5rem;
  }

  .toc-heading {
    margin: 0 0 0.75rem;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    color: #64748b;
    text-transform: uppercase;
  }

  .toc-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid #e2e8f0;
  }

  .toc-item {
    margin: 0;
  }

  .toc-link {
    display: block;
    padding: 0.38rem 0 0.38rem 0.9rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.82rem;
    line-height: 1.45;
    color: #475569;
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .toc-item.depth-3 .toc-link {
    padding-left: 1.65rem;
    font-size: 0.78rem;
    color: #64748b;
  }

  .toc-link:hover,
  .toc-link.is-active {
    color: #0284c7;
    border-left-color: #0284c7;
    font-weight: 700;
    text-decoration: none;
  }

  .toc-sub-area {
    margin-top: 2rem;
    padding-top: 1.25rem;
    border-top: 1px solid #e2e8f0;
  }

  .toc-sub-title {
    margin: 0 0 0.6rem;
    font-size: 0.76rem;
    font-weight: 700;
    color: #64748b;
  }

  .toc-area-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .toc-area-chip {
    font-size: 0.76rem;
    font-weight: 600;
    color: #334155;
    background: #f1f5f9;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    text-decoration: none;
  }
  .toc-area-chip:hover {
    background: #e0f2fe;
    color: #0369a1;
    text-decoration: none;
  }

  /* 本文カラム（白枠・影なしのフラット紙面） */
  .layout-b-main {
    min-width: 0;
  }

  .b-crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: #64748b;
    margin-bottom: 1.25rem;
  }
  .b-crumbs a {
    color: #0284c7;
  }

  .b-header {
    margin-bottom: 1.75rem;
  }
  .b-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 0.85rem;
  }
  .b-badge {
    font-size: 0.76rem;
    font-weight: 700;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: #f1f5f9;
    color: #334155;
    text-decoration: none;
  }
  .b-badge.primary {
    background: #e0f2fe;
    color: #0369a1;
  }
  .b-badge.season {
    background: #fef08a;
    color: #854d0e;
  }
  .b-badge.outline {
    background: #ffffff;
    border: 1px solid #cbd5e1;
  }

  .b-title {
    margin: 0 0 0.85rem;
    font-size: 2rem;
    font-weight: 900;
    line-height: 1.35;
    color: #0f172a;
    letter-spacing: -0.02em;
  }

  .b-dates {
    display: flex;
    gap: 1rem;
    font-size: 0.84rem;
    color: #64748b;
    padding-bottom: 1rem;
    border-bottom: 1px solid #e2e8f0;
  }

  .b-hero {
    margin: 0 0 2rem;
  }
  .b-hero img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 12px;
  }
  .b-hero figcaption {
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 0.4rem;
    text-align: right;
  }

  .b-footer {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid #e2e8f0;
  }
  .b-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .b-tag {
    font-size: 0.8rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    color: #475569;
  }
  .b-footer-nav {
    display: flex;
    justify-content: space-between;
    font-size: 0.9rem;
    font-weight: 700;
  }

  @media (max-width: 960px) {
    .layout-b-shell {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      padding: 0 1rem 3rem;
    }
    .layout-b-toc {
      position: static;
      max-height: none;
      background: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 1rem;
    }
    .b-title {
      font-size: 1.55rem;
    }
  }
</style>
