---
import Layout from '../layouts/Layout.astro';
import TravelTimeline, { type TimelineStep } from '../components/TravelTimeline.astro';

// 熱海サンビーチの全画面スポットデータ
const atamiBeachSpot = {
  id: "atami-sunbeach",
  title: "熱海サンビーチ & 親水公園",
  catchphrase: "ヤシ並木が続く南国風プロムナードと青い海",
  prefName: "静岡",
  prefSlug: "shizuoka",
  category: "絶景・ビーチ",
  heroImage: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1080&q=80",
  amenities: [
    { icon: "🚻", label: "トイレ完備", type: "safe" as const },
    { icon: "🪑", label: "ベンチ多数", type: "info" as const },
    { icon: "👶", label: "授乳室近く", type: "safe" as const },
    { icon: "♿", label: "段差ゼロ", type: "safe" as const },
    { icon: "☀️", label: "晴天推奨", type: "warning" as const },
  ],
  points: [
    "朝8:00前の無人状態がプロムナードの撮影ベスト",
    "親水公園第1デッキから熱海城と海を同時に望む絶景",
    "砂浜沿いは全面ウッドデッキでベビーカーも段差ゼロ"
  ],
  caution: "日陰が少ないため夏場は日傘必須 / 最寄公衆トイレは親水公園中央棟",
  googleMapsUrl: "https://maps.google.com/?q=熱海サンビーチ",
};

// ランチの魚スポット詳細
const fishLunchSpot = {
  id: "osakana-shokudo",
  title: "熱海銀座 おさかな食堂",
  catchphrase: "行列必至！朝獲れ地魚てっぺん丼と金目鯛出汁茶漬け",
  prefName: "静岡",
  prefSlug: "shizuoka",
  category: "ご当地海鮮ランチ",
  heroImage: "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&w=1080&q=80",
  amenities: [
    { icon: "🍴", label: "海鮮処", type: "info" as const },
    { icon: "☔", label: "雨天OK", type: "safe" as const },
    { icon: "💳", label: "カード可", type: "info" as const },
  ],
  points: [
    "11:00オープン前の店頭整理券発券が待ち時間短縮の鍵",
    "最後の一口は無料の金目鯛特製濃厚出汁をかけて絶品茶漬けに",
    "テイクアウト専用窓口もあり、サンビーチで食べるのも最高"
  ],
  caution: "ランチピーク時（12:00〜13:30）は40分〜1時間待ちの可能性あり",
  googleMapsUrl: "https://maps.google.com/?q=熱海銀座おさかな食堂",
};

// ランチのお肉スポット詳細（スワイプ候補）
const meatLunchSpot = {
  id: "cafe-roca-burger",
  title: "CAFE RoCA (静岡牛バーガー)",
  catchphrase: "静岡そだち牛100%！肉汁あふれる贅沢ご当地バーガー",
  prefName: "静岡",
  prefSlug: "shizuoka",
  category: "お肉・バーガー",
  heroImage: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=1080&q=80",
  amenities: [
    { icon: "🥩", label: "お肉料理", type: "info" as const },
    { icon: "🪑", label: "テラス席あり", type: "safe" as const },
    { icon: "👶", label: "子連れ歓迎", type: "safe" as const },
    { icon: "☔", label: "雨天OK", type: "safe" as const },
  ],
  points: [
    "魚が苦手な人や子どもに大好評のジューシーな静岡牛パティ",
    "広々としたレトロモダンな店内でベビーカー横付け可能",
    "自家製レモネードと揚げたてポテトのセットが相性抜群"
  ],
  caution: "数量限定パティのため14:00以降は売り切れになる場合あり",
  googleMapsUrl: "https://maps.google.com/?q=熱海CAFERoCA",
};

const steps: TimelineStep[] = [
  {
    time: "10:30 - 11:45",
    title: "熱海サンビーチ & 親水公園",
    categoryLabel: "絶景・散策",
    image: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=200&q=80",
    points: [
      "青い海とヤシの木の南国風プロムナード",
      "親水公園第1デッキからの熱海城ビュー",
      "砂浜沿いは段差ゼロでベビーカーもスイスイ"
    ],
    amenities: [
      { icon: "🚻", label: "トイレ完備", type: "safe" },
      { icon: "🪑", label: "ベンチ多数", type: "info" },
      { icon: "👶", label: "授乳近く", type: "safe" },
      { icon: "☀️", label: "晴天推奨", type: "warning" },
    ],
    spotData: atamiBeachSpot,
    transit: "🚶 徒歩 約8分 (平坦・歩道あり)"
  },
  {
    time: "12:00 - 13:15",
    title: "熱海銀座 おさかな食堂",
    categoryLabel: "ランチ",
    alternativeLabel: "🍣 お魚派 (定番海鮮)",
    image: "https://images.unsplash.com/photo-1579871494447-9811cf80d66c?auto=format&fit=crop&w=200&q=80",
    points: [
      "朝獲れ地魚がどっさり乗った海鮮てっぺん丼",
      "最後は濃厚な金目鯛の特製出汁茶漬けで締める",
      "商店街アーケード内で雨でも濡れずに入店可能"
    ],
    amenities: [
      { icon: "🍴", label: "海鮮処", type: "info" },
      { icon: "☔", label: "雨OK", type: "safe" },
      { icon: "💳", label: "カード可", type: "info" },
    ],
    spotData: fishLunchSpot,
    transit: "🚌 湯〜遊〜バス 12分 (1回乗車200円)",
    // 横スワイプ候補（お肉派の代替プラン！）
    alternatives: [
      {
        time: "12:00 - 13:15",
        title: "CAFE RoCA (静岡牛バーガー)",
        categoryLabel: "ランチ",
        alternativeLabel: "🥩 お肉派 (静岡牛)",
        image: "https://images.unsplash.com/photo-1568901346375-23c9450c58cd?auto=format&fit=crop&w=200&q=80",
        points: [
          "静岡そだち牛100%パティの肉厚ジューシーバーガー",
          "テラス席あり、魚が苦手な子どもでも安心",
          "ベビーカー横付けOKでゆったりくつろげる"
        ],
        amenities: [
          { icon: "🥩", label: "お肉料理", type: "info" },
          { icon: "🪑", label: "テラスあり", type: "safe" },
          { icon: "👶", label: "子連れOK", type: "safe" },
        ],
        spotData: meatLunchSpot,
      }
    ]
  },
  {
    time: "16:30 チェックイン",
    title: "熱海温泉 ホテルミクラス",
    categoryLabel: "今夜の宿",
    image: "https://images.unsplash.com/photo-1566073771259-6a8506099945?auto=format&fit=crop&w=200&q=80",
    isHotel: true,
    points: [
      "熱海サンビーチ目の前！最上階オーシャンビュー展望露天風呂",
      "熱海駅より路線バスで約5分・タクシー1メーターの好アクセス",
      "夕食は地元静岡食材をふんだんに使用したフレンチコース"
    ],
    hotelData: {
      rating: "4.4",
      reviewCount: "2,150",
      rakutenUrl: "https://travel.rakuten.co.jp/search/?f_keyword=%E7%86%B1%E6%B5%B7%E6%B8%A9%E6%B3%89%20%E3%83%9B%E3%83%86%E3%83%AB%E3%83%9F%E3%82%AF%E3%83%A9%E3%82%B9",
      priceText: "2名1室 税込15,400円〜 / 人"
    }
  }
];
---

<Layout
  title="【熱海・車なし】1泊2日モデルコース（新幹線45分） | tavi-navi"
  description="東京駅から新幹線で45分！車なし・電車とバスだけで巡る熱海王道1泊2日モデルコース。横スワイプで選べるランチや全画面スポットカード、宿情報まで完全網羅。"
>
  <div class="preview-page-container">
    <div class="preview-header">
      <span class="preview-badge">✨ 新UIプロトタイプ</span>
      <h1>【熱海・車なし】1泊2日モデルコース</h1>
      <p class="preview-lead">
        東京駅から新幹線45分！徒歩と周遊バスだけで回れる海沿い満喫プラン。<br>
        <strong>タイムラインの画像・詳細タップで「全画面スポットカード」</strong>が開き、<strong>ランチは横スワイプでお肉と魚を切り替え</strong>られます。
      </p>
    </div>

    <TravelTimeline
      dayTitle="【1日目】海沿いプロムナード散策 ➔ 熱海銀座ランチ ➔ 絶景温泉宿"
      steps={steps}
    />
  </div>
</Layout>

<style>
  .preview-page-container {
    max-width: 680px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }

  @media (max-width: 480px) {
    .preview-page-container {
      padding: 1rem 0.75rem 2.5rem; /* スマホ左右12pxで横幅最大化 */
    }
  }

  .preview-header {
    margin-bottom: 1.5rem;
  }

  .preview-badge {
    display: inline-block;
    background: #e0f2fe;
    color: #0369a1;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.6rem;
    border-radius: 9999px;
    margin-bottom: 0.5rem;
  }

  .preview-header h1 {
    font-size: 1.45rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.5rem;
    line-height: 1.35;
  }

  .preview-lead {
    font-size: 0.88rem;
    color: #4b5563;
    line-height: 1.6;
    margin: 0;
  }
</style>
