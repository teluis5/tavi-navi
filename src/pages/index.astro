---
import Layout from '../layouts/Layout.astro';
import { REGIONS, PREFECTURES } from '../data/prefectures';
import { MONTHLY_THEMES } from '../data/monthlyThemes';
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../utils/slug';

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && !data.draft;
});

const sortedArticles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 今推したい特集1本（新玉川温泉モデルコースを優先、なければ最新記事）
const featuredArticle =
  sortedArticles.find((a) => a.id.includes('akita-dokokanibyun-shintamagawa-onsen')) ||
  sortedArticles[0];
const featuredSlug = featuredArticle
  ? getArticleSlug(featuredArticle.id, featuredArticle.data.pref)
  : '';
const featuredUrl = featuredArticle
  ? `/${featuredArticle.data.pref}/${featuredSlug}/`
  : '/akita/';

const recentArticles = sortedArticles
  .filter((a) => !featuredArticle || a.id !== featuredArticle.id)
  .slice(0, 6);

const MONTH_ABBR = ['JAN', 'FEB', 'MAR', 'APR', 'MAY', 'JUN', 'JUL', 'AUG', 'SEP', 'OCT', 'NOV', 'DEC'];
---

<Layout
  title="tavi-navi（タビナビ）- 週末ここへ行きたいが見つかる、実用的な旅の特集誌"
  description="日本全国47都道府県の旬の旅と車なしモデルコースを、雑誌のような読み心地と実用時刻表・予算目安でお届けする旅行メディアです。"
  lang="ja"
  fullWidth={true}
>
  <!-- 1. ファーストビュー：今推したい特集1本のカバー＋短いキャッチ -->
  <section class="home-cover-section">
    <div class="home-cover-inner">
      <div class="home-cover-media">
        <a href={featuredUrl} class="home-cover-image-link">
          <img
            src={featuredArticle?.data.heroImage || '/thumbnails/akita-course-shintamagawa-v1.png'}
            alt={featuredArticle?.data.title || '新玉川温泉 1泊2日モデルコース'}
            width="1200"
            height="675"
          />
          <span class="pick-sticker">6,000pt 週末旅</span>
        </a>
      </div>

      <div class="home-cover-copy">
        <div class="home-cover-kicker-row">
          <span class="editorial-time-pill">FEATURED</span>
          <span class="editorial-spot-code">AKITA · SHINTAMAGAWA ONSEN</span>
        </div>
        <h1 class="home-cover-title">
          <a href={featuredUrl}>
            朝6時のこまちで、pH1.2の湯けむりへ。<br />
            車なし1泊2日・新玉川温泉の湯治旅
          </a>
        </h1>
        <p class="home-cover-lead">
          東京から新幹線とバスを乗り継ぐだけで、日本一の強酸性泉と湯煙立ちのぼる山あいの宿へ。接続ダイヤと費用目安まで、週末そのまま使える1冊にまとめました。
        </p>
        <div class="home-cover-actions">
          <a href={featuredUrl} class="home-cta-primary">
            <span>この特集を読む</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
          <a href="/special/dokokanibyun/" class="pill-btn">
            <span>どこかにビューーン！特集</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- スリム月別バー（欧文ラベル＋数字） -->
  <section class="home-month-strip" aria-label="月から旅を探す">
    <div class="home-container">
      <div class="home-month-strip-inner">
        <span class="home-month-label">BY MONTH</span>
        <div class="home-month-scroll">
          {MONTHLY_THEMES.map((m, idx) => (
            <a href={`/season/${m.month}/`} class="home-month-chip">
              <span class="home-month-en">{MONTH_ABBR[idx]}</span>
              <span class="home-month-ja">{m.month}月</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="home-container home-main-stack">
    <!-- 2. 最新の特集・モデルコース（写真主役カード） -->
    {recentArticles.length > 0 && (
      <section class="home-section">
        <div class="home-section-head">
          <div>
            <span class="home-section-kicker">LATEST ISSUES</span>
            <h2 class="home-section-title">最新のモデルコース・スポット特集</h2>
          </div>
          <a href="/akita/" class="pill-btn">
            <span>秋田特集一覧</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>
        </div>

        <div class="home-article-grid">
          {recentArticles.map((post) => {
            const prefObj = PREFECTURES.find((p) => p.id === post.data.pref);
            const articleSlug = getArticleSlug(post.id, post.data.pref);
            const thumb = post.data.heroImage || '/thumbnails/akita-course-shintamagawa-v1.png';
            return (
              <article class="home-article-card">
                <a href={`/${post.data.pref}/${articleSlug}/`} class="home-article-thumb-link">
                  <img src={thumb} alt={post.data.title} loading="lazy" class="home-article-thumb" />
                  <span class="home-article-cat-tag">{post.data.category}</span>
                </a>
                <div class="home-article-body">
                  <div class="home-article-meta">
                    <span class="home-article-pref">{prefObj ? prefObj.nameJa : post.data.pref}</span>
                    {post.data.duration && <span>· {post.data.duration}</span>}
                    <time datetime={post.data.pubDate.toISOString()}>
                      · {post.data.pubDate.toLocaleDateString('ja-JP')}
                    </time>
                  </div>
                  <h3 class="home-article-title">
                    <a href={`/${post.data.pref}/${articleSlug}/`}>
                      {post.data.displayTitle || post.data.title}
                    </a>
                  </h3>
                  <p class="home-article-desc">{post.data.description}</p>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    <!-- 3. 出発地 × 移動時間 タブ切替UI -->
    <section class="home-section" id="departure-finder">
      <div class="home-section-head">
        <div>
          <span class="home-section-kicker">DEPARTURE × TIME</span>
          <h2 class="home-section-title">出発地と移動時間から選ぶ、週末1泊2日</h2>
        </div>
      </div>

      <div class="tab-bar" role="tablist" aria-label="出発地を選択">
        <button type="button" class="tab-btn is-active" role="tab" aria-selected="true" data-dep-tab="tokyo">
          東京発（新幹線・特急）
        </button>
        <button type="button" class="tab-btn" role="tab" aria-selected="false" data-dep-tab="osaka">
          大阪・京都発（近畿）
        </button>
        <button type="button" class="tab-btn" role="tab" aria-selected="false" data-dep-tab="season">
          季節の先取り旅
        </button>
      </div>

      <!-- 東京発パネル -->
      <div class="dep-panel" data-dep-panel="tokyo">
        <a href="/akita/dokokanibyun-shintamagawa-onsen/" class="dep-card is-highlight">
          <div class="dep-time-col">
            <span class="dep-time-num">170<small>min</small></span>
            <span class="dep-time-method">新幹線こまち</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">秋田（田沢湖・新玉川温泉）</span>
            <span class="dep-dest-desc">pH1.2の日本一強酸性泉と湯煙の湯治体験。車なし1泊2日</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/shizuoka/from-tokyo-2days/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">45<small>min</small></span>
            <span class="dep-time-method">新幹線こだま</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">静岡（三島・熱海）</span>
            <span class="dep-dest-desc">雪化粧の富士山パノラマと海沿い露天風呂を巡る週末</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/kanagawa/yokohama-autumn-kids-no-car/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">30<small>min</small></span>
            <span class="dep-time-method">電車直通</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">神奈川（横浜・山下公園）</span>
            <span class="dep-dest-desc">黄金イチョウ並木と海風散歩。ベビーカーでも楽な平坦ルート</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/tochigi/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">110<small>min</small></span>
            <span class="dep-time-method">特急スペーシア</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">栃木（日光・鬼怒川）</span>
            <span class="dep-dest-desc">世界遺産と中禅寺湖の静寂、渓谷沿いの名湯へ</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- 大阪・京都発パネル -->
      <div class="dep-panel" data-dep-panel="osaka" hidden>
        <a href="/hyogo/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">150<small>min</small></span>
            <span class="dep-time-method">特急こうのとり</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">兵庫（城崎温泉）</span>
            <span class="dep-dest-desc">柳並木を浴衣で歩く7つの外湯めぐりと冬の松葉ガニ</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/wakayama/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">135<small>min</small></span>
            <span class="dep-time-method">特急くろしお</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">和歌山（南紀白浜）</span>
            <span class="dep-dest-desc">白砂ビーチと太平洋を望む絶景露天風呂リゾート</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/mie/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">110<small>min</small></span>
            <span class="dep-time-method">特急しまかぜ</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">三重（伊勢志摩）</span>
            <span class="dep-dest-desc">朝の澄んだお伊勢参りとおかげ横丁の食べ歩き</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/kyoto/arashiyama-autumn/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">45<small>min</small></span>
            <span class="dep-time-method">JR・阪急</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">京都（嵐山・渡月橋）</span>
            <span class="dep-dest-desc">朝一番の竹林と桂川の紅葉を人混み前に味わう</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>

      <!-- 季節の先取りパネル -->
      <div class="dep-panel" data-dep-panel="season" hidden>
        <a href="/hokkaido/early-june-best-route/" class="dep-card is-highlight">
          <div class="dep-time-col">
            <span class="dep-time-num">JUN</span>
            <span class="dep-time-method">6月上旬</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">北海道（富良野・積丹ウニ）</span>
            <span class="dep-dest-desc">梅雨のない爽快な初夏。積丹生ウニ解禁と新緑ドライブ</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="/aomori/towadako-oirase-1night-2days/" class="dep-card">
          <div class="dep-time-col">
            <span class="dep-time-num">JUN</span>
            <span class="dep-time-method">新緑・紅葉</span>
          </div>
          <div class="dep-info-col">
            <span class="dep-dest-name">青森（奥入瀬渓流・十和田湖）</span>
            <span class="dep-dest-desc">苔むした岩と滝のせせらぎを歩く1泊2日ルート</span>
          </div>
          <svg class="dep-arrow" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      </div>
    </section>

    <!-- 4. 47都道府県ナビ（地方タブ切替で省スペース化・重複解消） -->
    <section class="home-section">
      <div class="home-section-head">
        <div>
          <span class="home-section-kicker">47 PREFECTURES</span>
          <h2 class="home-section-title">地方・都道府県から探す</h2>
        </div>
      </div>

      <div class="tab-bar" role="tablist" aria-label="地方を選択">
        {REGIONS.map((region, idx) => (
          <button
            type="button"
            class={`tab-btn ${idx === 0 ? 'is-active' : ''}`}
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            data-region-tab={region.id}
          >
            {region.nameJa}
          </button>
        ))}
      </div>

      {REGIONS.map((region, idx) => {
        const regionPrefs = PREFECTURES.filter((p) => p.region === region.id);
        return (
          <div class="region-pref-grid" data-region-panel={region.id} hidden={idx !== 0}>
            {regionPrefs.map((pref) => (
              <a href={`/${pref.id}/`} class="region-pref-card">
                <div class="region-pref-top">
                  <span class="region-pref-ja">{pref.nameJa}</span>
                  <span class="region-pref-en">{pref.nameEn}</span>
                </div>
                <div class="region-pref-tags">
                  {pref.highlightsJa.slice(0, 2).map((item) => (
                    <span>{item}</span>
                  ))}
                </div>
              </a>
            ))}
          </div>
        );
      })}
    </section>
  </div>
</Layout>

<script>
  // 出発地タブ切替
  const depTabs = document.querySelectorAll<HTMLButtonElement>('[data-dep-tab]');
  const depPanels = document.querySelectorAll<HTMLElement>('[data-dep-panel]');
  depTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.depTab;
      depTabs.forEach((t) => {
        const active = t === btn;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      depPanels.forEach((p) => {
        p.hidden = p.dataset.depPanel !== target;
      });
    });
  });

  // 地方タブ切替
  const regionTabs = document.querySelectorAll<HTMLButtonElement>('[data-region-tab]');
  const regionPanels = document.querySelectorAll<HTMLElement>('[data-region-panel]');
  regionTabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.regionTab;
      regionTabs.forEach((t) => {
        const active = t === btn;
        t.classList.toggle('is-active', active);
        t.setAttribute('aria-selected', String(active));
      });
      regionPanels.forEach((p) => {
        p.hidden = p.dataset.regionPanel !== target;
      });
    });
  });
</script>

<style>
  .home-container {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  /* 1. ファーストビュー：特集カバー */
  .home-cover-section {
    background: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 2rem 0 2.25rem;
  }
  .home-cover-inner {
    max-width: 1080px;
    margin: 0 auto;
    padding: 0 1.25rem;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 2rem;
    align-items: center;
  }
  .home-cover-media {
    position: relative;
  }
  .home-cover-image-link {
    position: relative;
    display: block;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(15, 23, 42, 0.1);
  }
  .home-cover-image-link img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.35s ease;
  }
  .home-cover-image-link:hover img {
    transform: scale(1.03);
  }
  .home-cover-kicker-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.75rem;
  }
  .home-cover-title {
    margin: 0 0 0.85rem;
    font-size: clamp(1.45rem, 2.5vw, 1.95rem);
    font-weight: 900;
    line-height: 1.38;
    letter-spacing: -0.02em;
    color: #0f172a;
  }
  .home-cover-title a {
    color: inherit;
    text-decoration: none;
  }
  .home-cover-title a:hover {
    color: var(--color-teal, #0E7C94);
    text-decoration: none;
  }
  .home-cover-lead {
    margin: 0 0 1.25rem;
    font-size: 0.94rem;
    line-height: 1.75;
    color: #475569;
  }
  .home-cover-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
  }
  .home-cta-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.62rem 1.25rem;
    background: var(--color-teal, #0E7C94);
    color: #ffffff !important;
    font-size: 0.88rem;
    font-weight: 800;
    border-radius: 9999px;
    text-decoration: none !important;
    transition: background-color 0.15s ease, transform 0.15s ease;
  }
  .home-cta-primary:hover {
    background: #0a5f72;
    transform: translateY(-1px);
    opacity: 1;
  }

  /* スリム月別バー */
  .home-month-strip {
    background: #F8FAFB;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.7rem 0;
  }
  .home-month-strip-inner {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .home-month-label {
    font-family: var(--font-display);
