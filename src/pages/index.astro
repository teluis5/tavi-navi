---
import Layout from '../layouts/Layout.astro';
import { REGIONS, PREFECTURES } from '../data/prefectures';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && !data.draft;
});

// Sort by pubDate desc
const recentArticles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
---

<Layout
  title="tavi-navi（タビナビ）- 47都道府県の旬とリアルタイムな旅行情報ガイド"
  description="日本全国47都道府県の今行くべき旬の旅行スポット、イベント、祭り、桜・紅葉の見頃情報をリアルタイムにお届けする旅行ナビゲーションメディアです。"
  lang="ja"
>
  <div class="hero-banner">
    <div class="container">
      <span class="badge-seasonal">🍁 2026年 秋の紅葉・イベント特集公開中</span>
      <h1 class="hero-title" style="margin-top: 1rem;">都道府県ごとの旬を巡る、リアルタイム旅ナビ</h1>
      <p class="hero-subtitle">
        全国47都道府県の今週末のイベント、開花・見頃の絶景、旬のグルメ速報をワンストップでお届け。あなたの次の旅先をスマートに見つけます。
      </p>
    </div>
  </div>

  <div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
    {/* 最新の旬・旅行記事 */}
    {recentArticles.length > 0 && (
      <section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-accent);">🔥</span> 最新の旬・旅行速報
        </h2>
        <div class="article-grid">
          {recentArticles.map((post) => {
            const prefObj = PREFECTURES.find((p) => p.id === post.data.pref);
            // slug without -en
            const articleSlug = post.id.replace(/\.(md|mdx)$/, '');
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span style="font-weight: 700; color: var(--color-primary);">{prefObj ? prefObj.nameJa : post.data.pref}</span>
                    <span>•</span>
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('ja-JP')}
                    </time>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/${post.data.pref}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/${post.data.pref}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      記事を読む &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {/* 47都道府県ナビ */}
    <section>
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 0.5rem;">
          都道府県から旬の情報を探す
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">
          気になる都道府県を選択すると、その地域の最新トピックス、今週の見どころ、アクセス情報を確認できます。
        </p>
      </div>

      {REGIONS.map((region) => {
        const regionPrefs = PREFECTURES.filter((p) => p.region === region.id);
        return (
          <div class="region-section">
            <h3 class="region-title">
              <span>{region.nameJa}</span>
              <span class="region-title-en">{region.nameEn}</span>
            </h3>
            <div class="prefecture-grid">
              {regionPrefs.map((pref) => (
                <a href={`/${pref.id}/`} class="pref-card">
                  <div class="pref-card-header">
                    <span class="pref-card-title">{pref.nameJa}</span>
                    <span class="pref-card-en">{pref.nameEn}</span>
                  </div>
                  <div class="pref-card-highlights">
                    {pref.highlightsJa.slice(0, 2).map((item) => (
                      <span class="pref-card-tag">{item}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </div>
</Layout>
