---
import Layout from '../layouts/Layout.astro';
import { REGIONS, PREFECTURES } from '../data/prefectures';
import { MONTHLY_THEMES } from '../data/monthlyThemes';
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../utils/slug';

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && !data.draft;
});

// Sort by pubDate desc
const recentArticles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
---

<Layout
  title="tavi-navi（タビナビ）- 47都道府県の旬とリアルタイムな旅行情報ガイド"
  description="日本全国47都道府県の今行くべき旬の旅行スポット、イベント、祭り、桜・紅葉の見頃情報をリアルタイムにお届けする旅行ナビゲーションメディアです。"
  lang="ja"
>
  <div class="hero-banner">
    <div class="container">
      <span class="badge-seasonal">🍁 2026年 11月の旬・紅葉＆イベント特集公開中</span>
      <h1 class="hero-title" style="margin-top: 1rem;">都道府県ごとの旬を巡る、リアルタイム旅ナビ</h1>
      <p class="hero-subtitle">
        全国47都道府県の今週末のイベント、開花・見頃の絶景、旬のグルメ速報をお届け。「車なし（電車）プラン」や「子連れ安心ルート」など旅のスタイル別ガイドも充実。
      </p>

      {/* 1月〜12月 時期から探すピルナビ */}
      <div style="margin-top: 1.75rem; background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 12px; padding: 1.1rem 1.25rem; max-width: 800px; margin-left: auto; margin-right: auto;">
        <div class="hero-month-header">
          <span style="font-size: 0.85rem; font-weight: 700; color: #a7f3d0;">
            🗓️ 旅行の時期・月から探す（1月〜12月）:
          </span>
          <a href="/season/" style="font-size: 0.78rem; font-weight: 700; color: #ffffff; text-decoration: underline;">
            四季カレンダー一覧を見る &rarr;
          </a>
        </div>
        <div class="top-month-grid">
          {MONTHLY_THEMES.map((m) => (
            <a
              href={`/season/${m.month}/`}
              class="top-month-pill"
            >
              <span style="font-size: 0.95rem; line-height: 1; margin-bottom: 0.15rem;">{m.icon}</span>
              <span>{m.nameJa}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
    {/* 最新の旬・旅行記事 */}
    {recentArticles.length > 0 && (
      <section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-accent);">🔥</span> 最新の旬・旅行速報
        </h2>
        <div class="article-grid">
          {recentArticles.map((post) => {
            const prefObj = PREFECTURES.find((p) => p.id === post.data.pref);
            const articleSlug = getArticleSlug(post.id, post.data.pref);
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span style="font-weight: 700; color: var(--color-primary);">{prefObj ? prefObj.nameJa : post.data.pref}</span>
                    <span>•</span>
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('ja-JP')}
                    </time>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/${post.data.pref}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/${post.data.pref}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      記事を読む &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {/* 出発地から探す！週末の王道1泊2日モデルコース */}
    <section style="margin-bottom: 3.5rem;">
      <div style="margin-bottom: 1.5rem;">
        <span class="badge-seasonal" style="background: rgba(46, 125, 50, 0.1); color: var(--color-primary); margin-bottom: 0.5rem; display: inline-block;">
          🚅 移動時間・新幹線アクセス別
        </span>
        <h2 style="font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.4rem 0;">
          <span style="color: var(--color-primary);">🗺️</span> 出発地から探す！週末1泊2日モデルコース
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.92rem; margin: 0;">
          「今週末、東京や大阪からサクッと行ける温泉・絶景は？」移動疲れの少ない新幹線・特急直通の人気デスティネーションを厳選。
        </p>
      </div>

      <div class="getaway-grid">
        {/* 東京発カード */}
        <div class="getaway-hub-card">
          <div class="getaway-hub-header">
            <span class="getaway-hub-icon">🗼</span>
            <div>
              <h3 class="getaway-hub-title">東京発（関東・東海へ）</h3>
              <span class="getaway-hub-sub">新幹線・特急で45分〜2時間の人気温泉＆絶景</span>
            </div>
          </div>
          <div class="getaway-dest-list">
            <a href="/shizuoka/from-tokyo-2days/" class="getaway-dest-item is-featured">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">新幹線 45分</span>
                <span class="getaway-dest-name">静岡（三島・熱海）</span>
              </div>
              <span class="getaway-dest-desc">雪化粧の富士山パノラマ＆名湯露天風呂【特集記事あり】 &rarr;</span>
            </a>
            <a href="/kanagawa/yokohama-autumn-kids-no-car/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">電車 30分</span>
                <span class="getaway-dest-name">神奈川（横浜・箱根）</span>
              </div>
              <span class="getaway-dest-desc">日本大通りイチョウ並木＆秋バラ・彫刻の森 &rarr;</span>
            </a>
            <a href="/tochigi/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">スペーシア 110分</span>
                <span class="getaway-dest-name">栃木（日光・鬼怒川）</span>
              </div>
              <span class="getaway-dest-desc">世界遺産日光東照宮＆中禅寺湖・渓谷美温泉 &rarr;</span>
            </a>
            <a href="/gunma/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">特急 150分</span>
                <span class="getaway-dest-name">群馬（草津・伊香保）</span>
              </div>
              <span class="getaway-dest-desc">湯畑ライトアップ＆石段街の湯めぐり旅 &rarr;</span>
            </a>
          </div>
        </div>

        {/* 大阪・関西発カード */}
        <div class="getaway-hub-card">
          <div class="getaway-hub-header">
            <span class="getaway-hub-icon">🐙</span>
            <div>
              <h3 class="getaway-hub-title">大阪・京都発（近畿へ）</h3>
              <span class="getaway-hub-sub">特急・新快速で直行できる冬の名湯＆海の幸</span>
            </div>
          </div>
          <div class="getaway-dest-list">
            <a href="/hyogo/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">こうのとり 150分</span>
                <span class="getaway-dest-name">兵庫（城崎温泉）</span>
              </div>
              <span class="getaway-dest-desc">浴衣で巡る7つの外湯＆冬の松葉ガニ満喫 &rarr;</span>
            </a>
            <a href="/wakayama/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">くろしお 135分</span>
                <span class="getaway-dest-name">和歌山（南紀白浜）</span>
              </div>
              <span class="getaway-dest-desc">白砂ビーチと太平洋望む絶景露天風呂リゾート &rarr;</span>
            </a>
            <a href="/mie/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">しまかぜ 110分</span>
                <span class="getaway-dest-name">三重（伊勢志摩）</span>
              </div>
              <span class="getaway-dest-desc">お伊勢参りとおかげ横丁の食べ歩き旅 &rarr;</span>
            </a>
            <a href="/kyoto/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">特急 120分</span>
                <span class="getaway-dest-name">京都（海の京都・天橋立）</span>
              </div>
              <span class="getaway-dest-desc">日本三景天橋立と伊根の舟屋・絶景クルーズ &rarr;</span>
            </a>
          </div>
        </div>

        {/* 半年先・初夏の先取り特集カード */}
        <div class="getaway-hub-card">
          <div class="getaway-hub-header">
            <span class="getaway-hub-icon">🛫</span>
            <div>
              <h3 class="getaway-hub-title">半年先・初夏の先取り計画</h3>
              <span class="getaway-hub-sub">梅雨なし北海道＆初夏の極上リゾート</span>
            </div>
          </div>
          <div class="getaway-dest-list">
            <a href="/hokkaido/early-june-best-route/" class="getaway-dest-item is-featured">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge" style="background: #e65100;">6月上旬</span>
                <span class="getaway-dest-name">北海道（富良野・積丹ウニ）</span>
              </div>
              <span class="getaway-dest-desc">梅雨なし爽快！積丹生ウニ解禁＆富良野新緑【特集記事あり】 &rarr;</span>
            </a>
            <a href="/okinawa/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge" style="background: #e65100;">6月下旬</span>
                <span class="getaway-dest-name">沖縄（本島・慶良間諸島）</span>
              </div>
              <span class="getaway-dest-desc">日本一早い梅雨明け！真夏のケラマブループライベートビーチ &rarr;</span>
            </a>
            <a href="/nagano/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">6月</span>
                <span class="getaway-dest-name">長野（上高地・白馬）</span>
              </div>
              <span class="getaway-dest-desc">残雪の北アルプスと梓川の清流・爽快新緑ハイキング &rarr;</span>
            </a>
            <a href="/aomori/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">6月</span>
                <span class="getaway-dest-name">青森（奥入瀬渓流）</span>
              </div>
              <span class="getaway-dest-desc">新緑が最も瑞々しい奥入瀬の滝めぐりと十和田湖クルーズ &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* 47都道府県ナビ */}
    <section>
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 0.5rem;">
          都道府県から旬の情報を探す
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">
          気になる都道府県を選択すると、その地域の最新トピックス、今週の見どころ、アクセス情報を確認できます。
        </p>
      </div>

      {REGIONS.map((region) => {
        const regionPrefs = PREFECTURES.filter((p) => p.region === region.id);
        return (
          <div class="region-section">
            <h3 class="region-title">
              <span>{region.nameJa}</span>
              <span class="region-title-en">{region.nameEn}</span>
            </h3>
            <div class="prefecture-grid">
              {regionPrefs.map((pref) => (
                <a href={`/${pref.id}/`} class="pref-card">
                  <div class="pref-card-header">
                    <span class="pref-card-title">{pref.nameJa}</span>
                    <span class="pref-card-en">{pref.nameEn}</span>
                  </div>
                  <div class="pref-card-highlights">
                    {pref.highlightsJa.slice(0, 2).map((item) => (
                      <span class="pref-card-tag">{item}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </div>
</Layout>

<style>
  .getaway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .getaway-hub-card {
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .getaway-hub-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.85rem;
  }

  .getaway-hub-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .getaway-hub-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0 0 0.2rem 0;
  }

  .getaway-hub-sub {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .getaway-dest-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .getaway-dest-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .getaway-dest-item:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
    background: #ffffff;
  }

  .getaway-dest-item.is-featured {
    background: rgba(46, 125, 50, 0.04);
    border-color: var(--color-primary);
    border-left: 4px solid var(--color-primary);
  }

  .getaway-dest-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .getaway-time-badge {
    font-size: 0.72rem;
    font-weight: 800;
    background: var(--color-primary);
    color: #ffffff;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    line-height: 1.2;
  }

  .getaway-dest-name {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .getaway-dest-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .getaway-dest-item:hover .getaway-dest-desc {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .getaway-grid {
      grid-template-columns: 1fr;
    }
    .getaway-hub-card {
      padding: 1.15rem 1rem;
    }
  }

    .hero-month-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
  }
  @media (max-width: 640px) {
    .hero-month-header {
      flex-direction: column;
      align-items: flex-start !important;
      gap: 0.35rem;
    }
  }

  .top-month-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.35rem;
  }

  .top-month-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.15);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    padding: 0.4rem 0.1rem;
    text-decoration: none;
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    transition: all 0.15s ease;
  }

  .top-month-pill:hover {
    background: rgba(255, 255, 255, 0.3);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .top-month-grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (max-width: 480px) {
    .top-month-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
