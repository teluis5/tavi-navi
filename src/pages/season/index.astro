---
import Layout from '../../layouts/Layout.astro';
import { MONTHLY_THEMES } from '../../data/monthlyThemes';

const springMonths = MONTHLY_THEMES.filter((m) => m.seasonType === 'spring');
const summerMonths = MONTHLY_THEMES.filter((m) => m.seasonType === 'summer');
const autumnMonths = MONTHLY_THEMES.filter((m) => m.seasonType === 'autumn');
const winterMonths = MONTHLY_THEMES.filter((m) => m.seasonType === 'winter');
---

<Layout
  title="【時期・月別から探す】日本の四季・旬の国内旅行ガイド - tavi-navi"
  description="1月〜12月の月別・時期別の国内旅行ガイド。全国の桜・新緑・ラベンダー・紅葉・雪景色の見頃ピークや旬のグルメ、気候・服装を完全網羅。行きたい時期から次の旅行先を見つけよう。"
  lang="ja"
>
  <div style="background: #ffffff; border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
    <div class="container" style="font-size: 0.85rem; color: var(--color-text-muted);">
      <a href="/" style="color: var(--color-primary);">ホーム</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span style="font-weight: 700; color: var(--color-text-main);">時期・月から探す</span>
    </div>
  </div>

  <div class="hero-banner" style="padding: 2.5rem 0 2rem;">
    <div class="container">
      <span class="badge-seasonal">🗓️ 四季の旬カレンダー</span>
      <h1 class="hero-title" style="margin-top: 0.75rem;">
        時期・月から探す国内旅行ガイド
      </h1>
      <p class="hero-subtitle">
        「来月の三連休、どこ行こう？」「半年先の初夏、梅雨のない旅行先は？」日本全国の12ヶ月の旬の見頃・イベント・味覚から最高の旅先をご案内します。
      </p>
    </div>
  </div>

  <div class="container" style="padding-top: 3rem; padding-bottom: 4rem;">
    {/* 春 */}
    <section class="season-group">
      <h2 class="season-group-title">
        <span>🌸 春（3月・4月・5月）</span>
        <span class="season-group-sub">桜前線・新緑・菜の花畑・春祭り</span>
      </h2>
      <div class="month-cards-grid">
        {springMonths.map((m) => (
          <a href={`/season/${m.month}/`} class="month-card">
            <div class="month-card-header">
              <span class="month-card-icon">{m.icon}</span>
              <div>
                <h3 class="month-card-name">{m.nameJa}</h3>
                <span class="month-card-en">{m.monthNameEn}</span>
              </div>
            </div>
            <p class="month-card-tagline">{m.taglineJa}</p>
            <div class="month-card-action">
              <span>旬の見どころ・イベントを見る</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* 夏 */}
    <section class="season-group">
      <h2 class="season-group-title">
        <span>🌻 夏（6月・7月・8月）</span>
        <span class="season-group-sub">梅雨なし北海道・富良野ラベンダー・夏祭り＆花火</span>
      </h2>
      <div class="month-cards-grid">
        {summerMonths.map((m) => (
          <a href={`/season/${m.month}/`} class="month-card">
            <div class="month-card-header">
              <span class="month-card-icon">{m.icon}</span>
              <div>
                <h3 class="month-card-name">{m.nameJa}</h3>
                <span class="month-card-en">{m.monthNameEn}</span>
              </div>
            </div>
            <p class="month-card-tagline">{m.taglineJa}</p>
            <div class="month-card-action">
              <span>旬の見どころ・イベントを見る</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* 秋 */}
    <section class="season-group">
      <h2 class="season-group-title">
        <span>🍁 秋（9月・10月・11月）</span>
        <span class="season-group-sub">紅葉見頃ピーク・味覚狩り・イチョウ並木＆ライトアップ</span>
      </h2>
      <div class="month-cards-grid">
        {autumnMonths.map((m) => (
          <a href={`/season/${m.month}/`} class="month-card">
            <div class="month-card-header">
              <span class="month-card-icon">{m.icon}</span>
              <div>
                <h3 class="month-card-name">{m.nameJa}</h3>
                <span class="month-card-en">{m.monthNameEn}</span>
              </div>
            </div>
            <p class="month-card-tagline">{m.taglineJa}</p>
            <div class="month-card-action">
              <span>旬の見どころ・イベントを見る</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* 冬 */}
    <section class="season-group">
      <h2 class="season-group-title">
        <span>❄️ 冬（12月・1月・2月）</span>
        <span class="season-group-sub">イルミネーション・雪まつり・冬花火・雪見露天風呂</span>
      </h2>
      <div class="month-cards-grid">
        {winterMonths.map((m) => (
          <a href={`/season/${m.month}/`} class="month-card">
            <div class="month-card-header">
              <span class="month-card-icon">{m.icon}</span>
              <div>
                <h3 class="month-card-name">{m.nameJa}</h3>
                <span class="month-card-en">{m.monthNameEn}</span>
              </div>
            </div>
            <p class="month-card-tagline">{m.taglineJa}</p>
            <div class="month-card-action">
              <span>旬の見どころ・イベントを見る</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .season-group {
    margin-bottom: 3.5rem;
  }

  .season-group-title {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-text-main);
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 2px solid var(--color-border);
  }

  .season-group-sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .month-cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .month-card {
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.25rem;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .month-card:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);
  }

  .month-card-header {
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .month-card-icon {
    font-size: 1.6rem;
    line-height: 1;
  }

  .month-card-name {
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0;
  }

  .month-card-en {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 600;
    display: block;
  }

  .month-card-tagline {
    font-size: 0.88rem;
    line-height: 1.5;
    color: var(--color-text-main);
    margin: 0;
    flex: 1;
  }

  .month-card-action {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 800;
    color: var(--color-primary);
    border-top: 1px solid var(--color-border);
    padding-top: 0.65rem;
  }

  @media (max-width: 640px) {
    .season-group-title {
      flex-direction: column;
      gap: 0.25rem;
    }
  }
</style>
