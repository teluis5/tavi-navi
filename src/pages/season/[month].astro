---
import Layout from '../../layouts/Layout.astro';
import { MONTHLY_THEMES, getMonthTheme, type MonthTheme } from '../../data/monthlyThemes';
import { PREFECTURES } from '../../data/prefectures';
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../../utils/slug';

export function getStaticPaths() {
  return MONTHLY_THEMES.map((theme) => ({
    params: { month: String(theme.month) },
    props: { theme },
  }));
}

interface Props {
  theme: MonthTheme;
}

const { theme } = Astro.props;

// Fetch all articles matching this month
const allArticles = await getCollection('articles', ({ data }) => {
  if (data.lang !== 'ja' || data.draft) return false;
  const s = data.season || '';
  const monthStr = `${theme.month}月`;
  return s.includes(monthStr);
});

// Top prefectures data for this month
const recommendedPrefs = PREFECTURES.filter((p) => theme.topPrefectures.includes(p.id));
---

<Layout
  title={`【${theme.nameJa}の国内旅行】おすすめ観光地・旬の見頃＆イベントガイド - tavi-navi`}
  description={`${theme.nameJa}の国内旅行・観光ガイド。${theme.taglineJa}。上旬・中旬・下旬の旬タイムライン、気候とおすすめ服装、車なし＆ドライブモデルコースを完全網羅。`}
  lang="ja"
>
  {/* パンくずリスト */}
  <div style="background: #ffffff; border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
    <div class="container" style="font-size: 0.85rem; color: var(--color-text-muted);">
      <a href="/" style="color: var(--color-primary);">ホーム</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <a href="/season/" style="color: var(--color-primary);">時期から探す</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span style="font-weight: 700; color: var(--color-text-main);">{theme.nameJa}の国内旅行</span>
    </div>
  </div>

  {/* ヒーローバナー */}
  <div class="hero-banner" style="padding: 2.5rem 0 2rem;">
    <div class="container">
      <span class="badge-seasonal">{theme.icon} {theme.nameJa}の旬・ベストシーズン</span>
      <h1 class="hero-title" style="margin-top: 0.75rem;">
        {theme.nameJa}の国内旅行ガイド
      </h1>
      <p class="hero-subtitle">
        {theme.taglineJa}
      </p>

      {/* 1月〜12月 月別セレクター */}
      <div class="month-selector-wrapper">
        <span class="month-selector-title">🗓️ 他の月・半年先をチェック:</span>
        <div class="month-pill-grid">
          {MONTHLY_THEMES.map((m) => {
            const isCurrent = m.month === theme.month;
            return (
              <a
                href={`/season/${m.month}/`}
                class={`month-pill ${isCurrent ? 'is-active' : ''}`}
              >
                <span class="month-pill-icon">{m.icon}</span>
                <span class="month-pill-name">{m.nameJa}</span>
              </a>
            );
          })}
        </div>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top: 2.5rem; padding-bottom: 4rem;">
    {/* 上旬・中旬・下旬 タイムライン */}
    <section style="margin-bottom: 3.5rem;">
      <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-accent);">📅</span> {theme.nameJa}の旬タイムライン（上旬・中旬・下旬）
      </h2>

      <div class="season-timeline-grid">
        {/* 上旬 */}
        <div class="period-card">
          <div class="period-card-header period-early">
            <span class="period-badge">上旬（1日〜10日）</span>
            <span class="period-icon">🌱</span>
          </div>
          <div class="period-card-body">
            <ul class="period-highlight-list">
              {theme.earlyPeriodJa.highlights.map((h) => (
                <li>
                  <span class="period-bullet">✦</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="period-tip-box">
              <span class="tip-label">💡 旅のコツ:</span>
              <p class="tip-text">{theme.earlyPeriodJa.tips}</p>
            </div>
          </div>
        </div>

        {/* 中旬 */}
        <div class="period-card">
          <div class="period-card-header period-mid">
            <span class="period-badge">中旬（11日〜20日）</span>
            <span class="period-icon">✨</span>
          </div>
          <div class="period-card-body">
            <ul class="period-highlight-list">
              {theme.midPeriodJa.highlights.map((h) => (
                <li>
                  <span class="period-bullet">✦</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="period-tip-box">
              <span class="tip-label">💡 旅のコツ:</span>
              <p class="tip-text">{theme.midPeriodJa.tips}</p>
            </div>
          </div>
        </div>

        {/* 下旬 */}
        <div class="period-card">
          <div class="period-card-header period-late">
            <span class="period-badge">下旬（21日〜末日）</span>
            <span class="period-icon">🌟</span>
          </div>
          <div class="period-card-body">
            <ul class="period-highlight-list">
              {theme.latePeriodJa.highlights.map((h) => (
                <li>
                  <span class="period-bullet">✦</span>
                  <span>{h}</span>
                </li>
              ))}
            </ul>
            <div class="period-tip-box">
              <span class="tip-label">💡 旅のコツ:</span>
              <p class="tip-text">{theme.latePeriodJa.tips}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    {/* この時期（当月）の特集記事 */}
    {allArticles.length > 0 && (
      <section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-primary);">📚</span> {theme.nameJa}のおすすめ特集記事・モデルコース
        </h2>

        <div class="article-grid">
          {allArticles.map((post) => {
            const prefObj = PREFECTURES.find((p) => p.id === post.data.pref);
            const articleSlug = getArticleSlug(post.id, post.data.pref);
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span style="font-weight: 700; color: var(--color-primary);">
                      {prefObj ? prefObj.nameJa : post.data.pref}
                    </span>
                    <span>•</span>
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <span style="font-weight: 700; color: var(--color-accent);">🏷️ {post.data.season}</span>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/${post.data.pref}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/${post.data.pref}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      モデルコースを見る &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {/* この月に行くべきおすすめ都道府県 */}
    <section>
      <div style="margin-bottom: 1.5rem;">
        <h2 style="font-size: 1.45rem; font-weight: 800; margin-bottom: 0.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-primary);">📍</span> {theme.nameJa}に行くべきおすすめ都道府県
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">
          この時期に年間屈指の見頃やグルメ解禁を迎える注目エリアです。
        </p>
      </div>

      <div class="prefecture-grid">
        {recommendedPrefs.map((pref) => (
          <a href={`/${pref.id}/${theme.month}/`} class="pref-card">
            <div class="pref-card-header">
              <span class="pref-card-title">{pref.nameJa}</span>
              <span class="pref-card-en">{pref.nameEn}</span>
            </div>
            <div class="pref-card-highlights">
              {pref.highlightsJa.slice(0, 3).map((item) => (
                <span class="pref-card-tag">{item}</span>
              ))}
            </div>
            <div style="margin-top: 0.75rem; font-size: 0.8rem; font-weight: 700; color: var(--color-primary); display: flex; align-items: center; justify-content: space-between; border-top: 1px dashed var(--color-border); padding-top: 0.5rem;">
              <span>{theme.nameJa}の{pref.nameJa}ガイドを見る</span>
              <span>&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</Layout>

<style>
  .month-selector-wrapper {
    margin-top: 1.5rem;
    background: rgba(255, 255, 255, 0.15);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: var(--radius-lg);
    padding: 1rem 1.25rem;
  }

  .month-selector-title {
    display: block;
    font-size: 0.82rem;
    font-weight: 800;
    color: #ffffff;
    margin-bottom: 0.65rem;
    letter-spacing: 0.02em;
  }

  .month-pill-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 0.35rem;
  }

  .month-pill {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: var(--radius-md);
    padding: 0.45rem 0.15rem;
    text-decoration: none;
    transition: all 0.2s ease;
    min-height: 48px;
  }

  .month-pill:hover {
    background: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
  }

  .month-pill.is-active {
    background: var(--color-primary);
    border-color: #ffffff;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
    transform: translateY(-2px);
  }

  .month-pill-icon {
    font-size: 0.95rem;
    line-height: 1;
    margin-bottom: 0.15rem;
  }

  .month-pill-name {
    font-size: 0.76rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .month-pill.is-active .month-pill-name {
    color: #ffffff;
  }

  /* Timeline Grid */
  .season-timeline-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }

  .period-card {
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .period-card-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.85rem 1.25rem;
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
  }

  .period-early {
    border-left: 5px solid #2e7d32;
  }

  .period-mid {
    border-left: 5px solid #e65100;
  }

  .period-late {
    border-left: 5px solid #1a365d;
  }

  .period-badge {
    font-size: 0.9rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .period-icon {
    font-size: 1.1rem;
  }

  .period-card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .period-highlight-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .period-highlight-list li {
    font-size: 0.9rem;
    line-height: 1.55;
    color: var(--color-text-main);
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
  }

  .period-bullet {
    color: var(--color-primary);
    font-weight: 800;
  }

  .period-tip-box {
    margin-top: auto;
    background: var(--color-bg-alt);
    border-radius: var(--radius-sm);
    padding: 0.65rem 0.85rem;
    font-size: 0.82rem;
  }

  .tip-label {
    font-weight: 800;
    color: var(--color-accent);
    display: block;
    margin-bottom: 0.15rem;
  }

  .tip-text {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.45;
  }

  @media (max-width: 900px) {
    .month-pill-grid {
      grid-template-columns: repeat(6, 1fr);
      gap: 0.35rem;
    }
  }

  @media (max-width: 500px) {
    .month-pill-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
