---
import Layout from '../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../data/prefectures';
import { getCollection } from 'astro:content';

export function getStaticPaths() {
  return PREFECTURES.map((pref) => ({
    params: { pref: pref.id },
    props: { pref },
  }));
}

interface Props {
  pref: Prefecture;
}

const { pref } = Astro.props;

// Fetch articles for this prefecture in Japanese
const prefArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && data.pref === pref.id && !data.draft;
});

const sortedArticles = prefArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<Layout
  title={`${pref.nameJa}（${pref.nameEn}）の旬とリアルタイム旅行情報 - tavi-navi`}
  description={`${pref.nameJa}の最新旅行・観光情報。今週のイベント、季節の見どころ（${pref.highlightsJa.join('・')}）、おすすめスポットやグルメ情報をお届けします。`}
  lang="ja"
  currentPref={pref.id}
>
  <div style="background: #ffffff; border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
    <div class="container" style="font-size: 0.85rem; color: var(--color-text-muted);">
      <a href="/" style="color: var(--color-primary);">ホーム</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span>{pref.regionNameJa}</span>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span style="font-weight: 700; color: var(--color-text-main);">{pref.nameJa}</span>
    </div>
  </div>

  <div class="hero-banner" style="padding: 2.5rem 0 2rem;">
    <div class="container">
      <span class="badge-seasonal">{pref.regionNameJa}エリア</span>
      <h1 class="hero-title" style="margin-top: 0.75rem;">
        {pref.nameJa}
        <span style="font-size: 1.25rem; font-weight: 500; opacity: 0.85; margin-left: 0.5rem;">{pref.nameEn}</span>
      </h1>
      <p class="hero-subtitle">
        {pref.descriptionJa}
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 1rem;">
        {pref.highlightsJa.map((item) => (
          <span style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(4px); color: #ffffff; font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: var(--radius-full);">
            #{item}
          </span>
        ))}
      </div>
    </div>
  </div>

  <div class="container" style="padding-top: 2.5rem; padding-bottom: 3.5rem;">
    {/* リアルタイム旬インフォボックス */}
    <div style="background: #ffffff; border: 1px solid var(--color-border); border-left: 5px solid var(--color-accent); border-radius: var(--radius-md); padding: 1.5rem; margin-bottom: 2.5rem; box-shadow: var(--shadow-sm);">
      <h2 style="font-size: 1.15rem; font-weight: 800; color: var(--color-text-main); margin-bottom: 0.75rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-accent);">📢</span> {pref.nameJa}の現在の旬・旅行ハイライト
      </h2>
      <ul style="padding-left: 1.25rem; font-size: 0.95rem; line-height: 1.8; color: var(--color-text-main);">
        <li><strong>主な見どころ</strong>: {pref.highlightsJa.join('、')}</li>
        <li><strong>県庁所在地</strong>: {pref.capitalJa}</li>
        <li><strong>現在のシーズン</strong>: 秋（紅葉・収穫祭・秋の味覚フェアが見頃を迎えています）</li>
      </ul>
    </div>

    {/* 該当都道府県の記事一覧 */}
    <section>
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-primary);">📚</span> {pref.nameJa}の最新旅行記事・ガイド
      </h2>

      {sortedArticles.length > 0 ? (
        <div class="article-grid">
          {sortedArticles.map((post) => {
            const articleSlug = post.id.replace(/\.(md|mdx)$/, '');
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('ja-JP')}
                    </time>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/${pref.id}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/${pref.id}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      記事を読む &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div style="background: #ffffff; border: 1px dashed var(--color-border); border-radius: var(--radius-md); padding: 3rem 1.5rem; text-align: center; color: var(--color-text-muted);">
          <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.5rem;">現在、{pref.nameJa}の新規記事を順次取材・編集中です。</p>
          <p style="font-size: 0.9rem;">リアルタイムな旬の旅行速報を近日公開予定ですので、どうぞお楽しみに！</p>
        </div>
      )}
    </section>

    {/* 他の都道府県へジャンプ */}
    <div style="margin-top: 3.5rem; text-align: center;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid var(--color-border); padding: 0.65rem 1.25rem; border-radius: var(--radius-full); font-size: 0.9rem; font-weight: 700; color: var(--color-text-main);">
        &larr; 全国の都道府県一覧へ戻る
      </a>
    </div>
  </div>
</Layout>
