---
import Layout from '../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../data/prefectures';
import { MONTHLY_THEMES } from '../../data/monthlyThemes';
import { getCitiesByPrefecture } from '../../data/cities';
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../../utils/slug';
import SeasonalTabs from '../../components/SeasonalTabs.astro';

export function getStaticPaths() {
  return PREFECTURES.map((pref) => ({
    params: { pref: pref.id },
    props: { pref },
  }));
}

interface Props {
  pref: Prefecture;
}

const { pref } = Astro.props;

// Fetch articles for this prefecture in Japanese
const prefArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'ja' && data.pref === pref.id && !data.draft;
});

const sortedArticles = prefArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const prefCities = getCitiesByPrefecture(pref.id);
---

<Layout
  title={`${pref.nameJa}（${pref.nameEn}）の旬とリアルタイム旅行情報 - tavi-navi`}
  description={`${pref.nameJa}の最新旅行・観光情報。今週のイベント、季節の見どころ（${pref.highlightsJa.join('・')}）、おすすめスポットやグルメ情報をお届けします。`}
  lang="ja"
  currentPref={pref.id}
>
  <div style="background: #ffffff; border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
    <div class="container" style="font-size: 0.85rem; color: var(--color-text-muted);">
      <a href="/" style="color: var(--color-primary);">ホーム</a>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span>{pref.regionNameJa}</span>
      <span style="margin: 0 0.4rem;">&gt;</span>
      <span style="font-weight: 700; color: var(--color-text-main);">{pref.nameJa}</span>
    </div>
  </div>

  <div class="hero-banner" style="padding: 2.5rem 0 2rem;">
    <div class="container">
      <span class="badge-seasonal">{pref.regionNameJa}エリア</span>
      <h1 class="hero-title" style="margin-top: 0.75rem;">
        {pref.nameJa}
        <span style="font-size: 1.25rem; font-weight: 500; opacity: 0.85; margin-left: 0.5rem;">{pref.nameEn}</span>
      </h1>
      <p class="hero-subtitle">
        {pref.descriptionJa}
      </p>
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 0.5rem; margin-top: 1rem;">
        {pref.highlightsJa.map((item) => (
          <span style="background: rgba(255, 255, 255, 0.2); backdrop-filter: blur(4px); color: #ffffff; font-size: 0.8rem; font-weight: 600; padding: 0.25rem 0.75rem; border-radius: var(--radius-full);">
            #{item}
          </span>
        ))}
      </div>

      {/* 1月〜12月 月別セレクター */}
      <div style="margin-top: 1.5rem; background: rgba(0, 0, 0, 0.25); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 12px; padding: 1rem 1.25rem; max-width: 760px; margin-left: auto; margin-right: auto;">
        <span style="display: block; font-size: 0.82rem; font-weight: 700; color: #a7f3d0; margin-bottom: 0.6rem; text-align: left;">
          🗓️ {pref.nameJa}の時期・月から探す（1月〜12月）:
        </span>
        <div style="display: grid; grid-template-columns: repeat(12, 1fr); gap: 0.35rem;">
          {MONTHLY_THEMES.map((m) => (
            <a
              href={`/${pref.id}/${m.month}/`}
              style="display: flex; flex-direction: column; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.15); border: 1px solid rgba(255, 255, 255, 0.25); border-radius: 6px; padding: 0.4rem 0.1rem; text-decoration: none; color: #ffffff; font-size: 0.75rem; font-weight: 700; transition: all 0.15s ease;"
            >
              <span style="font-size: 0.95rem; line-height: 1; margin-bottom: 0.15rem;">{m.icon}</span>
              <span>{m.nameJa}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="container" style="padding-top: 2.5rem; padding-bottom: 3.5rem;">
    {/* この先4シーズンの旬タイムライン・スタイル別ガイド（タブ切り替え） */}
    <SeasonalTabs
      prefId={pref.id}
      prefName={pref.nameJa}
      region={pref.region}
      lang="ja"
      articles={sortedArticles}
    />

    {/* 主要市町村・観光エリア */}
    {prefCities.length > 0 && (
      <section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-primary);">🏛️</span> {pref.nameJa}の主要エリア・市町村から探す
        </h2>
        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 1.25rem;">
          {prefCities.map((c) => (
            <a
              href={`/${pref.id}/${c.id}/`}
              style="background: #ffffff; border: 1.5px solid var(--color-border); border-radius: 12px; padding: 1.25rem; text-decoration: none; color: inherit; display: flex; flex-direction: column; justify-content: space-between; transition: all 0.2s ease; box-shadow: 0 2px 6px rgba(0,0,0,0.04);"
            >
              <div>
                <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 0.4rem;">
                  <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--color-text-main); margin: 0;">{c.nameJa}</h3>
                  <span style="font-size: 0.8rem; color: var(--color-text-muted);">{c.nameEn}</span>
                </div>
                <p style="font-size: 0.85rem; color: var(--color-text-muted); line-height: 1.5; margin: 0 0 0.85rem;">
                  {c.catchphraseJa}
                </p>
                <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1rem;">
                  {c.highlightsJa.slice(0, 3).map((h) => (
                    <span style="font-size: 0.72rem; background: var(--color-bg-base); padding: 0.15rem 0.5rem; border-radius: 4px; color: var(--color-text-muted);">
                      {h}
                    </span>
                  ))}
                </div>
              </div>
              <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; font-weight: 700; color: var(--color-primary); border-top: 1px dashed var(--color-border); padding-top: 0.6rem;">
                <span>{c.nameJa}の旬と観光ガイドを見る</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {/* 該当都道府県の記事一覧 */}
    <section>
      <h2 style="font-size: 1.4rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
        <span style="color: var(--color-primary);">📚</span> {pref.nameJa}の最新旅行記事・ガイド
      </h2>

      {sortedArticles.length > 0 ? (
        <div class="article-grid">
          {sortedArticles.map((post) => {
            const articleSlug = getArticleSlug(post.id, post.data.pref);
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('ja-JP')}
                    </time>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/${pref.id}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/${pref.id}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      記事を読む &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      ) : (
        <div style="background: #ffffff; border: 1px dashed var(--color-border); border-radius: var(--radius-md); padding: 3rem 1.5rem; text-align: center; color: var(--color-text-muted);">
          <p style="font-size: 1.05rem; font-weight: 600; margin-bottom: 0.5rem;">現在、{pref.nameJa}の新規記事を順次取材・編集中です。</p>
          <p style="font-size: 0.9rem;">リアルタイムな旬の旅行速報を近日公開予定ですので、どうぞお楽しみに！</p>
        </div>
      )}
    </section>

    {/* 他の都道府県へジャンプ */}
    <div style="margin-top: 3.5rem; text-align: center;">
      <a href="/" style="display: inline-flex; align-items: center; gap: 0.5rem; background: #ffffff; border: 1px solid var(--color-border); padding: 0.65rem 1.25rem; border-radius: var(--radius-full); font-size: 0.9rem; font-weight: 700; color: var(--color-text-main);">
        &larr; 全国の都道府県一覧へ戻る
      </a>
    </div>
  </div>
</Layout>
