    padding: 0.75rem 0 0.85rem;
    background: transparent;
    border-bottom: 1px solid #e2e8f0;
  }
  .e-smart-toc[hidden] {
    display: none;
  }
  .e-smart-toc-label {
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 800;
