    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-size: 0.82rem;
    color: #64748b;
  }

  /* 1カラム没入型シェル（最大幅 820px） */
  .e-body-shell {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 1.25rem 3.5rem;
  }

  /* スマート目次バー（枠を減らした静かなテキストリンク） */
  .e-smart-toc {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
