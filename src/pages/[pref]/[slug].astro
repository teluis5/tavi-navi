  }
  .pref-hub-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: var(--color-teal-soft, #E6F4F7);
    border: 1px solid #bae0e8;
    border-radius: 10px;
    padding: 1.1rem 1.35rem;
    text-decoration: none;
