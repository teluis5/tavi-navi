---
import Layout from '../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../data/prefectures';
import { MONTHLY_THEMES, type MonthTheme } from '../../data/monthlyThemes';
import { CITIES, type City } from '../../data/cities';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../../utils/slug';
import SeasonalTabs from '../../components/SeasonalTabs.astro';
import PrefectureMonthPage from '../../components/PrefectureMonthPage.astro';
import CityHubPage from '../../components/CityHubPage.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.lang === 'ja' && !data.draft;
  });

  // 1. 各記事の詳細ページ (/kanagawa/yokohama-autumn-kids-no-car/ など)
  const articlePaths = articles.map((article) => {
    const slug = getArticleSlug(article.id, article.data.pref);
    return {
      params: {
        pref: article.data.pref,
        slug: slug,
      },
      props: {
        pageType: 'article' as const,
        article,
      },
    };
  });

  // 2. 都道府県 × 1月〜12月の月別ガイド (/hokkaido/6/, /shizuoka/11/ など)
  const monthPaths = PREFECTURES.flatMap((pref) => {
    return MONTHLY_THEMES.map((theme) => {
      const matchingArticles = articles.filter((art) => {
        if (art.data.pref !== pref.id) return false;
        const s = art.data.season || '';
        return s.includes(`${theme.month}月`);
      });
      const allPrefArticles = articles.filter((art) => art.data.pref === pref.id);

      return {
        params: {
          pref: pref.id,
          slug: String(theme.month),
        },
        props: {
          pageType: 'month' as const,
          pref,
          month: theme.month,
          monthTheme: theme,
          monthArticles: matchingArticles,
          allPrefArticles,
        },
      };
    });
  });

  // 3. 市町村・主要エリアトップ (/hokkaido/furano/, /shizuoka/atami/ など)
  const cityPaths = CITIES.map((city) => {
    const pref = PREFECTURES.find((p) => p.id === city.prefId) || {
      id: city.prefId,
      code: 0,
      nameJa: city.prefId,
      nameEn: city.prefId,
      region: city.region,
      regionNameJa: '',
      regionNameEn: '',
      capitalJa: '',
      capitalEn: '',
      highlightsJa: [],
      highlightsEn: [],
      descriptionJa: '',
      descriptionEn: '',
    };

    const matchingArticles = articles.filter((art) => {
      if (art.data.pref !== city.prefId) return false;
      return art.data.cities.includes(city.id) || art.data.tags.includes(city.nameJa);
    });
    const allPrefArticles = articles.filter((art) => art.data.pref === city.prefId);

    return {
      params: {
        pref: city.prefId,
        slug: city.id,
      },
      props: {
        pageType: 'city' as const,
        pref,
        city,
        cityArticles: matchingArticles,
        allPrefArticles,
      },
    };
  });

  return [...articlePaths, ...monthPaths, ...cityPaths];
}

type Props =
  | {
      pageType: 'article';
      article: CollectionEntry<'articles'>;
    }
  | {
      pageType: 'month';
      pref: Prefecture;
      month: number;
      monthTheme: MonthTheme;
      monthArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    }
  | {
      pageType: 'city';
      pref: Prefecture;
      city: City;
      cityArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    };

const props = Astro.props as Props;

// 記事ページ用の変数（pageType === 'article' の場合のみ解決）
let article: CollectionEntry<'articles'> | undefined;
let ContentComponent: any;
let prefName = '';
let prefSlug = '';
let prefRegion = 'kanto';
let prefArticles: CollectionEntry<'articles'>[] = [];
let articleMonth: number | undefined;

if (props.pageType === 'article') {
  article = props.article;
  const rendered = await render(article);
  ContentComponent = rendered.Content;

  const prefObj = PREFECTURES.find((p) => p.id === article.data.pref);
  prefName = prefObj ? prefObj.nameJa : article.data.pref;
  prefSlug = article.data.pref;
  prefRegion = prefObj ? prefObj.region : 'kanto';

  prefArticles = await getCollection('articles', ({ data }) => {
    return data.lang === 'ja' && data.pref === prefSlug && !data.draft;
  });

  if (article.data.season) {
    const m = article.data.season.match(/(\d+)月/);
    if (m) articleMonth = parseInt(m[1], 10);
  }
}
---

{props.pageType === 'month' ? (
  <PrefectureMonthPage
    pref={props.pref}
    month={props.month}
    monthTheme={props.monthTheme}
    articles={props.monthArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : props.pageType === 'city' ? (
  <CityHubPage
    pref={props.pref}
    city={props.city}
    articles={props.cityArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : article ? (
  <Layout
    title={`${article.data.title} - tavi-navi`}
    description={article.data.description}
    image={article.data.heroImage}
    lang="ja"
    currentPref={prefSlug}
  >
    <div class="layout-container">
      <!-- メインコンテンツ (左カラム) -->
      <article class="layout-main box google-anno-skip">
        <!-- パンくずリスト -->
        <div style="font-size: 0.85rem; color: var(--text-light); margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);">
          <a href="/" style="color: var(--theme-accent);">ホーム</a>
          <span style="margin: 0 0.4rem;">&gt;</span>
          <a href={`/${prefSlug}/`} style="color: var(--theme-accent);">{prefName}</a>
          <span style="margin: 0 0.4rem;">&gt;</span>
          <span>{article.data.title}</span>
        </div>

        <header style="margin-bottom: 2rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <a href={`/${prefSlug}/`} class="badge-seasonal" style="background: var(--color-primary-light); color: var(--color-primary-dark);">
              📍 {prefName}
            </a>
            <span class="badge-seasonal">{article.data.category}</span>
            {article.data.season && (
              <span class="badge-seasonal" style="background: #fef08a; color: #854d0e;">
                {article.data.season}
              </span>
            )}
          </div>

          <h1 style="font-size: 1.85rem; font-weight: 900; line-height: 1.4; color: var(--text-main); margin-bottom: 1rem;">
            {article.data.title}
          </h1>

          <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.85rem; color: var(--text-light); border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
            <span>公開日: {article.data.pubDate.toLocaleDateString('ja-JP')}</span>
            {article.data.updatedDate && (
              <span>更新日: {article.data.updatedDate.toLocaleDateString('ja-JP')}</span>
            )}
          </div>
        </header>

        {article.data.heroImage === '/thumbnails/akita-dokokanibyun-tazawako-real-v5.png' && (
          <figure style="margin: 0 0 2rem;">
            <img src={article.data.heroImage} alt="雪の田沢湖に立つたつこ像。田沢湖・乳頭温泉の車なし1泊2日モデルコース" width="1200" height="630" style="display: block; width: 100%; height: auto; border-radius: 8px;" />
            <figcaption style="font-size: 0.7rem; color: var(--text-light); margin-top: 0.25rem;">Akita Prefecture</figcaption>
          </figure>
        )}

        <div class="prose google-anno-skip">
          <ContentComponent />
        </div>

        <!-- 読了後の回遊用：秋田県トップ案内 ＆ 類似・関連モデルコース -->
        <section class="related-pref-section" style="margin-top: 3.5rem; padding-top: 2rem; border-top: 2px solid var(--border-color);">
          <!-- 都道府県ハブ導線バナー -->
          <a
            href={`/${prefSlug}/`}
            class="pref-hub-banner"
            style="display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%); border: 1px solid #bae6fd; border-radius: 8px; padding: 1.25rem 1.5rem; text-decoration: none; margin-bottom: 2rem; transition: transform 0.15s ease, box-shadow 0.15s ease;"
          >
            <div>
              <span style="font-size: 0.78rem; font-weight: 800; color: #0284c7; letter-spacing: 0.05em; text-transform: uppercase;">PREFECTURE GUIDE</span>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); margin: 0.25rem 0 0.15rem;">
                📍 {prefName}の旅情報・モデルコース一覧を見る
              </h3>
              <p style="font-size: 0.85rem; color: var(--text-light); margin: 0;">
                {prefName}の最新観光ガイド、旬のイベント、車なしモデルコースをまとめてチェック
              </p>
            </div>
            <span style="font-size: 1.4rem; color: #0284c7; margin-left: 1rem; font-weight: 700;">&rarr;</span>
          </a>

          <!-- 同一都道府県の類似・おすすめ記事 -->
          {(() => {
            const relatedArticles = prefArticles
              .filter((a) => a.id !== article!.id)
              .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
              .slice(0, 3);

            if (relatedArticles.length === 0) return null;

            return (
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                  <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.4rem;">
                    <span>🧭</span> {prefName}のあわせて読みたい人気モデルコース
                  </h3>
                  <a href={`/${prefSlug}/`} style="font-size: 0.82rem; font-weight: 700; color: var(--theme-accent); text-decoration: none;">
                    すべて見る &rarr;
                  </a>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                  {relatedArticles.map((rel) => {
                    const relSlug = getArticleSlug(rel.id, rel.data.pref);
                    return (
                      <a
                        href={`/${prefSlug}/${relSlug}/`}
                        style="display: flex; flex-direction: column; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; text-decoration: none; color: inherit; transition: transform 0.15s ease, box-shadow 0.15s ease;"
                        class="related-article-card"
                      >
                        <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--text-light); margin-bottom: 0.5rem;">
                          <span style="background: var(--bg-main); padding: 0.15rem 0.45rem; border-radius: 4px; font-weight: 700; color: var(--text-main);">
                            {rel.data.category}
                          </span>
                          {rel.data.duration && (
                            <span>· {rel.data.duration}</span>
                          )}
                        </div>
                        <h4 style="font-size: 0.92rem; font-weight: 800; line-height: 1.45; color: var(--text-main); margin: 0 0 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                          {rel.data.title}
                        </h4>
                        <p style="font-size: 0.8rem; line-height: 1.5; color: var(--text-light); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                          {rel.data.description}
                        </p>
                        <span style="font-size: 0.78rem; font-weight: 700; color: var(--theme-accent); margin-top: auto; padding-top: 0.75rem;">
                          記事を読む &rarr;
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })()}
        </section>

        <footer style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            {article.data.tags.map((tag: string) => (
              <span style="font-size: 0.8rem; background: var(--bg-main); border: 1px solid var(--border-color); padding: 0.2rem 0.6rem; border-radius: var(--radius-full); color: var(--text-light);">
                #{tag}
              </span>
            ))}
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center;">
            <a href={`/${prefSlug}/`} style="font-weight: 700; font-size: 0.9rem; color: var(--theme-accent);">
              &larr; {prefName}の旅情報一覧へ
            </a>
            <a href="/" style="font-weight: 700; font-size: 0.9rem; color: var(--text-light);">
              全国トップへ戻る
            </a>
          </div>
        </footer>
      </article>

      <!-- サイドバー (右カラム) -->
      <aside class="layout-sidebar">
        <!-- 運営者プロフィール -->
        <div class="sidebar-widget box" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem; box-shadow: var(--shadow);">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; color: var(--text-main);">
            <span>🧭</span>
            <span>タビナビ (tavi-navi) について</span>
          </div>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--text-light); margin-bottom: 1rem;">
            47都道府県の「今週・来月行くべき旬のスポット」を現地写真と一次情報で速報する旅行ガイドメディア。車なし×新幹線・公共交通ルートも完全網羅。
          </p>
          <div style="font-size: 0.82rem; background: var(--bg-main); padding: 0.6rem 0.8rem; border-radius: var(--radius); color: var(--text-main); border: 1px solid var(--border-color);">
            ✨ <strong>公式観光写真アーカイブ連携</strong><br/>
            秋田県観光連盟をはじめ、各自治体の高画質公式写真と連携して配信しています。
          </div>
        </div>

        <!-- エリアナビゲーション -->
        <div class="sidebar-widget box" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem; box-shadow: var(--shadow);">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; color: var(--text-main);">
            <span>📍</span>
            <span>{prefName}の主要エリア</span>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.88rem;">
            {CITIES.filter((c) => c.prefId === prefSlug).map((city) => (
              <li style="margin-bottom: 0.45rem;">
                <a href={`/${prefSlug}/${city.id}/`} style="display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0.65rem; border-radius: var(--radius); background: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-main); font-weight: 700; text-decoration: none;">
                  <span>{city.nameJa}</span>
                  <span style="font-size: 0.75rem; color: var(--theme-accent);">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- 旬のモデルコース -->
        <div class="sidebar-widget box" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.25rem; box-shadow: var(--shadow);">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; color: var(--text-main);">
            <span>❄️</span>
            <span>注目の旬モデルコース</span>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.85rem;">
            <li style="margin-bottom: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px dashed var(--border-color);">
              <a href="/hokkaido/early-june-best-route/" style="font-weight: 700; color: var(--text-main); display: block; margin-bottom: 0.2rem; line-height: 1.4;">
                【6月上旬の北海道】富良野・美瑛の新緑＆積丹ウニ解禁
              </a>
              <span style="color: var(--text-light); font-size: 0.75rem;">北海道・2泊3日</span>
            </li>
            <li>
              <a href="/akita/winter-kakunodate-nyuto-onsen/" style="font-weight: 700; color: var(--theme-accent); display: block; margin-bottom: 0.2rem; line-height: 1.4;">
                【冬の秋田2泊3日】角館武家屋敷の雪景色・田沢湖・乳頭温泉郷
              </a>
              <span style="color: var(--text-light); font-size: 0.75rem;">秋田県・2泊3日</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </Layout>
) : null}
