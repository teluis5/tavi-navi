---
import Layout from '../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../data/prefectures';
import { MONTHLY_THEMES, type MonthTheme } from '../../data/monthlyThemes';
import { CITIES, type City } from '../../data/cities';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../../utils/slug';
import SeasonalTabs from '../../components/SeasonalTabs.astro';
import PrefectureMonthPage from '../../components/PrefectureMonthPage.astro';
import CityHubPage from '../../components/CityHubPage.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.lang === 'ja' && !data.draft;
  });

  // 1. 各記事の詳細ページ (/kanagawa/yokohama-autumn-kids-no-car/ など)
  const articlePaths = articles.map((article) => {
    const slug = getArticleSlug(article.id, article.data.pref);
    return {
      params: {
        pref: article.data.pref,
        slug: slug,
      },
      props: {
        pageType: 'article' as const,
        article,
      },
    };
  });

  // 2. 都道府県 × 1月〜12月の月別ガイド (/hokkaido/6/, /shizuoka/11/ など)
  const monthPaths = PREFECTURES.flatMap((pref) => {
    return MONTHLY_THEMES.map((theme) => {
      const matchingArticles = articles.filter((art) => {
        if (art.data.pref !== pref.id) return false;
        const s = art.data.season || '';
        return s.includes(`${theme.month}月`);
      });
      const allPrefArticles = articles.filter((art) => art.data.pref === pref.id);

      return {
        params: {
          pref: pref.id,
          slug: String(theme.month),
        },
        props: {
          pageType: 'month' as const,
          pref,
          month: theme.month,
          monthTheme: theme,
          monthArticles: matchingArticles,
          allPrefArticles,
        },
      };
    });
  });

  // 3. 市町村・主要エリアトップ (/hokkaido/furano/, /shizuoka/atami/ など)
  const cityPaths = CITIES.map((city) => {
    const pref = PREFECTURES.find((p) => p.id === city.prefId) || {
      id: city.prefId,
      code: 0,
      nameJa: city.prefId,
      nameEn: city.prefId,
      region: city.region,
      regionNameJa: '',
      regionNameEn: '',
      capitalJa: '',
      capitalEn: '',
      highlightsJa: [],
      highlightsEn: [],
      descriptionJa: '',
      descriptionEn: '',
    };

    const matchingArticles = articles.filter((art) => {
      if (art.data.pref !== city.prefId) return false;
      return art.data.cities.includes(city.id) || art.data.tags.includes(city.nameJa);
    });
    const allPrefArticles = articles.filter((art) => art.data.pref === city.prefId);

    return {
      params: {
        pref: city.prefId,
        slug: city.id,
      },
      props: {
        pageType: 'city' as const,
        pref,
        city,
        cityArticles: matchingArticles,
        allPrefArticles,
      },
    };
  });

  return [...articlePaths, ...monthPaths, ...cityPaths];
}

type Props =
  | {
      pageType: 'article';
      article: CollectionEntry<'articles'>;
    }
  | {
      pageType: 'month';
      pref: Prefecture;
      month: number;
      monthTheme: MonthTheme;
      monthArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    }
  | {
      pageType: 'city';
      pref: Prefecture;
      city: City;
      cityArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    };

const props = Astro.props as Props;

// 記事ページ用の変数（pageType === 'article' の場合のみ解決）
let article: CollectionEntry<'articles'> | undefined;
let ContentComponent: any;
let tocHeadings: { depth: number; slug: string; text: string }[] = [];
let prefName = '';
let prefSlug = '';
let isSpecial = false;
let hubHref = '';
let prefRegion = 'kanto';
let prefArticles: CollectionEntry<'articles'>[] = [];
let articleMonth: number | undefined;
const featuredPrefs = PREFECTURES.filter((p) =>
  ['hokkaido', 'aomori', 'iwate', 'akita', 'tokyo', 'kanagawa', 'shizuoka', 'kyoto'].includes(p.id)
);

if (props.pageType === 'article') {
  article = props.article;
  const rendered = await render(article);
  ContentComponent = rendered.Content;
  tocHeadings = (rendered.headings || []).filter((h) => h.depth === 2);

  const prefObj = PREFECTURES.find((p) => p.id === article.data.pref);
  isSpecial = article.data.pref === 'special';
  prefName = isSpecial ? 'どこかにビューーン！' : prefObj ? prefObj.nameJa : article.data.pref;
  prefSlug = article.data.pref;
  hubHref = isSpecial ? '/special/dokokanibyun/' : `/${prefSlug}/`;
  prefRegion = prefObj ? prefObj.region : 'kanto';

  prefArticles = await getCollection('articles', ({ data }) => {
    return data.lang === 'ja' && data.pref === prefSlug && !data.draft;
  });

  if (article.data.season) {
    const m = article.data.season.match(/(\d+)月/);
    if (m) articleMonth = parseInt(m[1], 10);
  }
}
---

{props.pageType === 'month' ? (
  <PrefectureMonthPage
    pref={props.pref}
    month={props.month}
    monthTheme={props.monthTheme}
    articles={props.monthArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : props.pageType === 'city' ? (
  <CityHubPage
    pref={props.pref}
    city={props.city}
    articles={props.cityArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : article ? (
  <Layout
    title={`${article.data.title} - tavi-navi`}
    description={article.data.description}
    image={article.data.heroImage}
    lang="ja"
    currentPref={prefSlug}
    fullWidth={true}
  >
    <!-- 1段目：全幅ヒーロー画像（背景のみブラー） ➔ タイトル・副題・メタ -->
    <section class="e-hero-section">
      {article.data.heroImage && (
        <figure class="e-hero-figure">
          <div
            class="e-hero-blur-bg"
            style={`background-image: url('${article.data.heroImage}')`}
            aria-hidden="true"
          ></div>
          <div class="e-hero-img-wrap">
            <img
              src={article.data.heroImage}
              alt={article.data.title}
              width="1200"
              height="630"
            />
            <figcaption class="e-hero-credit">写真提供：一般社団法人 秋田県観光連盟</figcaption>
          </div>
        </figure>
      )}

      <div class="e-header-inner">
        <h1 class="e-title">{article.data.displayTitle || article.data.title}</h1>
        {article.data.subtitle && (
          <p class="e-subtitle">{article.data.subtitle}</p>
        )}

        <div class="e-meta-row">
          <div class="e-badges">
            <a href={hubHref} class="e-badge primary">
              {isSpecial ? '🚅' : '📍'} {prefName}
            </a>
            <span class="e-badge">{article.data.category}</span>
            {article.data.season && (
              <span class="e-badge season">{article.data.season}</span>
            )}
            {article.data.tags?.some((t: string) => t.includes('車なし')) && (
              <span class="e-badge outline">車なし</span>
            )}
          </div>

          <span class="e-meta-divider" aria-hidden="true">|</span>

          <div class="e-dates">
            <span>公開日: {article.data.pubDate.toLocaleDateString('ja-JP')}</span>
            {article.data.updatedDate && (
              <span>更新日: {article.data.updatedDate.toLocaleDateString('ja-JP')}</span>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 2段目：左サイドバー（上部目次 ＋ 下部メニュー：全体固定）＋ 右本文 -->
    <div class="e-body-shell">
      <aside class="e-sidebar" aria-label="目次とサイトメニュー">
        <div class="e-sidebar-container">
          <!-- 上部：目次エリア -->
          <div class="e-sidebar-toc-box">
            <div class="e-sidebar-heading">
              <span class="e-sidebar-heading-text">目次</span>
            </div>
            {tocHeadings.length > 0 ? (
              <nav class="e-toc-nav" aria-label="この記事の目次">
                <ul>
                  {tocHeadings.map((h) => (
                    <li class={`e-toc-item depth-${h.depth}`}>
                      <a href={`#${h.slug}`} class="e-toc-link" data-toc-link={h.slug}>
                        {h.text}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            ) : (
              <p class="e-toc-empty">この記事には見出しがありません。</p>
            )}
          </div>

          <!-- 下部：サイトメニューエリア（サイト案内は固定、その下をスクロール可能） -->
          <div class="e-sidebar-menu-box" aria-label="サイトメニュー">
            <div class="e-sidebar-heading">
              <span class="e-sidebar-heading-text">メニュー</span>
            </div>

            <div class="menu-group e-menu-fixed-group">
              <p class="menu-label">サイト案内</p>
              <ul class="menu-list">
                <li><a href="/" class="menu-link">🏠 全国トップ</a></li>
                <li><a href="/special/dokokanibyun/" class="menu-link">🚅 どこかにビューーン！</a></li>
                <li><a href="/season/" class="menu-link">🗓️ 旬の季節・月別ガイド</a></li>
              </ul>
            </div>

            <div class="e-menu-scroll-wrap">
              <div class="e-menu-scroll" id="menu-scroll-area" tabindex="0" aria-label="エリア・月別・都道府県メニュー">
                {!isSpecial && CITIES.filter((c) => c.prefId === prefSlug).length > 0 && (
                  <div class="menu-group">
                    <p class="menu-label">📍 {prefName}のエリア</p>
                    <div class="menu-chips">
                      <a href={hubHref} class="menu-chip is-current">{prefName}トップ</a>
                      {CITIES.filter((c) => c.prefId === prefSlug).map((city) => (
                        <a href={`/${prefSlug}/${city.id}/`} class="menu-chip">{city.nameJa}</a>
                      ))}
                    </div>
                  </div>
                )}

                <div class="menu-group">
                  <p class="menu-label">📅 {isSpecial ? '全国の月別ガイド' : `${prefName}の月別ガイド`}</p>
                  <div class="menu-month-grid">
                    {MONTHLY_THEMES.map((m) => (
                      <a href={isSpecial ? `/season/${m.month}/` : `/${prefSlug}/${m.month}/`} class="menu-month-chip">
                        {m.month}月
                      </a>
                    ))}
                  </div>
                </div>

                <div class="menu-group">
                  <p class="menu-label">🗾 人気の都道府県</p>
                  <div class="menu-chips">
                    {featuredPrefs.map((p) => (
                      <a href={`/${p.id}/`} class={`menu-chip ${p.id === prefSlug ? 'is-current' : ''}`}>
                        {p.nameJa}
                      </a>
                    ))}
                  </div>
                </div>
              </div>

              <button
                type="button"
                class="e-menu-scroll-hint"
                id="menu-scroll-hint"
                aria-label="下にスクロール"
                hidden
              >
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </aside>

      <!-- メイン本文カラム -->
      <article class="e-article google-anno-skip">
        <div class="prose google-anno-skip">
          <ContentComponent />
        </div>

        <!-- 読了後の回遊用：都道府県トップ案内 ＆ 類似・関連モデルコース -->
        {!isSpecial && <section class="related-pref-section" style="margin-top: 3.5rem; padding-top: 2rem; border-top: 2px solid var(--border-color);">
          <a
            href={`/${prefSlug}/`}
            class="pref-hub-banner"
            style="display: flex; align-items: center; justify-content: space-between; background: linear-gradient(135deg, #f0fdf4 0%, #e0f2fe 100%); border: 1px solid #bae6fd; border-radius: 8px; padding: 1.25rem 1.5rem; text-decoration: none; margin-bottom: 2rem; transition: transform 0.15s ease, box-shadow 0.15s ease;"
          >
            <div>
              <span style="font-size: 0.78rem; font-weight: 800; color: #0284c7; letter-spacing: 0.05em; text-transform: uppercase;">PREFECTURE GUIDE</span>
              <h3 style="font-size: 1.15rem; font-weight: 800; color: var(--text-main); margin: 0.25rem 0 0.15rem;">
                📍 {prefName}の旅情報・モデルコース一覧を見る
              </h3>
              <p style="font-size: 0.85rem; color: var(--text-light); margin: 0;">
                {prefName}の最新観光ガイド、旬のイベント、車なしモデルコースをまとめてチェック
              </p>
            </div>
            <span style="font-size: 1.4rem; color: #0284c7; margin-left: 1rem; font-weight: 700;">&rarr;</span>
          </a>

          {(() => {
            const relatedArticles = prefArticles
              .filter((a) => a.id !== article!.id)
              .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
              .slice(0, 3);

            if (relatedArticles.length === 0) return null;

            return (
              <div>
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                  <h3 style="font-size: 1.1rem; font-weight: 800; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 0.4rem;">
                    <span>🧭</span> {prefName}のあわせて読みたい人気モデルコース
                  </h3>
                  <a href={`/${prefSlug}/`} style="font-size: 0.82rem; font-weight: 700; color: var(--theme-accent); text-decoration: none;">
                    すべて見る &rarr;
                  </a>
                </div>

                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1rem;">
                  {relatedArticles.map((rel) => {
                    const relSlug = getArticleSlug(rel.id, rel.data.pref);
                    return (
                      <a
                        href={`/${prefSlug}/${relSlug}/`}
                        style="display: flex; flex-direction: column; background: #ffffff; border: 1px solid var(--border-color); border-radius: 8px; padding: 1rem; text-decoration: none; color: inherit; transition: transform 0.15s ease, box-shadow 0.15s ease;"
                        class="related-article-card"
                      >
                        <div style="display: flex; align-items: center; gap: 0.4rem; font-size: 0.72rem; color: var(--text-light); margin-bottom: 0.5rem;">
                          <span style="background: var(--bg-main); padding: 0.15rem 0.45rem; border-radius: 4px; font-weight: 700; color: var(--text-main);">
                            {rel.data.category}
                          </span>
                          {rel.data.duration && (
                            <span>· {rel.data.duration}</span>
                          )}
                        </div>
                        <h4 style="font-size: 0.92rem; font-weight: 800; line-height: 1.45; color: var(--text-main); margin: 0 0 0.5rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                          {rel.data.title}
                        </h4>
                        <p style="font-size: 0.8rem; line-height: 1.5; color: var(--text-light); margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                          {rel.data.description}
                        </p>
                        <span style="font-size: 0.78rem; font-weight: 700; color: var(--theme-accent); margin-top: auto; padding-top: 0.75rem;">
                          記事を読む &rarr;
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })()}
        </section>}

        <footer class="e-footer">
          <div class="e-tags">
            {article.data.tags.map((tag: string) => (
              <span class="e-tag">#{tag}</span>
            ))}
          </div>
          <div class="e-footer-nav">
            <a href={hubHref}>
              &larr; {isSpecial ? 'どこかにビューーン！特集へ' : `${prefName}の旅情報一覧へ`}
            </a>
            <a href="/">全国トップへ戻る</a>
          </div>
        </footer>
      </article>
    </div>
  </Layout>
) : null}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]'));
  const targets = links
    .map((link) => {
      const id = link.dataset.tocLink;
      return id ? document.getElementById(id) : null;
    })
    .filter((el): el is HTMLElement => Boolean(el));

  if (targets.length > 0 && 'IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            links.forEach((l) => l.classList.remove('is-active'));
            const active = links.find((l) => l.dataset.tocLink === entry.target.id);
            if (active) active.classList.add('is-active');
          }
        }
      },
      { rootMargin: '-90px 0px -70% 0px', threshold: 0 }
    );
    targets.forEach((t) => observer.observe(t));
  }

  const menuScroll = document.getElementById('menu-scroll-area');
  const scrollHint = document.getElementById('menu-scroll-hint');
  if (menuScroll && scrollHint) {
    const updateScrollHint = () => {
      const hasOverflow = menuScroll.scrollHeight > menuScroll.clientHeight + 4;
      const atBottom = menuScroll.scrollTop + menuScroll.clientHeight >= menuScroll.scrollHeight - 4;
      scrollHint.hidden = !hasOverflow || atBottom;
    };
    updateScrollHint();
    menuScroll.addEventListener('scroll', updateScrollHint, { passive: true });
    window.addEventListener('resize', updateScrollHint, { passive: true });
    scrollHint.addEventListener('click', () => {
      menuScroll.scrollBy({ top: 140, behavior: 'smooth' });
    });
  }
</script>

<style>
  .e-hero-section {
    padding-top: 0;
    margin-bottom: 2rem;
  }
  .e-hero-figure {
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    background: #1e293b;
  }
  .e-hero-blur-bg {
    position: absolute;
    inset: -28px;
    background-position: center;
    background-size: cover;
    filter: blur(26px) saturate(1.15) brightness(0.72);
    transform: scale(1.06);
    pointer-events: none;
    z-index: 0;
  }
  .e-hero-img-wrap {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    overflow: hidden;
    z-index: 1;
  }
  .e-hero-img-wrap img {
    display: block;
    width: 100%;
    height: clamp(320px, 52vw, 620px);
    object-fit: cover;
    border-radius: 0;
  }
  .e-hero-credit {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(15, 23, 42, 0.6);
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .e-header-inner {
    max-width: 1180px;
    margin: 1.25rem auto 0;
    padding: 0 1.25rem 1.25rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .e-title {
    margin: 0 0 0.5rem;
    font-size: 2.05rem;
    font-weight: 900;
    line-height: 1.35;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .e-subtitle {
    margin: 0 0 1rem;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.6;
    color: #475569;
  }
  .e-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }
  .e-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
