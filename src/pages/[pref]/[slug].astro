---
import Layout from '../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../data/prefectures';
import { MONTHLY_THEMES, type MonthTheme } from '../../data/monthlyThemes';
import { CITIES, type City } from '../../data/cities';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../../utils/slug';
import SeasonalTabs from '../../components/SeasonalTabs.astro';
import PrefectureMonthPage from '../../components/PrefectureMonthPage.astro';
import CityHubPage from '../../components/CityHubPage.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.lang === 'ja' && !data.draft;
  });

  // 1. 各記事の詳細ページ (/kanagawa/yokohama-autumn-kids-no-car/ など)
  const articlePaths = articles.map((article) => {
    const slug = getArticleSlug(article.id, article.data.pref);
    return {
      params: {
        pref: article.data.pref,
        slug: slug,
      },
      props: {
        pageType: 'article' as const,
        article,
      },
    };
  });

  // 2. 都道府県 × 1月〜12月の月別ガイド (/hokkaido/6/, /shizuoka/11/ など)
  const monthPaths = PREFECTURES.flatMap((pref) => {
    return MONTHLY_THEMES.map((theme) => {
      const matchingArticles = articles.filter((art) => {
        if (art.data.pref !== pref.id) return false;
        const s = art.data.season || '';
        return s.includes(`${theme.month}月`);
      });
      const allPrefArticles = articles.filter((art) => art.data.pref === pref.id);

      return {
        params: {
          pref: pref.id,
          slug: String(theme.month),
        },
        props: {
          pageType: 'month' as const,
          pref,
          month: theme.month,
          monthTheme: theme,
          monthArticles: matchingArticles,
          allPrefArticles,
        },
      };
    });
  });

  // 3. 市町村・主要エリアトップ (/hokkaido/furano/, /shizuoka/atami/ など)
  const cityPaths = CITIES.map((city) => {
    const pref = PREFECTURES.find((p) => p.id === city.prefId) || {
      id: city.prefId,
      code: 0,
      nameJa: city.prefId,
      nameEn: city.prefId,
      region: city.region,
      regionNameJa: '',
      regionNameEn: '',
      capitalJa: '',
      capitalEn: '',
      highlightsJa: [],
      highlightsEn: [],
      descriptionJa: '',
      descriptionEn: '',
    };

    const matchingArticles = articles.filter((art) => {
      if (art.data.pref !== city.prefId) return false;
      return art.data.cities.includes(city.id) || art.data.tags.includes(city.nameJa);
    });
    const allPrefArticles = articles.filter((art) => art.data.pref === city.prefId);

    return {
      params: {
        pref: city.prefId,
        slug: city.id,
      },
      props: {
        pageType: 'city' as const,
        pref,
        city,
        cityArticles: matchingArticles,
        allPrefArticles,
      },
    };
  });

  return [...articlePaths, ...monthPaths, ...cityPaths];
}

type Props =
  | {
      pageType: 'article';
      article: CollectionEntry<'articles'>;
    }
  | {
      pageType: 'month';
      pref: Prefecture;
      month: number;
      monthTheme: MonthTheme;
      monthArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    }
  | {
      pageType: 'city';
      pref: Prefecture;
      city: City;
      cityArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    };

const props = Astro.props as Props;

// 記事ページ用の変数（pageType === 'article' の場合のみ解決）
let article: CollectionEntry<'articles'> | undefined;
let ContentComponent: any;
let tocHeadings: { depth: number; slug: string; text: string }[] = [];
let prefName = '';
let prefSlug = '';
let isSpecial = false;
let hubHref = '';
let prefRegion = 'kanto';
let prefArticles: CollectionEntry<'articles'>[] = [];
let articleMonth: number | undefined;
const featuredPrefs = PREFECTURES.filter((p) =>
  ['hokkaido', 'aomori', 'iwate', 'akita', 'tokyo', 'kanagawa', 'shizuoka', 'kyoto'].includes(p.id)
);

if (props.pageType === 'article') {
  article = props.article;
  const rendered = await render(article);
  ContentComponent = rendered.Content;
  tocHeadings = (rendered.headings || []).filter((h) => h.depth === 2);

  const prefObj = PREFECTURES.find((p) => p.id === article.data.pref);
  isSpecial = article.data.pref === 'special';
  prefName = isSpecial ? 'どこかにビューーン！' : prefObj ? prefObj.nameJa : article.data.pref;
  prefSlug = article.data.pref;
  hubHref = isSpecial ? '/special/dokokanibyun/' : `/${prefSlug}/`;
  prefRegion = prefObj ? prefObj.region : 'kanto';

  prefArticles = await getCollection('articles', ({ data }) => {
    return data.lang === 'ja' && data.pref === prefSlug && !data.draft;
  });

  if (article.data.season) {
    const m = article.data.season.match(/(\d+)月/);
    if (m) articleMonth = parseInt(m[1], 10);
  }
}
---

{props.pageType === 'month' ? (
  <PrefectureMonthPage
    pref={props.pref}
    month={props.month}
    monthTheme={props.monthTheme}
    articles={props.monthArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : props.pageType === 'city' ? (
  <CityHubPage
    pref={props.pref}
    city={props.city}
    articles={props.cityArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : article ? (
  <Layout
    title={`${article.data.title} - tavi-navi`}
    description={article.data.description}
    image={article.data.heroImage}
    lang="ja"
    currentPref={prefSlug}
    fullWidth={true}
  >
    <!-- 1段目：全幅ヒーロー画像（背景のみブラー） ➔ タイトル・副題・メタ -->
    <section class="e-hero-section">
      {article.data.heroImage && (
        <figure class="e-hero-figure">
          <div
            class="e-hero-blur-bg"
            style={`background-image: url('${article.data.heroImage}')`}
            aria-hidden="true"
          ></div>
          <div class="e-hero-img-wrap">
            <img
              src={article.data.heroImage}
              alt={article.data.title}
              width="1200"
              height="630"
            />
            <figcaption class="e-hero-credit">写真提供：一般社団法人 秋田県観光連盟</figcaption>
          </div>
        </figure>
      )}

      <div class="e-header-inner">
        <h1 class="e-title">{article.data.displayTitle || article.data.title}</h1>
        {article.data.subtitle && (
          <p class="e-subtitle">{article.data.subtitle}</p>
        )}

        <div class="e-meta-row">
          <div class="e-badges">
            <a href={hubHref} class="e-badge primary">
              <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
              <span>{prefName}</span>
            </a>
            <span class="e-badge">{article.data.category}</span>
            {article.data.season && (
              <span class="e-badge season">{article.data.season}</span>
            )}
            {article.data.tags?.some((t: string) => t.includes('車なし')) && (
              <span class="e-badge outline">車なしOK</span>
            )}
          </div>

          <span class="e-meta-divider" aria-hidden="true">|</span>

          <div class="e-dates">
            <span>公開 {article.data.pubDate.toLocaleDateString('ja-JP')}</span>
            {article.data.updatedDate && (
              <span>更新 {article.data.updatedDate.toLocaleDateString('ja-JP')}</span>
            )}
          </div>
        </div>
      </div>
    </section>

    <!-- 2段目：本文没入1カラム基調（最大幅820px） -->
    <div class="e-body-shell">
      <article class="e-article google-anno-skip">
        <!-- スマート目次バー（2項目以上ある場合のみ自動表示：DAY 1 / DAY 2 / 費用目安 / 予約ハブ含む） -->
        <nav class="e-smart-toc" id="smart-toc" aria-label="この記事の目次" hidden>
          <span class="e-smart-toc-label">INDEX</span>
          <div class="e-smart-toc-list" id="smart-toc-list"></div>
        </nav>

        <div class="prose google-anno-skip" id="article-prose-root">
          <ContentComponent />
        </div>

        <!-- 読了後の回遊用：都道府県ハブバナー ＆ 重複しない関連モデルコース -->
        {!isSpecial && <section class="related-pref-section" id="auto-related-pref">
          <a href={`/${prefSlug}/`} class="pref-hub-banner">
            <div>
              <span class="pref-hub-kicker">PREFECTURE GUIDE</span>
              <h3 class="pref-hub-title">
                {prefName}の旅情報・モデルコース一覧を見る
              </h3>
              <p class="pref-hub-desc">
                {prefName}の最新観光ガイド、旬のモデルコース、車なしルートをまとめてチェック
              </p>
            </div>
            <svg class="pref-hub-arrow" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          {(() => {
            const relatedArticles = prefArticles
              .filter((a) => a.id !== article!.id)
              .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
              .slice(0, 3);

            if (relatedArticles.length === 0) return null;

            return (
              <div class="auto-related-grid-wrap" id="auto-related-grid-wrap">
                <div class="auto-related-header">
                  <h3 class="auto-related-title">
                    {prefName}のあわせて読みたいモデルコース
                  </h3>
                  <a href={`/${prefSlug}/`} class="pill-btn">
                    <span>すべて見る</span>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <line x1="5" y1="12" x2="19" y2="12"></line>
                      <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                  </a>
                </div>

                <div class="auto-related-grid">
                  {relatedArticles.map((rel) => {
                    const relSlug = getArticleSlug(rel.id, rel.data.pref);
                    return (
                      <a href={`/${prefSlug}/${relSlug}/`} class="related-article-card">
                        <div class="related-article-meta">
                          <span class="related-article-cat">{rel.data.category}</span>
                          {rel.data.duration && <span>· {rel.data.duration}</span>}
                        </div>
                        <h4 class="related-article-title">{rel.data.title}</h4>
                        <p class="related-article-desc">{rel.data.description}</p>
                        <span class="related-article-more">記事を読む →</span>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })()}
        </section>}

        <!-- 折りたたみエリア・月別ナビ（記事下へ退避し、本文の邪魔をしない） -->
        <details class="e-bottom-nav-fold">
          <summary class="e-bottom-nav-summary">
            <span>{isSpecial ? '全国の月別ガイド・人気エリアから探す' : `${prefName}のエリア・月別ガイドから探す`}</span>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"></polyline>
            </svg>
          </summary>
          <div class="e-bottom-nav-body">
            {!isSpecial && CITIES.filter((c) => c.prefId === prefSlug).length > 0 && (
              <div class="menu-group">
                <p class="menu-label">AREA / {prefName}</p>
                <div class="menu-chips">
                  <a href={hubHref} class="menu-chip is-current">{prefName}トップ</a>
                  {CITIES.filter((c) => c.prefId === prefSlug).map((city) => (
                    <a href={`/${prefSlug}/${city.id}/`} class="menu-chip">{city.nameJa}</a>
                  ))}
                </div>
              </div>
            )}
            <div class="menu-group">
              <p class="menu-label">BY MONTH</p>
              <div class="menu-month-grid">
                {MONTHLY_THEMES.map((m) => (
                  <a href={isSpecial ? `/season/${m.month}/` : `/${prefSlug}/${m.month}/`} class="menu-month-chip">
                    {m.month}月
                  </a>
                ))}
              </div>
            </div>
          </div>
        </details>

        <footer class="e-footer">
          <div class="e-tags">
            {article.data.tags.map((tag: string) => (
              <span class="e-tag">#{tag}</span>
            ))}
          </div>
          <div class="e-footer-nav">
            <a href={hubHref}>
              &larr; {isSpecial ? 'どこかにビューーン！特集へ' : `${prefName}の旅情報一覧へ`}
            </a>
            <a href="/">全国トップへ戻る</a>
          </div>
        </footer>
      </article>
    </div>
  </Layout>
) : null}

<script>
  const proseRoot = document.getElementById('article-prose-root');
  const smartToc = document.getElementById('smart-toc');
  const smartTocList = document.getElementById('smart-toc-list');

  if (proseRoot && smartToc && smartTocList) {
    // 記事内の H2 および DAY 1 / DAY 2 / 費用目安 / 予約ハブを順番通りに拾う
    const nodes = Array.from(proseRoot.querySelectorAll<HTMLElement>('[data-toc-heading], h2[id]'));
    const seenIds = new Set<string>();
    const items: { id: string; label: string }[] = [];

    for (const el of nodes) {
      const id = el.id;
      if (!id || seenIds.has(id)) continue;
      // data-toc-heading が付いている見出し（DAY 1, DAY 2, 費用目安, 予約ハブ）を優先
      const customLabel = el.getAttribute('data-toc-heading');
      const rawText = (customLabel || el.textContent || '').replace(/\s+/g, ' ').trim();
      if (!rawText) continue;
      seenIds.add(id);
      items.push({ id, label: rawText });
    }

    // 項目が2つ以上ある場合のみ目次を表示（1項目以下は非表示）
    if (items.length >= 2) {
      smartTocList.replaceChildren();
      for (const item of items) {
        const a = document.createElement('a');
        a.href = `#${item.id}`;
        a.className = 'e-smart-toc-pill';
        a.textContent = item.label;
        smartTocList.appendChild(a);
      }
      smartToc.hidden = false;
    }

    // 本文内に既に RelatedCourseCards がある場合は記事下の重複カードブロックを畳む
    const hasInlineRelated = Boolean(proseRoot.querySelector('.related-courses-section'));
    const autoRelatedGrid = document.getElementById('auto-related-grid-wrap');
    if (hasInlineRelated && autoRelatedGrid) {
      autoRelatedGrid.hidden = true;
    }
  }
</script>

<style>
  .e-hero-section {
    padding-top: 0;
    margin-bottom: 2rem;
  }
  .e-hero-figure {
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    background: #1e293b;
  }
  .e-hero-blur-bg {
    position: absolute;
    inset: -28px;
    background-position: center;
    background-size: cover;
    filter: blur(26px) saturate(1.15) brightness(0.72);
    transform: scale(1.06);
    pointer-events: none;
    z-index: 0;
  }
  .e-hero-img-wrap {
    position: relative;
    max-width: 1440px;
    margin: 0 auto;
    overflow: hidden;
    z-index: 1;
  }
  .e-hero-img-wrap img {
    display: block;
    width: 100%;
    height: clamp(320px, 52vw, 620px);
    object-fit: cover;
    border-radius: 0;
  }
  .e-hero-credit {
    position: absolute;
    right: 0.9rem;
    bottom: 0.7rem;
    margin: 0;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.92);
    background: rgba(15, 23, 42, 0.6);
    padding: 0.18rem 0.55rem;
    border-radius: 4px;
    backdrop-filter: blur(4px);
  }

  .e-header-inner {
    max-width: 820px;
    margin: 1.5rem auto 0;
    padding: 0 1.25rem 1.25rem;
    border-bottom: 1px solid #e2e8f0;
  }
  .e-title {
    margin: 0 0 0.55rem;
    font-size: 1.95rem;
    font-weight: 900;
    line-height: 1.35;
    color: #0f172a;
    letter-spacing: -0.02em;
  }
  .e-subtitle {
    margin: 0 0 1rem;
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.65;
    color: #475569;
  }
  .e-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
  }
  .e-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
