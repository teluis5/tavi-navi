  }
  .e-sidebar {
    position: sticky;
    top: 84px;
    height: calc(100vh - 104px);
    display: flex;
    flex-direction: column;
  }
  .e-sidebar-container {
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
  }
