    font-size: 0.76rem;
    font-weight: 800;
    color: var(--color-teal, #0E7C94);
    letter-spacing: 0.1em;
  }
  .pref-hub-title {
    font-size: 1.08rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0.2rem 0 0.15rem;
  }
  .pref-hub-desc {
    font-size: 0.83rem;
    color: #475569;
    margin: 0;
  }
  .pref-hub-arrow {
    color: var(--color-teal, #0E7C94);
    flex-shrink: 0;
  }
  .auto-related-grid-wrap[hidden] {
    display: none;
  }
  .auto-related-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .auto-related-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
  }
  .auto-related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 1rem;
  }
  .related-article-card {
    display: flex;
    flex-direction: column;
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .related-article-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.06);
    text-decoration: none;
  }
  .related-article-meta {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 0.5rem;
  }
  .related-article-cat {
    background: #F8FAFB;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 700;
    color: #334155;
  }
  .related-article-title {
    font-size: 0.92rem;
    font-weight: 800;
    line-height: 1.45;
    color: #0f172a;
