<style>
  .sample-page {
    max-width: 920px;
    margin: 0 auto;
    padding: 1rem 0 4rem;
  }
  .sample-header {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 1.75rem 2rem;
    margin-bottom: 2.5rem;
  }
  .sample-badge {
    display: inline-block;
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: #0284c7;
    background: #e0f2fe;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    margin-bottom: 0.6rem;
  }
  .sample-header h1 {
    font-size: 1.5rem;
    font-weight: 850;
    color: #0f172a;
    margin: 0 0 0.75rem;
  }
  .sample-header p {
    font-size: 0.92rem;
    color: #475569;
    margin: 0 0 1.25rem;
    line-height: 1.7;
  }
  .sample-jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sample-jump a {
    font-size: 0.8rem;
    font-weight: 700;
    color: #0369a1;
    background: #f8fafc;
    border: 1px solid #cbd5e1;
    padding: 0.35rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
  }
  .sample-jump a:hover {
    background: #e0f2fe;
    border-color: #0284c7;
  }

  .sample-card {
    background: #ffffff;
    border: 1px solid #cbd5e1;
    border-radius: 12px;
    margin-bottom: 2.5rem;
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);
  }
  .sample-card-head {
    background: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
    padding: 0.85rem 1.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }
  .pattern-tag {
    font-size: 0.82rem;
    font-weight: 800;
    color: #0f172a;
    background: #e2e8f0;
    padding: 0.25rem 0.75rem;
    border-radius: 6px;
  }
  .pattern-tag.is-current {
    background: #0284c7;
    color: #ffffff;
  }
  .pattern-desc {
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
  }

  .sample-prose {
    padding: 1.75rem 2rem 2rem;
  }
  .sample-prose p {
    font-size: 16px;
    line-height: 1.8;
    color: #333333;
    margin: 0 0 1.25rem;
  }

  /* 共通H2（ツートーン下線） */
  .h2-twotone {
    position: relative;
    padding: 0 0 0.65rem 0;
    border-bottom: 3px solid #e2e8f0;
    font-size: 1.5rem;
    font-weight: 850;
    color: #0f172a;
    line-height: 1.35;
    letter-spacing: -0.02em;
    margin: 0 0 1.35rem;
  }
  .h2-twotone::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -3px;
    width: 84px;
    height: 3px;
    background-color: #0284c7;
  }

  /* パターンA：左端の丸角ブルー縦バー（現在） */
  .h3-pattern-a {
    position: relative;
    padding: 0.1rem 0 0.1rem 0.9rem;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-a::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.18em;
    bottom: 0.18em;
    width: 4px;
    background-color: #0284c7;
    border-radius: 999px;
  }

  /* パターンB：先頭スクエア・ドット */
  .h3-pattern-b {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-b::before {
    content: '';
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 3px;
    background: #0284c7;
    flex-shrink: 0;
  }

  /* パターンC：左ブルー横ダッシュ */
  .h3-pattern-c {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-c::before {
    content: '';
    display: inline-block;
    width: 18px;
    height: 3px;
    border-radius: 999px;
    background: #0284c7;
    flex-shrink: 0;
  }

  /* パターンD：淡色破線（ドット/ダッシュ下線）＋先頭スクエア */
  .h3-pattern-d {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding-bottom: 0.45rem;
    border-bottom: 1px dashed #cbd5e1;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-d::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: #0284c7;
    flex-shrink: 0;
  }

  /* パターンE：ツートーン縦バー（上半分ブルー＋下半分グレー） */
  .h3-pattern-e {
    position: relative;
    padding: 0.15rem 0 0.15rem 0.95rem;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-e::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.12em;
    bottom: 0.12em;
    width: 4px;
    background: linear-gradient(to bottom, #0284c7 0%, #0284c7 55%, #cbd5e1 55%, #cbd5e1 100%);
    border-radius: 2px;
  }

  /* パターンF：左ブルー縦バー ＋ ごく淡いアイスブルー背景 */
  .h3-pattern-f {
    padding: 0.5rem 0.95rem;
    background: #f8fafc;
    border-left: 4px solid #0284c7;
    border-radius: 0 6px 6px 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }

  /* パターンG：斜めダブルスラッシュ（//）アクセント */
  .h3-pattern-g {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-g::before {
    content: '//';
    font-family: "JetBrains Mono", Consolas, monospace;
    font-size: 1.1rem;
    font-weight: 900;
    letter-spacing: -0.1em;
    color: #0284c7;
    flex-shrink: 0;
  }

  /* パターンH：文字下ショートブルーラインのみ（全幅グレー線なし） */
  .h3-pattern-h {
    position: relative;
    padding: 0 0 0.45rem 0;
    font-size: 1.22rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.4;
    margin: 2rem 0 0.85rem;
  }
  .h3-pattern-h::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 36px;
    height: 3px;
    border-radius: 999px;
    background-color: #38bdf8;
  }

  @media (max-width: 640px) {
    .sample-header,
    .sample-prose {
      padding: 1.25rem 1rem;
    }
    .h2-twotone {
      font-size: 1.25rem;
    }
  }
</style>
