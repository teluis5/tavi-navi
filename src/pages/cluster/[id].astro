---
import Layout from '../../layouts/Layout.astro';
import { PREFECTURES } from '../../data/prefectures';
import { clusters, getClusterSpots } from '../../data/spots';

export function getStaticPaths() {
  return clusters.map((cluster) => ({ params: { id: cluster.id }, props: { cluster } }));
}

const { cluster } = Astro.props;
const pref = PREFECTURES.find((p) => p.id === cluster.prefId);
const items = getClusterSpots(cluster);
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(cluster.mapQuery)}&output=embed`;
---

<Layout title={`${cluster.title}｜比較ガイド`} description={cluster.summary} image={cluster.image}>
  <article class="cluster-page">
    <nav class="crumbs" aria-label="パンくず">
      <a href="/">トップ</a>
      {pref && (<><span>›</span><a href={`/${pref.id}/`}>{pref.nameJa}</a></>)}
    </nav>

    <header class="cluster-hero">
      <span class="pill">エリアまとめ ・ {items.length}スポット</span>
      <h1>{cluster.title}</h1>
      <p class="catch">{cluster.catchphrase}</p>
    </header>

    <p class="lead">{cluster.summary}</p>

    {cluster.tips && (
      <section class="block">
        <h2>選び方のコツ</h2>
        <ul class="tips">{cluster.tips.map((t) => <li>{t}</li>)}</ul>
      </section>
    )}

    <section class="block">
      <h2>スポット一覧</h2>
      <div class="cards">
        {items.map((s) => (
          <a class="card" href={`/spot/${s.id}/`}>
            <div class="thumb" style={s.image ? `background-image:url(${s.image})` : undefined}></div>
            <div class="body">
              <span class="cat">{s.category}</span>
              <strong>{s.title}</strong>
              <span class="desc">{s.catchphrase}</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {cluster.access && (
      <section class="block">
        <h2>エリアへの行き方</h2>
        <div class="access">
          <div class="access-main"><span>{cluster.access.from}</span><span class="arrow">↓</span><span>{cluster.access.method}</span></div>
          {cluster.access.specs && <ul class="specs">{cluster.access.specs.map((s) => <li>{s}</li>)}</ul>}
        </div>
      </section>
    )}

    <section class="block">
      <h2>エリアマップ</h2>
      <div class="map"><iframe src={mapSrc} loading="lazy" title={`${cluster.title}の地図`} referrerpolicy="no-referrer-when-downgrade"></iframe></div>
    </section>
  </article>
</Layout>

<style>
  .cluster-page { max-width: 720px; margin: 0 auto; padding: 1rem 1rem 3rem; }
  .crumbs { font-size: .78rem; color: #6b7280; display: flex; gap: .35rem; margin-bottom: .75rem; }
  .crumbs a { color: inherit; text-decoration: none; }
  .cluster-hero { background: linear-gradient(135deg, #3b5b4a, #5f8a73); color: #fff; border-radius: 12px; padding: 1.6rem 1.1rem; }
  .cluster-hero h1 { margin: .5rem 0 .3rem; font-size: 1.6rem; line-height: 1.25; }
  .catch { margin: 0; font-size: .95rem; }
  .pill { background: rgba(255,255,255,.2); border-radius: 999px; padding: .1rem .7rem; font-size: .75rem; font-weight: 700; }
  .lead { line-height: 1.8; margin: 1rem 0 0; }
  .block { margin-top: 1.6rem; }
  .block h2 { font-size: 1.15rem; margin: 0 0 .6rem; }
  .tips { margin: 0; padding-left: 1.2rem; line-height: 1.8; }
  .cards { display: grid; gap: .6rem; }
  .card { display: flex; background: #e3e7ed; border-radius: 12px; overflow: hidden; text-decoration: none; color: inherit; }
  .thumb { width: 96px; flex: none; background: linear-gradient(135deg, #2f4858, #4a6a7c) center/cover; }
  .body { display: flex; flex-direction: column; gap: .15rem; padding: .7rem .8rem; font-size: .85rem; }
  .body strong { font-size: 1rem; }
  .cat { font-size: .72rem; color: #6b7280; font-weight: 700; }
  .access { background: #e3e7ed; border-radius: 12px; padding: .9rem 1rem; }
  .access-main { display: flex; flex-direction: column; gap: .15rem; font-weight: 700; }
  .arrow { color: #6b7280; }
  .specs { margin: .6rem 0 0; padding-left: 1.1rem; font-size: .88rem; line-height: 1.7; font-weight: 400; }
  .map iframe { width: 100%; aspect-ratio: 4 / 3; border: 0; border-radius: 12px; }
</style>
