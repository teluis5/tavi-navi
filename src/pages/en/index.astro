---
import Layout from '../../layouts/Layout.astro';
import { REGIONS, PREFECTURES } from '../../data/prefectures';
import { getCollection } from 'astro:content';
import { getArticleSlug } from '../../utils/slug';

const allArticles = await getCollection('articles', ({ data }) => {
  return data.lang === 'en' && !data.draft;
});

const recentArticles = allArticles.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 6);
---

<Layout
  title="tavi-navi - Japan Real-Time Travel Guide Across 47 Prefectures"
  description="Discover the best seasonal travel destinations, festivals, autumn foliage, cherry blossoms, and local secrets across all 47 prefectures in Japan."
  lang="en"
>
  <div class="hero-banner">
    <div class="container">
      <span class="badge-seasonal">🍁 November 2026: Autumn Foliage & Seasonal Festivals</span>
      <h1 class="hero-title" style="margin-top: 1rem;">Explore Japan Across 47 Prefectures, in Real Time</h1>
      <p class="hero-subtitle">
        Your go-to live navigator for seasonal blossom peaks, cultural festivals, and local cuisine. Featuring actionable transit routes including car-free and family-friendly plans.
      </p>
    </div>
  </div>

  <div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
    {/* Recent Articles */}
    {recentArticles.length > 0 && (
      <section style="margin-bottom: 3.5rem;">
        <h2 style="font-size: 1.5rem; font-weight: 800; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.5rem;">
          <span style="color: var(--color-accent);">🔥</span> Latest Travel Reports & Guides
        </h2>
        <div class="article-grid">
          {recentArticles.map((post) => {
            const prefObj = PREFECTURES.find((p) => p.id === post.data.pref);
            const articleSlug = getArticleSlug(post.id, post.data.pref);
            return (
              <article class="article-card">
                <div class="article-card-body">
                  <div class="article-card-meta">
                    <span style="font-weight: 700; color: var(--color-primary);">{prefObj ? prefObj.nameEn : post.data.pref}</span>
                    <span>•</span>
                    <span class="badge-seasonal">{post.data.category}</span>
                    <span>•</span>
                    <time datetime={post.data.pubDate.toISOString()}>
                      {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                    </time>
                  </div>
                  <h3 class="article-card-title">
                    <a href={`/en/${post.data.pref}/${articleSlug}/`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p class="article-card-desc">{post.data.description}</p>
                  <div style="margin-top: auto;">
                    <a href={`/en/${post.data.pref}/${articleSlug}/`} style="font-weight: 700; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 0.25rem;">
                      Read Article &rarr;
                    </a>
                  </div>
                </div>
              </article>
            );
          })}
        </div>
      </section>
    )}

    {/* Weekend 2-Day Trips from Major Cities */}
    <section style="margin-bottom: 3.5rem;">
      <div style="margin-bottom: 1.5rem;">
        <span class="badge-seasonal" style="background: rgba(46, 125, 50, 0.1); color: var(--color-primary); margin-bottom: 0.5rem; display: inline-block;">
          🚅 By Shinkansen & Express Transit
        </span>
        <h2 style="font-size: 1.5rem; font-weight: 800; display: flex; align-items: center; gap: 0.5rem; margin: 0 0 0.4rem 0;">
          <span style="color: var(--color-primary);">🗺️</span> 2-Day Weekend Escapes from Tokyo & Osaka
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.92rem; margin: 0;">
          Quick, stress-free side trips accessible within 45 to 120 minutes by high-speed bullet train or scenic limited express.
        </p>
      </div>

      <div class="getaway-grid">
        {/* From Tokyo */}
        <div class="getaway-hub-card">
          <div class="getaway-hub-header">
            <span class="getaway-hub-icon">🗼</span>
            <div>
              <h3 class="getaway-hub-title">From Tokyo (Kanto & Tokai)</h3>
              <span class="getaway-hub-sub">Hot springs & Mount Fuji views in under 2 hours</span>
            </div>
          </div>
          <div class="getaway-dest-list">
            <a href="/en/shizuoka/from-tokyo-2days/" class="getaway-dest-item is-featured">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Bullet Train 45m</span>
                <span class="getaway-dest-name">Shizuoka (Atami & Mishima)</span>
              </div>
              <span class="getaway-dest-desc">Panoramic Mount Fuji Skywalk & ocean hot springs [Guide Available] &rarr;</span>
            </a>
            <a href="/en/kanagawa/yokohama-autumn-kids-no-car/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Subway 30m</span>
                <span class="getaway-dest-name">Kanagawa (Yokohama & Hakone)</span>
              </div>
              <span class="getaway-dest-desc">Golden ginkgo avenues, coastal roses & onsen valleys &rarr;</span>
            </a>
            <a href="/en/tochigi/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Spacia 110m</span>
                <span class="getaway-dest-name">Tochigi (Nikko & Kinugawa)</span>
              </div>
              <span class="getaway-dest-desc">UNESCO World Heritage shrines & mountain lake onsens &rarr;</span>
            </a>
            <a href="/en/gunma/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Express 150m</span>
                <span class="getaway-dest-name">Gunma (Kusatsu Onsen)</span>
              </div>
              <span class="getaway-dest-desc">Steaming Yubatake hot spring fields & bathhouse crawls &rarr;</span>
            </a>
          </div>
        </div>

        {/* From Osaka/Kyoto */}
        <div class="getaway-hub-card">
          <div class="getaway-hub-header">
            <span class="getaway-hub-icon">🐙</span>
            <div>
              <h3 class="getaway-hub-title">From Osaka & Kyoto (Kansai)</h3>
              <span class="getaway-hub-sub">Historic bathhouses & coastal sea delicacies</span>
            </div>
          </div>
          <div class="getaway-dest-list">
            <a href="/en/hyogo/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Kounotori 150m</span>
                <span class="getaway-dest-name">Hyogo (Kinosaki Onsen)</span>
              </div>
              <span class="getaway-dest-desc">Yukata strolls across 7 public onsen & winter snow crab feasts &rarr;</span>
            </a>
            <a href="/en/wakayama/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Kuroshio 135m</span>
                <span class="getaway-dest-name">Wakayama (Nanki-Shirahama)</span>
              </div>
              <span class="getaway-dest-desc">White sand beaches and open-air cliffside ocean onsens &rarr;</span>
            </a>
            <a href="/en/mie/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Shimakaze 110m</span>
                <span class="getaway-dest-name">Mie (Ise-Shima)</span>
              </div>
              <span class="getaway-dest-desc">Sacred Ise Grand Shrine pilgrimage & traditional street snacks &rarr;</span>
            </a>
            <a href="/en/kyoto/" class="getaway-dest-item">
              <div class="getaway-dest-left">
                <span class="getaway-time-badge">Express 120m</span>
                <span class="getaway-dest-name">Kyoto (Amanohashidate & Ine)</span>
              </div>
              <span class="getaway-dest-desc">Scenic Pine Sandbar & traditional floating boathouses &rarr;</span>
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* 47 Prefectures Explorer */}
    <section>
      <div style="margin-bottom: 2rem;">
        <h2 style="font-size: 1.75rem; font-weight: 900; letter-spacing: -0.02em; margin-bottom: 0.5rem;">
          Explore Japan's 47 Prefectures
        </h2>
        <p style="color: var(--color-text-muted); font-size: 0.95rem;">
          Select a prefecture below to discover local seasonal events, top sights, food culture, and transit guides.
        </p>
      </div>

      {REGIONS.map((region) => {
        const regionPrefs = PREFECTURES.filter((p) => p.region === region.id);
        return (
          <div class="region-section">
            <h3 class="region-title">
              <span>{region.nameEn}</span>
              <span class="region-title-en">{region.nameJa}</span>
            </h3>
            <div class="prefecture-grid">
              {regionPrefs.map((pref) => (
                <a href={`/en/${pref.id}/`} class="pref-card">
                  <div class="pref-card-header">
                    <span class="pref-card-title">{pref.nameEn}</span>
                    <span class="pref-card-en">{pref.nameJa}</span>
                  </div>
                  <div class="pref-card-highlights">
                    {pref.highlightsEn.slice(0, 2).map((item) => (
                      <span class="pref-card-tag">{item}</span>
                    ))}
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </section>
  </div>
</Layout>

<style>
  .getaway-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }

  .getaway-hub-card {
    background: #ffffff;
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .getaway-hub-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 0.85rem;
  }

  .getaway-hub-icon {
    font-size: 1.75rem;
    line-height: 1;
  }

  .getaway-hub-title {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-text-main);
    margin: 0 0 0.2rem 0;
  }

  .getaway-hub-sub {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-weight: 600;
  }

  .getaway-dest-list {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .getaway-dest-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.85rem 1rem;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .getaway-dest-item:hover {
    border-color: var(--color-primary);
    transform: translateY(-2px);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.06);
    background: #ffffff;
  }

  .getaway-dest-item.is-featured {
    background: rgba(46, 125, 50, 0.04);
    border-color: var(--color-primary);
    border-left: 4px solid var(--color-primary);
  }

  .getaway-dest-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .getaway-time-badge {
    font-size: 0.72rem;
    font-weight: 800;
    background: var(--color-primary);
    color: #ffffff;
    padding: 0.15rem 0.5rem;
    border-radius: var(--radius-sm);
    line-height: 1.2;
  }

  .getaway-dest-name {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--color-text-main);
  }

  .getaway-dest-desc {
    font-size: 0.82rem;
    color: var(--color-text-muted);
    line-height: 1.4;
  }

  .getaway-dest-item:hover .getaway-dest-desc {
    color: var(--color-primary);
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .getaway-grid {
      grid-template-columns: 1fr;
    }
    .getaway-hub-card {
      padding: 1.15rem 1rem;
    }
  }
</style>
