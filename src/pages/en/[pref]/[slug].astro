---
import Layout from '../../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../../data/prefectures';
import { MONTHLY_THEMES, type MonthTheme } from '../../../data/monthlyThemes';
import { CITIES, type City } from '../../../data/cities';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../../../utils/slug';
import SeasonalTabs from '../../../components/SeasonalTabs.astro';
import EnPrefectureMonthPage from '../../../components/EnPrefectureMonthPage.astro';
import EnCityHubPage from '../../../components/EnCityHubPage.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.lang === 'en' && !data.draft;
  });

  // 1. Article detail pages (/en/kanagawa/yokohama-autumn-kids-no-car/ etc.)
  const articlePaths = articles.map((article) => {
    const slug = getArticleSlug(article.id, article.data.pref);
    return {
      params: {
        pref: article.data.pref,
        slug: slug,
      },
      props: {
        pageType: 'article' as const,
        article,
      },
    };
  });

  // 2. Prefecture x 12-Month guides (/en/hokkaido/6/, /en/shizuoka/11/ etc.)
  const monthPaths = PREFECTURES.flatMap((pref) => {
    return MONTHLY_THEMES.map((theme) => {
      const matchingArticles = articles.filter((art) => {
        if (art.data.pref !== pref.id) return false;
        const s = (art.data.season || '').toLowerCase();
        return s.includes(theme.monthNameEn.toLowerCase());
      });
      const allPrefArticles = articles.filter((art) => art.data.pref === pref.id);

      return {
        params: {
          pref: pref.id,
          slug: String(theme.month),
        },
        props: {
          pageType: 'month' as const,
          pref,
          month: theme.month,
          monthTheme: theme,
          monthArticles: matchingArticles,
          allPrefArticles,
        },
      };
    });
  });

  // 3. City & Area hubs (/en/hokkaido/furano/, /en/shizuoka/atami/ etc.)
  const cityPaths = CITIES.map((city) => {
    const pref = PREFECTURES.find((p) => p.id === city.prefId) || {
      id: city.prefId,
      code: 0,
      nameJa: city.prefId,
      nameEn: city.prefId,
      region: city.region,
      regionNameJa: '',
      regionNameEn: '',
      capitalJa: '',
      capitalEn: '',
      highlightsJa: [],
      highlightsEn: [],
      descriptionJa: '',
      descriptionEn: '',
    };

    const matchingArticles = articles.filter((art) => {
      if (art.data.pref !== city.prefId) return false;
      return art.data.cities.includes(city.id) || art.data.tags.includes(city.nameEn);
    });
    const allPrefArticles = articles.filter((art) => art.data.pref === city.prefId);

    return {
      params: {
        pref: city.prefId,
        slug: city.id,
      },
      props: {
        pageType: 'city' as const,
        pref,
        city,
        cityArticles: matchingArticles,
        allPrefArticles,
      },
    };
  });

  return [...articlePaths, ...monthPaths, ...cityPaths];
}

type Props =
  | {
      pageType: 'article';
      article: CollectionEntry<'articles'>;
    }
  | {
      pageType: 'month';
      pref: Prefecture;
      month: number;
      monthTheme: MonthTheme;
      monthArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    }
  | {
      pageType: 'city';
      pref: Prefecture;
      city: City;
      cityArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    };

const props = Astro.props as Props;

// Article page variables (only resolved if pageType === 'article')
let article: CollectionEntry<'articles'> | undefined;
let ContentComponent: any;
let prefName = '';
let prefSlug = '';
let prefRegion = 'kanto';
let prefArticles: CollectionEntry<'articles'>[] = [];
let articleMonth: number | undefined;

if (props.pageType === 'article') {
  article = props.article;
  const rendered = await render(article);
  ContentComponent = rendered.Content;

  const prefObj = PREFECTURES.find((p) => p.id === article.data.pref);
  prefName = prefObj ? prefObj.nameEn : article.data.pref;
  prefSlug = article.data.pref;
  prefRegion = prefObj ? prefObj.region : 'kanto';

  prefArticles = await getCollection('articles', ({ data }) => {
    return data.lang === 'en' && data.pref === prefSlug && !data.draft;
  });

  if (article.data.season) {
    const s = article.data.season.toLowerCase();
    const months = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
    for (let i = 0; i < months.length; i++) {
      if (s.includes(months[i])) {
        articleMonth = i + 1;
        break;
      }
    }
  }
}
---

{props.pageType === 'month' ? (
  <EnPrefectureMonthPage
    pref={props.pref}
    month={props.month}
    monthTheme={props.monthTheme}
    articles={props.monthArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : props.pageType === 'city' ? (
  <EnCityHubPage
    pref={props.pref}
    city={props.city}
    articles={props.cityArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : article ? (
  <Layout
    title={`${article.data.title} - tavi-navi`}
    description={article.data.description}
    lang="en"
    currentPref={prefSlug}
  >
    <div style="background: #ffffff; border-bottom: 1px solid var(--color-border); padding: 1rem 0;">
      <div class="container" style="font-size: 0.85rem; color: var(--color-text-muted);">
        <a href="/en/" style="color: var(--color-primary);">Home</a>
        <span style="margin: 0 0.4rem;">&gt;</span>
        <a href={`/en/${prefSlug}/`} style="color: var(--color-primary);">{prefName}</a>
        <span style="margin: 0 0.4rem;">&gt;</span>
        <span style="font-weight: 700; color: var(--color-text-main);">{article.data.title}</span>
      </div>
    </div>

    <div class="container" style="max-width: 860px; padding-top: 2.5rem; padding-bottom: 4rem;">
      <article class="article-content">
        <header style="margin-bottom: 2rem; border-bottom: 1px solid var(--color-border); padding-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <a href={`/en/${prefSlug}/`} class="badge-seasonal" style="background: var(--color-primary-light); color: var(--color-primary-dark);">
              📍 {prefName}
            </a>
            <span class="badge-seasonal">{article.data.category}</span>
            {article.data.season && (
              <span class="badge-seasonal" style="background: #fef08a; color: #854d0e;">
                {article.data.season}
              </span>
            )}
          </div>

          <h1 style="font-size: 1.85rem; font-weight: 900; line-height: 1.4; color: var(--color-text-main); margin-bottom: 1rem;">
            {article.data.title}
          </h1>

          <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.85rem; color: var(--color-text-muted);">
            <time datetime={article.data.pubDate.toISOString()}>
              Published: {article.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            {article.data.updatedDate && (
              <time datetime={article.data.updatedDate.toISOString()}>
                Updated: {article.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
              </time>
            )}
          </div>
        </header>

        <div class="markdown-body">
          <ContentComponent />
        </div>

        {/* Up-Next: 4-Season Timeline & Guide Tabs */}
        <div style="margin-top: 3.5rem;">
          <SeasonalTabs
            prefId={prefSlug}
            prefName={prefName}
            region={prefRegion}
            lang="en"
            articles={prefArticles}
            targetMonth={articleMonth}
          />
        </div>

        <footer style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--color-border);">
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            {article.data.tags.map((tag: string) => (
              <span style="font-size: 0.8rem; background: var(--color-bg-base); border: 1px solid var(--color-border); padding: 0.2rem 0.6rem; border-radius: var(--radius-full); color: var(--color-text-muted);">
                #{tag}
              </span>
            ))}
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center;">
            <a href={`/en/${prefSlug}/`} style="font-weight: 700; font-size: 0.9rem; color: var(--color-primary);">
              &larr; More in {prefName}
            </a>
            <a href="/en/" style="font-weight: 700; font-size: 0.9rem; color: var(--color-text-muted);">
              Back to Japan Top
            </a>
          </div>
        </footer>
      </article>
    </div>
  </Layout>
) : null}
