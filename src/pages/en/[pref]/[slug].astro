---
import Layout from '../../../layouts/Layout.astro';
import { PREFECTURES, type Prefecture } from '../../../data/prefectures';
import { MONTHLY_THEMES, type MonthTheme } from '../../../data/monthlyThemes';
import { CITIES, type City } from '../../../data/cities';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getArticleSlug } from '../../../utils/slug';
import SeasonalTabs from '../../../components/SeasonalTabs.astro';
import EnPrefectureMonthPage from '../../../components/EnPrefectureMonthPage.astro';
import EnCityHubPage from '../../../components/EnCityHubPage.astro';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => {
    return data.lang === 'en' && !data.draft;
  });

  // 1. Article detail pages (/en/kanagawa/yokohama-autumn-kids-no-car/ etc.)
  const articlePaths = articles.map((article) => {
    const slug = getArticleSlug(article.id, article.data.pref);
    return {
      params: {
        pref: article.data.pref,
        slug: slug,
      },
      props: {
        pageType: 'article' as const,
        article,
      },
    };
  });

  // 2. Prefecture x 12-Month guides (/en/hokkaido/6/, /en/shizuoka/11/ etc.)
  const monthPaths = PREFECTURES.flatMap((pref) => {
    return MONTHLY_THEMES.map((theme) => {
      const matchingArticles = articles.filter((art) => {
        if (art.data.pref !== pref.id) return false;
        const s = (art.data.season || '').toLowerCase();
        return s.includes(theme.monthNameEn.toLowerCase());
      });
      const allPrefArticles = articles.filter((art) => art.data.pref === pref.id);

      return {
        params: {
          pref: pref.id,
          slug: String(theme.month),
        },
        props: {
          pageType: 'month' as const,
          pref,
          month: theme.month,
          monthTheme: theme,
          monthArticles: matchingArticles,
          allPrefArticles,
        },
      };
    });
  });

  // 3. City & Area hubs (/en/hokkaido/furano/, /en/shizuoka/atami/ etc.)
  const cityPaths = CITIES.map((city) => {
    const pref = PREFECTURES.find((p) => p.id === city.prefId) || {
      id: city.prefId,
      code: 0,
      nameJa: city.prefId,
      nameEn: city.prefId,
      region: city.region,
      regionNameJa: '',
      regionNameEn: '',
      capitalJa: '',
      capitalEn: '',
      highlightsJa: [],
      highlightsEn: [],
      descriptionJa: '',
      descriptionEn: '',
    };

    const matchingArticles = articles.filter((art) => {
      if (art.data.pref !== city.prefId) return false;
      return art.data.cities.includes(city.id) || art.data.tags.includes(city.nameEn);
    });
    const allPrefArticles = articles.filter((art) => art.data.pref === city.prefId);

    return {
      params: {
        pref: city.prefId,
        slug: city.id,
      },
      props: {
        pageType: 'city' as const,
        pref,
        city,
        cityArticles: matchingArticles,
        allPrefArticles,
      },
    };
  });

  return [...articlePaths, ...monthPaths, ...cityPaths];
}

type Props =
  | {
      pageType: 'article';
      article: CollectionEntry<'articles'>;
    }
  | {
      pageType: 'month';
      pref: Prefecture;
      month: number;
      monthTheme: MonthTheme;
      monthArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    }
  | {
      pageType: 'city';
      pref: Prefecture;
      city: City;
      cityArticles: CollectionEntry<'articles'>[];
      allPrefArticles: CollectionEntry<'articles'>[];
    };

const props = Astro.props as Props;

// Article page variables (only resolved if pageType === 'article')
let article: CollectionEntry<'articles'> | undefined;
let ContentComponent: any;
let prefName = '';
let prefSlug = '';
let prefRegion = 'kanto';
let prefArticles: CollectionEntry<'articles'>[] = [];
let articleMonth: number | undefined;

if (props.pageType === 'article') {
  article = props.article;
  const rendered = await render(article);
  ContentComponent = rendered.Content;

  const prefObj = PREFECTURES.find((p) => p.id === article.data.pref);
  prefName = prefObj ? prefObj.nameEn : article.data.pref;
  prefSlug = article.data.pref;
  prefRegion = prefObj ? prefObj.region : 'kanto';

  prefArticles = await getCollection('articles', ({ data }) => {
    return data.lang === 'en' && data.pref === prefSlug && !data.draft;
  });

  if (article.data.season) {
    const s = article.data.season.toLowerCase();
    const months = ['january', 'february', 'march', 'april', 'may', 'june', 'july', 'august', 'september', 'october', 'november', 'december'];
    for (let i = 0; i < months.length; i++) {
      if (s.includes(months[i])) {
        articleMonth = i + 1;
        break;
      }
    }
  }
}
---

{props.pageType === 'month' ? (
  <EnPrefectureMonthPage
    pref={props.pref}
    month={props.month}
    monthTheme={props.monthTheme}
    articles={props.monthArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : props.pageType === 'city' ? (
  <EnCityHubPage
    pref={props.pref}
    city={props.city}
    articles={props.cityArticles}
    allPrefArticles={props.allPrefArticles}
  />
) : article ? (
  <Layout
    title={`${article.data.title} - tavi-navi`}
    description={article.data.description}
    lang="en"
    currentPref={prefSlug}
  >
    <div class="layout-container">
      <!-- Main Content (Left Column) -->
      <article class="layout-main box google-anno-skip">
        <!-- Breadcrumb -->
        <div style="font-size: 0.85rem; color: var(--text-light); margin-bottom: 1.5rem; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border-color);">
          <a href="/en/" style="color: var(--theme-accent);">Home</a>
          <span style="margin: 0 0.4rem;">&gt;</span>
          <a href={`/en/${prefSlug}/`} style="color: var(--theme-accent);">{prefName}</a>
          <span style="margin: 0 0.4rem;">&gt;</span>
          <span>{article.data.title}</span>
        </div>

        <header style="margin-bottom: 2rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
            <a href={`/en/${prefSlug}/`} class="badge-seasonal" style="background: var(--color-primary-light); color: var(--color-primary-dark);">
              📍 {prefName}
            </a>
            <span class="badge-seasonal">{article.data.category}</span>
            {article.data.season && (
              <span class="badge-seasonal" style="background: #fef08a; color: #854d0e;">
                {article.data.season}
              </span>
            )}
          </div>

          <h1 style="font-size: 1.85rem; font-weight: 900; line-height: 1.4; color: var(--text-main); margin-bottom: 1rem;">
            {article.data.title}
          </h1>

          <div style="display: flex; align-items: center; gap: 1rem; font-size: 0.85rem; color: var(--text-light); border-bottom: 1px solid var(--border-color); padding-bottom: 1rem;">
            <span>Published: {article.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            {article.data.updatedDate && (
              <span>Updated: {article.data.updatedDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
            )}
          </div>
        </header>

        <div class="prose google-anno-skip">
          <ContentComponent />
        </div>

        <!-- Up-Next: 4-Season Timeline & Guide Tabs -->
        <div style="margin-top: 3.5rem;">
          <SeasonalTabs
            prefId={prefSlug}
            prefName={prefName}
            region={prefRegion}
            lang="en"
            articles={prefArticles}
            targetMonth={articleMonth}
          />
        </div>

        <footer style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            {article.data.tags.map((tag: string) => (
              <span style="font-size: 0.8rem; background: var(--bg-main); border: 1px solid var(--border-color); padding: 0.2rem 0.6rem; border-radius: var(--radius-full); color: var(--text-light);">
                #{tag}
              </span>
            ))}
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center;">
            <a href={`/en/${prefSlug}/`} style="font-weight: 700; font-size: 0.9rem; color: var(--theme-accent);">
              &larr; More in {prefName}
            </a>
            <a href="/en/" style="font-weight: 700; font-size: 0.9rem; color: var(--text-light);">
              Back to Japan Top
            </a>
          </div>
        </footer>
      </article>

      <!-- Sidebar (Right Column) -->
      <aside class="layout-sidebar">
        <!-- About tavi-navi -->
        <div class="sidebar-widget box" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem; box-shadow: var(--shadow);">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; color: var(--text-main);">
            <span>🧭</span>
            <span>About tavi-navi</span>
          </div>
          <p style="font-size: 0.88rem; line-height: 1.6; color: var(--text-light); margin-bottom: 1rem;">
            Bilingual travel guide for all 47 prefectures in Japan. Unbiased model courses, synchronized public transport, and seasonal event forecasts.
          </p>
          <div style="font-size: 0.82rem; background: var(--bg-main); padding: 0.6rem 0.8rem; border-radius: var(--radius); color: var(--text-main); border: 1px solid var(--border-color);">
            ✨ <strong>Official Tourism Archives</strong><br/>
            Partnered with official prefecture tourism archives including Akita Tourism Federation.
          </div>
        </div>

        <!-- Regional Cities -->
        <div class="sidebar-widget box" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.25rem; margin-bottom: 1.5rem; box-shadow: var(--shadow);">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; color: var(--text-main);">
            <span>📍</span>
            <span>Key Areas in {prefName}</span>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.88rem;">
            {CITIES.filter((c) => c.prefId === prefSlug).map((city) => (
              <li style="margin-bottom: 0.45rem;">
                <a href={`/en/${prefSlug}/${city.id}/`} style="display: flex; justify-content: space-between; align-items: center; padding: 0.45rem 0.65rem; border-radius: var(--radius); background: var(--bg-main); border: 1px solid var(--border-color); color: var(--text-main); font-weight: 700; text-decoration: none;">
                  <span>{city.nameEn}</span>
                  <span style="font-size: 0.75rem; color: var(--theme-accent);">&rarr;</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Featured Seasonal Guides -->
        <div class="sidebar-widget box" style="background: #ffffff; border: 1px solid var(--border-color); border-radius: var(--radius); padding: 1.25rem; box-shadow: var(--shadow);">
          <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 800; font-size: 1rem; margin-bottom: 0.75rem; border-bottom: 2px solid var(--border-color); padding-bottom: 0.5rem; color: var(--text-main);">
            <span>❄️</span>
            <span>Featured Model Courses</span>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0; font-size: 0.85rem;">
            <li style="margin-bottom: 0.75rem; padding-bottom: 0.75rem; border-bottom: 1px dashed var(--border-color);">
              <a href="/en/hokkaido/early-june-best-route/" style="font-weight: 700; color: var(--text-main); display: block; margin-bottom: 0.2rem; line-height: 1.4;">
                Early June in Hokkaido: Furano, Biei & Shakotan Sea Urchin
              </a>
              <span style="color: var(--text-light); font-size: 0.75rem;">Hokkaido - 3 Days</span>
            </li>
            <li>
              <a href="/en/akita/winter-kakunodate-nyuto-onsen/" style="font-weight: 700; color: var(--theme-accent); display: block; margin-bottom: 0.2rem; line-height: 1.4;">
                Winter in Akita: Samurai Town, Lake Tazawa & Nyuto Onsen
              </a>
              <span style="color: var(--text-light); font-size: 0.75rem;">Akita - 3 Days</span>
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </Layout>
) : null}
